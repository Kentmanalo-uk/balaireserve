<%# Landing page (V3 §05) — layout (header, drawer, footer) is views/layouts/landing.xian; data comes from GET / in app.js %>
<%
  // ── Data prep ──────────────────────────────────────────────
  // Landing photos are managed by admins in Settings > Landing Page.
  const DEFAULT_HERO_IMAGE = '/images/landing/beachfront-gazebo.jpg';
  const DEFAULT_HERO_ALT   = 'Thatched-roof gazebo on the lawn beside the beach at Balai-Reserve';
  const heroImage = site.landing_hero_image || DEFAULT_HERO_IMAGE;
  const heroIsDefault = !site.landing_hero_image;

  const rooms    = featuredRooms || [];
  const cottages = featuredCottages || [];
  const venues   = featuredVenues || [];
  const packages = eventPackages || [];

  // About: the admin's About photo; otherwise a real catalogue photo (never the hero again).
  let aboutImage = site.landing_about_image || '';
  let aboutAlt   = site.landing_about_alt || 'Photo of Balai-Reserve';
  let aboutCaption = '';
  if (!aboutImage && !heroIsDefault) { aboutImage = DEFAULT_HERO_IMAGE; aboutAlt = DEFAULT_HERO_ALT; }
  if (!aboutImage) {
    const pick = [...cottages, ...venues, ...rooms].find(x => x.imagesList && x.imagesList.length > 1)
              || [...cottages, ...venues, ...rooms].find(x => x.imagesList && x.imagesList.length);
    if (pick) {
      aboutImage = pick.imagesList[pick.imagesList.length > 1 ? pick.imagesList.length - 1 : 0];
      aboutAlt = pick.name + ' at Balai-Reserve';
      aboutCaption = 'The ' + pick.name;
    }
  }

  // Gallery: the admin's landing photos, else real catalogue photos (one per place first, for variety).
  const galleryFromSettings = (landingGallery || []).length > 0;
  let galleryPhotos;
  if (galleryFromSettings) {
    galleryPhotos = landingGallery.map((g, i) => ({ src: g.path, caption: g.caption || '', alt: g.caption || ('Balai-Reserve photo ' + (i + 1) + ' of ' + landingGallery.length) }));
  } else {
    const byPlace = {};
    for (const p of (catalogPhotos || [])) (byPlace[p.caption] = byPlace[p.caption] || []).push(p);
    const places = Object.keys(byPlace);
    galleryPhotos = [];
    for (let round = 0; galleryPhotos.length < 15; round++) {
      let added = false;
      for (const pl of places) { if (byPlace[pl][round]) { galleryPhotos.push(byPlace[pl][round]); added = true; } }
      if (!added) break;
    }
    galleryPhotos = galleryPhotos.map(p => ({ src: p.path, caption: p.caption, alt: p.caption + ' at Balai-Reserve' }));
  }
  const galleryJson = JSON.stringify(galleryPhotos);
  const mosaic = galleryPhotos.slice(0, 5);

  // Amenities appear only once the resort lists them (Settings > Landing Page, one per line).
  // A line ending in ":" starts a group, e.g. "Comfort:".
  const amenityGroups = [];
  for (const raw of String(site.landing_amenities || '').split(/\r?\n/)) {
    const line = raw.replace(/^\s*[-*•]\s*/, '').trim();
    if (!line) continue;
    if (/:$/.test(line)) { amenityGroups.push({ title: line.slice(0, -1).trim(), items: [] }); continue; }
    if (!amenityGroups.length) amenityGroups.push({ title: '', items: [] });
    amenityGroups[amenityGroups.length - 1].items.push(line);
  }
  const hasAmenities = amenityGroups.some(g => g.items.length);

  const dpRaw = Number.parseFloat(site.downpayment_percent);
  const dpPercent = Number.isFinite(dpRaw) && dpRaw > 0 && dpRaw <= 100 ? dpRaw : 50;

  const fmtTime = t => {
    const m = /^(\d{1,2}):(\d{2})/.exec(String(t || ''));
    if (!m) return t || '';
    const h = Number(m[1]);
    return (h % 12 || 12) + ':' + m[2] + ' ' + (h >= 12 ? 'PM' : 'AM');
  };
  const checkIn  = fmtTime(site.check_in_time || '14:00');
  const checkOut = fmtTime(site.check_out_time || '12:00');

  const minOf  = list => list.length ? Math.min(...list.map(x => Number(x.price))) : null;
  const maxCap = list => list.length ? Math.max(...list.map(x => Number(x.capacity) || 0)) : 0;
  const orList = names => names.length < 2 ? names.join('') : names.slice(0, -1).join(', ') + ' or ' + names[names.length - 1];

  const address  = site.resort_address || 'Brgy. San Antonio, Gloria, Oriental Mindoro, Philippines';
  const tagline  = site.resort_tagline || 'Your Home Away From Home';
  const mapsUrl  = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(address);

  // Occasions that have real packages, in a familiar order.
  const OCC = [['wedding', 'Weddings'], ['debut', 'Debuts'], ['birthday', 'Birthdays'], ['corporate', 'Corporate events'], ['meeting', 'Meetings']];
  const occasions = OCC.map(([k, l]) => ({ key: k, label: l, list: packages.filter(p => p.event_type === k) })).filter(o => o.list.length);
  const otherPkgs = packages.filter(p => !OCC.some(([k]) => k === p.event_type));
  if (otherPkgs.length) occasions.push({ key: 'other', label: 'Other gatherings', list: otherPkgs });
  const occOf = p => (OCC.find(([k]) => k === p.event_type) || [null, 'Gathering'])[1].replace(/s$/, '');

  const tabs = [];
  if (rooms.length)    tabs.push({ id: 'rooms', label: 'Rooms', n: rooms.length });
  if (cottages.length) tabs.push({ id: 'cottages', label: 'Cottages', n: cottages.length });
  if (venues.length)   tabs.push({ id: 'venue', label: venues.length === 1 ? 'Venue' : 'Venues', n: venues.length });
  if (packages.length) tabs.push({ id: 'packages', label: 'Packages', n: packages.length });
%>

<%# ── Hero: the beach first, then one calm search ── %>
<section class="hero<%= heroIsDefault ? ' hero--default' : '' %>" id="home" aria-labelledby="heroTitle">
  <div class="hero-media">
    <img src="<%= heroImage %>" alt="<%= heroIsDefault ? DEFAULT_HERO_ALT : 'The beachfront at Balai-Reserve' %>"
      <% if (heroIsDefault) { %>width="1382" height="2048"<% } %> fetchpriority="high" decoding="async" />
  </div>
  <%# Progressive blur: stacked layers, each blurrier and narrower, for a smooth soft-to-sharp ramp. %>
  <div class="hero-blur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-place"><i class="fas fa-location-dot" aria-hidden="true"></i> Brgy. San Antonio, Gloria, Oriental Mindoro</p>
      <h1 class="hero-title" id="heroTitle">Make room for a beach&nbsp;day.</h1>
      <p class="hero-intro"><strong><%= tagline %>.</strong> Rooms for the night, cottages by the shore and a function hall for the celebrations in between.</p>
    </div>
  </div>
</section>

<div class="dock-wrap">
  <div class="wrap">
    <form class="search" id="search" action="/portal/rooms" method="GET" role="search" aria-labelledby="searchTitle">
      <h2 class="br-sr-only" id="searchTitle">Check availability</h2>
      <fieldset class="search-kind">
        <legend>What are you booking?</legend>
        <div class="seg">
          <input type="radio" name="kind" id="kindRoom" value="room" checked /><label for="kindRoom"><i class="fas fa-bed" aria-hidden="true"></i>Stay<span>overnight</span></label>
          <input type="radio" name="kind" id="kindCottage" value="cottage" /><label for="kindCottage"><i class="fas fa-umbrella-beach" aria-hidden="true"></i>Cottage<span>day use</span></label>
          <% if (venues.length) { %><input type="radio" name="kind" id="kindVenue" value="venue" /><label for="kindVenue"><i class="fas fa-people-roof" aria-hidden="true"></i>Venue<span>your event</span></label><% } %>
          <% if (packages.length) { %><input type="radio" name="kind" id="kindEvent" value="event" /><label for="kindEvent"><i class="fas fa-champagne-glasses" aria-hidden="true"></i>Event<span>packages</span></label><% } %>
        </div>
      </fieldset>
      <div class="search-row">
        <div class="search-fields">
          <div class="field">
            <label for="heroCheckin" id="heroCheckinLabel">Check-in</label>
            <input type="date" name="checkin" id="heroCheckin" class="form-control" data-picker="date" data-range-end="heroCheckout" />
          </div>
          <div class="field" id="heroCheckoutField" data-for="room">
            <label for="heroCheckout">Check-out</label>
            <input type="date" name="checkout" id="heroCheckout" class="form-control" data-picker="date" data-range-start="heroCheckin" />
          </div>
          <div class="field" data-for="cottage venue" hidden>
            <label for="heroStart" id="heroStartLabel">Time in</label>
            <input type="time" name="start_time" id="heroStart" class="form-control" value="14:00" step="900" disabled data-picker="time" data-push="heroEnd" />
          </div>
          <div class="field" data-for="cottage venue" hidden>
            <label for="heroEnd" id="heroEndLabel">Time out</label>
            <input type="time" name="end_time" id="heroEnd" class="form-control" value="22:00" step="900" disabled data-picker="time" data-after="heroStart" />
          </div>
          <div class="field field-guests">
            <label for="heroGuests">Guests</label>
            <input type="number" name="guests" id="heroGuests" class="form-control" min="1" max="500" inputmode="numeric" placeholder="Any" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg search-submit" id="heroSearchBtn"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Check availability</button>
      </div>
      <p class="search-error" id="heroError" role="alert" hidden></p>
      <p class="search-help">Choose your dates to see what’s open, with live prices. Online bookings stay <strong>Awaiting payment</strong> until staff verify your <%= dpPercent %>% downpayment.</p>
    </form>
  </div>
</div>

<%# ── Find your spot: rooms (per night), cottages, the venue, event packages ── %>
<section class="section stay" id="stay" aria-labelledby="stayTitle">
  <span id="accommodations" class="anchor-alias" aria-hidden="true"></span>
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <h2 class="section-title" id="stayTitle">Find your spot by the sea</h2>
        <p class="section-sub">Rooms are priced per night. Cottages, the function hall and event packages are one flat price per booking.</p>
      </div>
      <a href="/portal/calendar" class="text-link">Availability calendar <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </div>

    <% if (tabs.length > 1) { %>
    <div class="cat-switch" data-tabs hidden>
      <div class="cat-tabs-row" role="tablist" aria-label="Browse by type">
        <% tabs.forEach(function (t, i) { %>
        <button type="button" class="cat-tab" role="tab" id="tab-<%= t.id %>" aria-controls="<%= t.id %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" tabindex="<%= i === 0 ? '0' : '-1' %>"><%= t.label %> <span class="cat-n"><%= t.n %></span></button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (rooms.length) { %>
    <div class="cat-panel" id="rooms" aria-labelledby="roomsTitle">
      <div class="cat-panel-head">
        <h3 class="group-title" id="roomsTitle">Rooms <span>overnight · check-in <%= checkIn %>, check-out <%= checkOut %></span></h3>
        <a href="/portal/rooms" class="text-link">Compare rooms by date <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="lst-grid lst-grid--<%= rooms.length % 3 === 1 || rooms.length === 2 ? 2 : 3 %>">
        <% for (const r of rooms) { %>
        <%include('partials/listing-card', Object.assign({}, __locals, { card: { row: r, kind: 'room', variant: 'tile', h: 'h4' } }))%>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (cottages.length) { %>
    <div class="cat-panel" id="cottages" aria-labelledby="cottagesTitle">
      <div class="cat-panel-head">
        <h3 class="group-title" id="cottagesTitle">Cottages <span>day use · one flat rate, whatever the hours</span></h3>
        <a href="/portal/cottages" class="text-link">Compare cottages by date <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="lst-grid lst-grid--<%= cottages.length % 3 === 1 || cottages.length === 2 ? 2 : 3 %>">
        <% for (const c of cottages) { %>
        <%include('partials/listing-card', Object.assign({}, __locals, { card: { row: c, kind: 'cottage', variant: 'tile', h: 'h4' } }))%>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (venues.length) { %>
    <div class="cat-panel" id="venue" aria-labelledby="hallTitle">
      <span id="hall" class="anchor-alias" aria-hidden="true"></span>
      <div class="cat-panel-head">
        <h3 class="group-title" id="hallTitle">Function hall <span>for your own event · one flat rate</span></h3>
        <% if (packages.length) { %><a href="#events" class="text-link">Or choose an event package <i class="fas fa-arrow-right" aria-hidden="true"></i></a><% } %>
      </div>
      <% for (const v of venues) { %>
      <%include('partials/listing-card', Object.assign({}, __locals, { card: { row: v, kind: 'venue', variant: 'feature', h: 'h4', dp: dpPercent } }))%>
      <% } %>
    </div>
    <% } %>

    <% if (packages.length) { %>
    <div class="cat-panel" id="packages" aria-labelledby="pkgTabTitle">
      <div class="cat-panel-head">
        <h3 class="group-title" id="pkgTabTitle">Event packages <span>one price per event · add-ons optional</span></h3>
        <a href="#events" class="text-link">Compare inclusions <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <ul class="pk-mini" role="list">
        <% for (const p of packages) { %>
        <li>
          <a href="/stay/package/<%= p.id %>" class="pk-mini-link">
            <span class="pk-mini-occ"><%= occOf(p) %></span>
            <span class="pk-mini-name"><%= p.name %></span>
            <span class="pk-mini-meta"><%= p.capacity ? 'Up to ' + p.capacity + ' guests' : '' %><%= p.capacity && p.includedItems.length ? ' · ' : '' %><%= p.includedItems.length ? p.includedItems.length + ' included' : '' %></span>
            <span class="pk-mini-price"><strong><%= formatPrice(p.price) %></strong> / event</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </li>
        <% } %>
      </ul>
    </div>
    <% } %>
  </div>
</section>

<%# ── About: a real photo and a short, factual story ── %>
<section class="section about<%= aboutImage ? ' has-photo' : '' %>" id="about" aria-labelledby="aboutTitle">
  <div class="wrap about-grid">
    <% if (aboutImage) { %>
    <figure class="about-photo">
      <img src="<%= aboutImage %>" alt="<%= aboutAlt %>" loading="lazy" decoding="async" width="1200" height="1500" />
      <% if (aboutCaption) { %><figcaption><%= aboutCaption %></figcaption><% } %>
    </figure>
    <% } %>
    <div class="about-text">
      <h2 class="section-title" id="aboutTitle">A small resort on the Gloria shoreline</h2>
      <p class="lede">
        Balai-Reserve sits right on the beach in Brgy. San Antonio, Gloria, Oriental Mindoro.
        Families and barkadas come to stay the night, to spend a day under a cottage by the sea,
        or to celebrate with everyone in one place.
      </p>
      <p>
        <% if (rooms.length) { %>Stay overnight in the <%= orList(rooms.map(r => r.name)) %>.<% } %>
        <% if (cottages.length) { %> For a day trip, book the <%= orList(cottages.map(c => c.name)) %> at one flat rate.<% } %>
        <% if (venues.length) { %> Receptions and parties are held at the <%= venues[0].name %>, which takes up to <%= venues[0].capacity %> guests.<% } %>
      </p>
      <dl class="about-facts">
        <% if (rooms.length) { %><div><dt><%= rooms.length %> <%= rooms.length === 1 ? 'room' : 'rooms' %></dt><dd>From <%= formatPrice(minOf(rooms)) %> a night · up to <%= maxCap(rooms) %> guests</dd></div><% } %>
        <% if (cottages.length) { %><div><dt><%= cottages.length %> <%= cottages.length === 1 ? 'cottage' : 'cottages' %></dt><dd>From <%= formatPrice(minOf(cottages)) %> per booking</dd></div><% } %>
        <% if (venues.length) { %><div><dt><%= venues.length === 1 ? 'Function hall' : venues.length + ' venues' %></dt><dd>Up to <%= maxCap(venues) %> guests · <%= formatPrice(minOf(venues)) %> per booking</dd></div><% } %>
        <div><dt>Check-in <%= checkIn %></dt><dd>Check-out by <%= checkOut %></dd></div>
      </dl>
    </div>
  </div>
</section>

<%# ── Gallery mosaic: one dominant photo + supporting photos, all open in the photo viewer ── %>
<% if (galleryPhotos.length > 0) { %>
<section id="gallery" class="section gallery-section" aria-labelledby="galleryTitle">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <h2 class="section-title" id="galleryTitle">Around the resort</h2>
        <% if (!galleryFromSettings) { %><p class="section-sub">Photos of our rooms and cottages. Tap any photo to see it full size.</p><% } %>
      </div>
    </div>
    <div class="gal gal--n<%= Math.min(mosaic.length, 5) %>" data-photos="<%= galleryJson %>" data-photos-name="Balai-Reserve">
      <% mosaic.forEach(function (photo, i) { %>
      <figure class="gal-item<%= i === 0 ? ' gal-main' : '' %>">
        <%# Plain link to the full image; listing.js opens it in the photo viewer instead. %>
        <a href="<%= photo.src %>" class="gal-open" data-photo-index="<%= i %>" aria-label="Open photo <%= i + 1 %> of <%= galleryPhotos.length %><%= photo.caption ? ': ' + photo.caption : '' %>">
          <img src="<%= photo.src %>" alt="<%= photo.alt %>" loading="lazy" decoding="async" width="1200" height="900" />
        </a>
        <% if (photo.caption) { %><span class="gal-shade" aria-hidden="true"><i></i><i></i><i></i></span><figcaption><%= photo.caption %></figcaption><% } %>
      </figure>
      <% }) %>
      <% if (galleryPhotos.length > 1) { %>
      <button type="button" class="btn gal-all" data-photo-index="0"><i class="fas fa-images" aria-hidden="true"></i> View all <%= galleryPhotos.length %> photos</button>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%# ── Events: lead with real occasions, then comparison rows ── %>
<% if (packages.length) { %>
<section class="section events" id="events" aria-labelledby="eventsTitle">
  <div class="wrap">
    <div class="ev-head">
      <div class="ev-head-text">
        <h2 class="ev-title" id="eventsTitle">
          <span class="br-sr-only">Celebrate weddings, debuts, birthdays and milestones by the sea</span>
          <span aria-hidden="true">Celebrate <span class="ev-rotator"><span class="ev-words"><span>weddings</span><span>debuts</span><span>birthdays</span><span>milestones</span><span>weddings</span></span></span><br>by the sea.</span>
        </h2>
        <p class="ev-lede">One price per event<% if (venues.length && venues[0].capacity) { %> at the <%= venues[0].name %>, for up to <%= venues[0].capacity %> guests<% } %>.</p>
        <a class="ev-link" href="/portal/inquire">Planning something different? Ask us<i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <%# Decorative: an open pavilion with twinkling string lights, a cake table, floating balloons, a palm and the sea. %>
      <div class="ev-art" aria-hidden="true">
        <svg viewBox="0 0 460 320" focusable="false">
          <defs><clipPath id="evArtClip"><ellipse cx="236" cy="168" rx="218" ry="150"/></clipPath></defs>
          <ellipse cx="236" cy="168" rx="218" ry="150" fill="#f3ece0"/>
          <circle class="sun" cx="356" cy="78" r="34" fill="#f6dfb0"/>
          <g clip-path="url(#evArtClip)">
            <path class="wave wave-1" d="M-72 236q36-12 72 0t72 0 72 0 72 0 72 0 72 0 72 0 72 0v84H-72z" fill="#8fcfc4" opacity=".55"/>
            <path class="wave wave-2" d="M-72 254q36-10 72 0t72 0 72 0 72 0 72 0 72 0 72 0 72 0v66H-72z" fill="#8fcfc4" opacity=".85"/>
          </g>
          <rect x="104" y="246" width="252" height="14" rx="5" fill="#e3d2b2"/>
          <g class="palm">
            <path d="M398 258c-6-48-2-92 10-128" stroke="#a9825a" stroke-width="9" stroke-linecap="round" fill="none"/>
            <path d="M408 130c-22-18-52-16-70 2 24-6 44-2 70-2z" fill="#0f5c66"/>
            <path d="M408 130c18-24 46-28 66-16-24 0-42 6-66 16z" fill="#2a7d6f"/>
            <path d="M408 130c-8-26 2-50 22-60-10 20-14 38-22 60z" fill="#2a7d6f"/>
            <path d="M408 130c10 14 12 36 4 54-2-20-6-36-4-54z" fill="#0f5c66"/>
          </g>
          <path d="M116 120 230 58l114 62z" fill="#0f5c66"/>
          <path d="M230 58l114 62h-22L230 68z" fill="#0b4850"/>
          <rect x="112" y="118" width="236" height="12" rx="4" fill="#0b4850"/>
          <rect x="128" y="130" width="11" height="118" rx="3" fill="#fff"/>
          <rect x="224" y="130" width="11" height="118" rx="3" fill="#fff"/>
          <rect x="321" y="130" width="11" height="118" rx="3" fill="#fff"/>
          <path d="M134 140q48 34 96 10 48 34 96-10" stroke="#14343a" stroke-width="1.6" fill="none"/>
          <g fill="#e8b96a">
            <g class="bulb"><circle cx="150" cy="152" r="9" opacity=".3"/><circle cx="150" cy="152" r="4.2"/></g>
            <g class="bulb"><circle cx="172" cy="160" r="9" opacity=".3"/><circle cx="172" cy="160" r="4.2"/></g>
            <g class="bulb"><circle cx="196" cy="160" r="9" opacity=".3"/><circle cx="196" cy="160" r="4.2"/></g>
            <g class="bulb"><circle cx="216" cy="153" r="9" opacity=".3"/><circle cx="216" cy="153" r="4.2"/></g>
            <g class="bulb"><circle cx="244" cy="153" r="9" opacity=".3"/><circle cx="244" cy="153" r="4.2"/></g>
            <g class="bulb"><circle cx="266" cy="160" r="9" opacity=".3"/><circle cx="266" cy="160" r="4.2"/></g>
            <g class="bulb"><circle cx="290" cy="160" r="9" opacity=".3"/><circle cx="290" cy="160" r="4.2"/></g>
            <g class="bulb"><circle cx="312" cy="152" r="9" opacity=".3"/><circle cx="312" cy="152" r="4.2"/></g>
          </g>
          <path d="M168 214h124l-7 34h-110z" fill="#fff"/>
          <path d="M168 214h124v7H168z" fill="#e7f3f0"/>
          <rect x="210" y="190" width="40" height="24" rx="4" fill="#f2c4b3"/>
          <rect x="216" y="172" width="28" height="19" rx="4" fill="#fff"/>
          <rect x="228.5" y="160" width="3" height="12" rx="1.5" fill="#e8b96a"/>
          <path class="flame" d="M230 150c4 5 4 9 0 11-4-2-4-6 0-11z" fill="#f59e0b"/>
          <path d="M186 186h14l-3 14h-8zM194 200v12M189 213h10M262 186h14l-3 14h-8zM270 200v12M265 213h10" stroke="#0f5c66" stroke-width="2" fill="#fcfbf8" stroke-linejoin="round" stroke-linecap="round"/>
          <g class="balloons">
            <path d="M62 116q8 50 70 88M90 100q10 50 42 104M76 140q20 36 56 64" stroke="#14343a" stroke-width="1.2" fill="none" opacity=".5"/>
            <ellipse cx="62" cy="94" rx="19" ry="23" fill="#e07a5f"/><ellipse cx="92" cy="78" rx="19" ry="23" fill="#8fcfc4"/><ellipse cx="78" cy="120" rx="17" ry="21" fill="#e8b96a"/>
            <path d="M54 84q4-8 10-8M84 68q4-8 10-8M71 110q4-7 9-7" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none" opacity=".7"/>
          </g>
          <g class="confetti">
            <rect x="150" y="40" width="9" height="4" rx="2" fill="#e07a5f" transform="rotate(-24 154 42)"/>
            <rect x="300" y="36" width="9" height="4" rx="2" fill="#0f5c66" transform="rotate(30 304 38)"/>
            <circle cx="196" cy="34" r="3.5" fill="#e8b96a"/><circle cx="270" cy="26" r="3" fill="#8fcfc4"/>
          </g>
        </svg>
      </div>
    </div>

    <div class="ev-row">
      <div class="ev-row-nav" data-ev-nav hidden>
        <button type="button" class="ev-nav" data-ev-step="-1" aria-controls="evCards" aria-label="Previous packages"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
        <button type="button" class="ev-nav" data-ev-step="1" aria-controls="evCards" aria-label="Next packages"><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
      </div>
      <%include('partials/event-cards', Object.assign({}, __locals, { evCards: { list: packages, h: 'h3' } }))%>
    </div>
  </div>
</section>
<% } %>

<%# ── Amenities: only what the resort has listed in Settings > Landing Page ── %>
<% if (hasAmenities) { %>
<section class="section amenities" id="amenities" aria-labelledby="amenitiesTitle">
  <div class="wrap amenities-grid">
    <div>
      <h2 class="section-title" id="amenitiesTitle">At the resort</h2>
      <p class="section-sub">What you’ll find here, as listed by the resort.</p>
    </div>
    <div class="amenity-groups">
      <% for (const g of amenityGroups) { if (!g.items.length) continue; %>
      <div class="amenity-group">
        <% if (g.title) { %><h3 class="amenity-title"><%= g.title %></h3><% } %>
        <ul class="amenity-list" role="list">
          <% for (const a of g.items) { %><li><i class="fas fa-check" aria-hidden="true"></i><span><%= a %></span></li><% } %>
        </ul>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%# ── How booking works: four stages, then proof + staff verification ── %>
<section class="section how" id="how-to-book" aria-labelledby="howTitle">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title" id="howTitle">How booking works</h2>
      <p class="section-sub">Four short steps online. You pay the downpayment outside the site, and our staff check it by hand — your booking isn’t final until they do.</p>
    </div>
    <ol class="steps" role="list">
      <li class="step">
        <span class="step-num" aria-hidden="true">1</span>
        <h3 class="step-title">Choose your place</h3>
        <p>A room, a cottage, the function hall or an event package — with the live price.</p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">2</span>
        <h3 class="step-title">Pick dates and details</h3>
        <p>Nights for a room, or a date and hours for everything else. Add guests, requests and any add-ons.</p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">3</span>
        <h3 class="step-title">Add your contact number</h3>
        <p>Sign in or create a free account and add a Philippine mobile number so staff can reach you.</p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">4</span>
        <h3 class="step-title">Get payment instructions</h3>
        <p>Choose GCash, Maya or bank transfer. You get a BK- reference and the booking shows as <strong>Awaiting payment</strong>.</p>
      </li>
    </ol>
    <div class="how-after">
      <div class="how-after-icon" aria-hidden="true"><i class="fas fa-receipt"></i></div>
      <div>
        <h3 class="step-title">Then: upload your proof and wait for staff verification</h3>
        <p>Pay the <%= dpPercent %>% downpayment, upload a screenshot on your booking page, and staff verify it against the resort’s account. You’re notified when it’s checked. The balance is paid at the resort, and you show your booking QR code on arrival.</p>
      </div>
    </div>
    <div class="how-foot">
      <a href="#search" class="btn btn-primary btn-lg" data-open-search>Check availability</a>
      <% if (site.cancellation_policy) { %>
      <div class="policy" id="cancellation-policy">
        <h3 class="policy-title">Cancellation policy</h3>
        <p><%= site.cancellation_policy %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%# ── Guest feedback: only real, public reviews rated 4+; omitted when there are none ── %>
<% if (reviews && reviews.length > 0) { %>
<section class="section reviews" id="reviews" aria-labelledby="reviewsTitle">
  <div class="wrap">
    <h2 class="section-title" id="reviewsTitle">From our guests</h2>
    <p class="section-sub">Shared by guests after their stay, with their permission.</p>
    <ul class="review-list" role="list">
      <% for (const r of reviews) { %>
      <li>
        <figure class="review">
          <p class="review-stars" aria-label="Rated <%= r.rating %> out of 5"><% for (let s = 1; s <= 5; s++) { %><i class="fa<%= s <= r.rating ? 's' : 'r' %> fa-star" aria-hidden="true"></i><% } %></p>
          <blockquote><p><%= r.comments.length > 220 ? r.comments.slice(0, 217).trim() + '…' : r.comments %></p></blockquote>
          <figcaption>
            <span class="review-avatar" aria-hidden="true"><%= String(r.customer_name || '?').trim().charAt(0).toUpperCase() %></span>
            <span><span class="review-name"><%= r.customer_name %></span>
            <span class="review-meta"><%= formatDate(r.created_at) %></span></span>
          </figcaption>
        </figure>
      </li>
      <% } %>
    </ul>
  </div>
</section>
<% } %>

<%# ── Location and contact (Settings > General); empty rows are hidden ── %>
<section class="section contact" id="contact" aria-labelledby="contactTitle">
  <% const dirUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(address); %>
  <div class="wrap gh-grid">
    <div class="gh-text">
      <h2 class="section-title" id="contactTitle">Getting here</h2>
      <address class="gh-address"><%= address %></address>
      <p class="gh-times">Check-in <strong><%= checkIn %></strong><span aria-hidden="true">·</span>Check-out <strong><%= checkOut %></strong></p>
      <a class="btn btn-primary gh-dir" href="<%= dirUrl %>" target="_blank" rel="noopener noreferrer"><i class="fas fa-diamond-turn-right" aria-hidden="true"></i>Get directions<span class="br-sr-only"> in Google Maps (opens in a new tab)</span></a>
    </div>

    <div class="gh-reach">
      <h3 class="gh-sub">Reach us</h3>
      <ul class="gh-socials" role="list">
        <li><a class="gh-social gh-fb" href="https://www.facebook.com/BalaiMiciano" target="_blank" rel="noopener noreferrer">
          <span class="gh-ico" aria-hidden="true"><i class="fab fa-facebook-f"></i></span>
          <span class="gh-s-text"><strong>Facebook</strong><span>BalaiMiciano</span></span>
          <i class="fas fa-arrow-right gh-ext" aria-hidden="true"></i><span class="br-sr-only"> (opens in a new tab)</span></a></li>
        <li><a class="gh-social gh-maps" href="<%= dirUrl %>" target="_blank" rel="noopener noreferrer">
          <span class="gh-ico" aria-hidden="true"><i class="fas fa-location-dot"></i></span>
          <span class="gh-s-text"><strong>Google Maps</strong><span>Brgy. San Antonio, Gloria</span></span>
          <i class="fas fa-arrow-right gh-ext" aria-hidden="true"></i><span class="br-sr-only"> (opens in a new tab)</span></a></li>
        <li><a class="gh-social gh-msg" href="/portal/inquire">
          <span class="gh-ico" aria-hidden="true"><i class="fas fa-comment"></i></span>
          <span class="gh-s-text"><strong>Message us</strong><span>We reply on the site</span></span>
          <i class="fas fa-arrow-right gh-ext" aria-hidden="true"></i></a></li>
        <% if (site.resort_phone) { %>
        <li><a class="gh-social gh-phone" href="tel:<%= String(site.resort_phone).replace(/[^\d+]/g, '') %>">
          <span class="gh-ico" aria-hidden="true"><i class="fas fa-phone"></i></span>
          <span class="gh-s-text"><strong>Call</strong><span><%= site.resort_phone %></span></span>
          <i class="fas fa-arrow-right gh-ext" aria-hidden="true"></i></a></li>
        <% } %>
        <% if (site.resort_email) { %>
        <li><a class="gh-social gh-mail" href="mailto:<%= site.resort_email %>">
          <span class="gh-ico" aria-hidden="true"><i class="fas fa-envelope"></i></span>
          <span class="gh-s-text"><strong>Email</strong><span><%= site.resort_email %></span></span>
          <i class="fas fa-arrow-right gh-ext" aria-hidden="true"></i></a></li>
        <% } %>
      </ul>
      <% if (site.cancellation_policy) { %><p class="gh-policies"><a href="#cancellation-policy">Cancellation policy</a><span aria-hidden="true">·</span><a href="#how-to-book">How booking works</a></p><% } %>
    </div>
  </div>
</section>

<%include('portal/_lightbox')%>
<script src="/js/photo-stack.js" defer></script>
<script src="/js/br-datepicker.js" defer></script>
<script src="/js/br-fieldpicker.js" defer></script>
