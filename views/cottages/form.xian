<% layout('layouts/main') %>
<% const hasPhotos = cottage && cottage.imagesList && cottage.imagesList.length > 0; %>
<div class="ap-page">

<!--page-head-->
<a href="/cottages" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Cottages</a>
<h1 class="ph-title"><%= cottage ? 'Edit ' + cottage.name : 'Add New Cottage' %></h1>
<% if (cottage) { %><div class="ph-actions"><a href="/stay/cottage/<%= cottage.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public cottage page in a new tab</span></a></div><% } %>
<!--/page-head-->
<p class="page-intro">Changes to the rate, description and photos show on the public website and guest portal as soon as you save.</p>

<% if (errors && errors.length > 0) { %>
<div class="alert alert-danger ap-errors" role="alert">
  <strong>Please fix the following:</strong>
  <ul><% for (const e of errors) { %><li><%= e.msg %></li><% } %></ul>
</div>
<% } %>

<!-- IMPORTANT: enctype multipart for file uploads -->
<form data-guard="this cottage" action="<%= cottage ? '/cottages/' + cottage.id + '/edit' : '/cottages' %>"
      method="POST" enctype="multipart/form-data" id="cottageForm" class="ap-form">

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Cottage</h2>
      <p>The name guests see when they book.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label required" for="cottageName">Cottage name</label>
          <input type="text" name="name" id="cottageName" class="form-control"
            value="<%= old.name || '' %>" placeholder="e.g. Umbrella Cottage" required />
        </div>
        <div class="col-md-4">
          <label class="form-label" for="cottageStatus">Status</label>
          <select name="status" id="cottageStatus" class="form-select">
            <% for (const s of ['available','reserved','occupied','maintenance','unavailable']) { %>
            <option value="<%= s %>" <%= (old.status || 'available') === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
            <% } %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Guests and rate</h2>
      <p>Cottages are a flat rate per booking: a ₱300 cottage costs ₱300 in total, however many hours the guests stay.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label required" for="cottageCapacity">Up to (guests)</label>
          <input type="number" name="capacity" id="cottageCapacity" class="form-control"
            value="<%= old.capacity || 8 %>" min="1" required />
        </div>
        <div class="col-md-6">
          <label class="form-label required" for="cottagePrice">Rate per booking</label>
          <div class="input-group">
            <span class="input-group-text">₱</span>
            <input type="number" name="price" id="cottagePrice" class="form-control"
              value="<%= old.price || '' %>" min="0" step="0.01" placeholder="0.00" required aria-describedby="cottagePriceHelp" />
          </div>
          <div class="form-text" id="cottagePriceHelp">The booking total and downpayment are worked out from this rate.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Description</h2>
      <p>Only list amenities the cottage really has — guests rely on them when choosing.</p>
    </div>
    <div class="ap-section-body">
      <div class="mb-3">
        <label class="form-label" for="cottageAmenities">Amenities</label>
        <input type="text" name="amenities" id="cottageAmenities" class="form-control"
          value="<%= old.amenitiesStr || '' %>"
          placeholder="e.g. Table, Chairs, Electric fan" aria-describedby="cottageAmenitiesHelp" />
        <div class="form-text" id="cottageAmenitiesHelp">Separate each amenity with a comma.</div>
      </div>
      <div>
        <label class="form-label" for="cottageDescription">Description</label>
        <textarea name="description" id="cottageDescription" class="form-control" rows="4"
          placeholder="Where it is and what it suits"><%= old.description || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Photos</h2>
      <p>Up to 5 photos, 5 MB each (JPG, PNG or WEBP). The first photo is the cover shown in listings.</p>
    </div>
    <div class="ap-section-body">
      <% if (hasPhotos) { %>
      <div class="cat-photo-block">
        <h3>Current photos</h3>
        <div class="ap-thumb-grid" id="existingImagesGrid">
          <% for (let i = 0; i < cottage.imagesList.length; i++) { const img = cottage.imagesList[i]; %>
          <div class="ap-thumb-item existing-img-item" data-img="<%= img %>">
            <div class="ap-thumb">
              <img src="<%= img %>" alt="Cottage photo <%= i + 1 %>" data-missing="Photo unavailable — file missing" />
              <% if (i === 0) { %><span class="cat-thumb-tag">Cover</span><% } %>
            </div>
            <!-- Hidden input preserves this image path on submit -->
            <input type="hidden" name="keep_images" value="<%= img %>" class="keep-img-input" form="cottageForm" />
            <button type="button" class="ap-act is-danger remove-img-btn" aria-pressed="false">Remove</button>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="cat-photo-block">
        <h3><%= hasPhotos ? 'Add more photos' : 'Upload photos' %></h3>
        <!-- Drop zone -->
        <div class="upload-dropzone cat-dropzone" id="dropZone">
          <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
          <span>Drag photos here, or</span>
          <label for="imageInput" class="btn btn-secondary-quiet btn-sm mb-0">Choose files</label>
          <input type="file" id="imageInput" name="images" form="cottageForm"
            multiple accept="image/*" class="d-none" />
        </div>
        <!-- New image previews -->
        <div class="ap-thumb-grid mt-3" id="newImagesPreview" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <div class="ap-form-actions">
    <span class="ap-meta ap-required-note">Fields marked <span class="text-danger">*</span> are required.</span>
    <a href="/cottages<%= cottage ? '/' + cottage.id : '' %>" class="btn btn-secondary-quiet">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= cottage ? 'Save changes' : 'Create cottage' %></button>
  </div>
</form>

</div>

<script>
(function () {
  // ── Remove / undo an existing image ───────────────────────────────────────
  // A removed photo's keep_images input is disabled so it won't be submitted.
  document.querySelectorAll('.remove-img-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      const wrapper = this.closest('.existing-img-item');
      const inp     = wrapper.querySelector('.keep-img-input');
      const removed = !wrapper.classList.contains('is-removed');
      if (inp) inp.disabled = removed;
      wrapper.classList.toggle('is-removed', removed);
      this.textContent = removed ? 'Undo' : 'Remove';
      this.classList.toggle('is-danger', !removed);
      this.setAttribute('aria-pressed', removed ? 'true' : 'false');
    });
  });

  // ── New image previews ────────────────────────────────────────────────────
  const input   = document.getElementById('imageInput');
  const preview = document.getElementById('newImagesPreview');
  const dropZone= document.getElementById('dropZone');
  let   dtFiles = new DataTransfer(); // keeps the live FileList

  function addFiles(files) {
    for (const file of files) {
      if (!file.type.startsWith('image/')) continue;
      if (dtFiles.items.length >= 5) break;
      dtFiles.items.add(file);
    }
    input.files = dtFiles.files;
    renderPreviews();
  }

  function renderPreviews() {
    preview.innerHTML = '';
    Array.from(dtFiles.files).forEach((file, idx) => {
      const item  = document.createElement('div');
      item.className = 'ap-thumb-item';
      const thumb = document.createElement('div');
      thumb.className = 'ap-thumb';
      const img = document.createElement('img');
      img.alt = file.name;
      img.src = URL.createObjectURL(file);
      thumb.appendChild(img);
      const name = document.createElement('span');
      name.className = 'ap-thumb-caption';
      name.textContent = (idx === 0 && !document.querySelector('.keep-img-input') ? 'Cover · ' : 'New · ') + file.name;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'ap-act is-danger';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => {
        const newDt = new DataTransfer();
        Array.from(dtFiles.files).forEach((f, fi) => { if (fi !== idx) newDt.items.add(f); });
        dtFiles = newDt;
        input.files = dtFiles.files;
        renderPreviews();
      });
      item.append(thumb, name, remove);
      preview.appendChild(item);
    });
  }

  input.addEventListener('change', () => { addFiles(input.files); });

  // Drag and drop
  dropZone.addEventListener('dragover',  e => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    addFiles(e.dataTransfer.files);
  });
  dropZone.addEventListener('click', e => {
    if (e.target.tagName !== 'LABEL' && e.target.tagName !== 'INPUT') input.click();
  });
})();
</script>
