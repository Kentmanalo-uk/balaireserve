<% layout('layouts/main') %>
<%
  const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
  const filtered  = !!filters.search;
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Cottages</h1>
<% if (canManage) { %>
  <div class="ph-actions">
    <a href="/cottages/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Add cottage</a>
  </div>
  <% } %>
<!--/page-head-->
<p class="page-intro">Day-use cottages with a flat rate per booking — a ₱300 cottage costs ₱300 however long the guests stay.</p>

<form method="GET" action="/cottages" class="ap-toolbar" role="search" aria-label="Filter cottages">
  <div class="ap-field ap-field-search">
    <label for="cottageSearch">Search</label>
    <div class="ap-search"><i class="fas fa-search" aria-hidden="true"></i><input type="text" id="cottageSearch" name="search" value="<%= filters.search %>" class="form-control" placeholder="Cottage name or description" /></div>
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filtered) { %><a href="/cottages" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="cottagesHeading">
  <div class="ap-panel-head">
    <h2 id="cottagesHeading">All cottages <span class="ap-meta"><%= pagination.total %> cottage<%= pagination.total === 1 ? '' : 's' %><%= filtered ? ' match' : '' %></span></h2>
  </div>
  <% if (!cottages || cottages.length === 0) { %>
  <div class="ap-empty">
    <strong><%= filtered ? 'No cottages match these filters' : 'No cottages yet' %></strong>
    <%= filtered ? 'Try a different search or clear the filters.' : 'Add the cottages guests can book for the day.' %>
    <% if (filtered) { %><div><a href="/cottages" class="btn btn-outline-secondary btn-sm">Clear filters</a></div><% } else if (canManage) { %><div><a href="/cottages/new" class="btn btn-primary btn-sm">Add cottage</a></div><% } %>
  </div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead>
        <tr>
          <th scope="col">Cottage</th>
          <th scope="col" class="cat-col-opt">Amenities</th>
          <th scope="col" class="num">Up to</th>
          <th scope="col" class="num">Rate / booking</th>
          <th scope="col">On website</th>
          <th scope="col" class="text-end"><span class="br-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const c of cottages) {
             let ams = []; try { ams = JSON.parse(c.amenities || '[]'); } catch {} %>
        <tr>
          <td class="ap-cell-title">
            <div class="cat-item">
              <div class="cat-thumb">
                <% if (c.imagesList && c.imagesList.length > 0) { %>
                <img src="<%= c.imagesList[0] %>" alt="" loading="lazy" sizes="240px" />
                <% } else { %>
                <div class="photo-pending"><span>Photos coming soon</span></div>
                <% } %>
              </div>
              <div class="cat-item-text">
                <a href="/cottages/<%= c.id %>" class="ap-name"><%= c.name %></a>
                <% if (c.description) { %><span class="ap-line2 cat-desc"><%= c.description.slice(0, 80) %><%= c.description.length > 80 ? '…' : '' %></span><% } %>
              </div>
            </div>
          </td>
          <td class="ap-wide cat-col-opt" data-label="Amenities"><%= ams.length ? ams.slice(0, 3).join(', ') + (ams.length > 3 ? ' +' + (ams.length - 3) + ' more' : '') : '—' %></td>
          <td class="num" data-label="Up to"><%= c.capacity %> guests</td>
          <td class="num" data-label="Rate / booking"><strong><%= formatPeso(c.price) %></strong></td>
          <td data-label="On website"><%include('partials/listing-controls', Object.assign({}, __locals, { lc: { row: c, base: '/cottages', part: 'state', canManage } }))%></td>
          <td class="ap-row-actions">
            <div class="ap-actions">
              <a href="/cottages/<%= c.id %>" class="ap-act">View</a>
              <% if (canManage) { %><a href="/cottages/<%= c.id %>/edit" class="ap-act">Edit</a><% } %>
              <%include('partials/listing-controls', Object.assign({}, __locals, { lc: { row: c, base: '/cottages', part: 'actions', canManage } }))%>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
  <% } %>
</section>

</div>
<script>
// A thumbnail whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-thumb > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'photo-pending';
    box.textContent = 'Photo unavailable';
    img.replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
