<% layout('layouts/main') %>
<% const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff'); %>
<div class="ap-page cat-show">

<!--page-head-->
<a href="/cottages" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Cottages</a>
<h1 class="ph-title"><%= cottage.name %></h1>
<div class="ph-actions">
    <a href="/stay/cottage/<%= cottage.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public cottage page in a new tab</span></a>
    <% if (canManage) { %>
    <a href="/cottages/<%= cottage.id %>/edit" class="btn btn-secondary-quiet"><i class="fas fa-pen" aria-hidden="true"></i>Edit cottage</a>
    <% } %>
    <a href="/reservations/new?type=cottage" class="btn btn-primary"><i class="fas fa-calendar-plus" aria-hidden="true"></i>New reservation</a>
  </div>
<!--/page-head-->
<div class="page-meta">Cottage · up to <%= cottage.capacity %> guests · <%- statusBadge(cottage.status) %></div>

<div class="ap-split">
  <div class="cat-main">
    <%# Photos: one large image, the rest as smaller tiles; click to view uncropped %>
    <div class="cat-gallery<%= cottage.imagesList && cottage.imagesList.length === 1 ? ' is-single' : '' %>">
      <% if (cottage.imagesList && cottage.imagesList.length > 0) { %>
        <% for (let i = 0; i < cottage.imagesList.length; i++) { %>
        <button type="button" class="cat-photo" data-lightbox="<%= cottage.imagesList[i] %>" data-lightbox-title="<%= cottage.name %> — photo <%= i + 1 %>" aria-label="View photo <%= i + 1 %> of <%= cottage.imagesList.length %> full size">
          <img src="<%= cottage.imagesList[i] %>" alt="<%= cottage.name %> photo <%= i + 1 %>" <%- i > 0 ? 'loading="lazy"' : '' %> />
        </button>
        <% } %>
      <% } else { %>
        <div class="photo-pending"><i class="fas fa-image" aria-hidden="true"></i><span>Photos coming soon</span></div>
      <% } %>
    </div>

    <% if (activeRes) { %>
    <section class="ap-panel cat-upcoming" aria-labelledby="cottageUpcomingHeading">
      <div class="ap-panel-head">
        <h2 id="cottageUpcomingHeading">Next booking</h2>
        <a href="/reservations/<%= activeRes.id %>" class="ap-act">Open booking</a>
      </div>
      <div class="ap-panel-body">
        <dl class="ap-dl">
          <dt>Guest</dt><dd><strong><%= activeRes.customer_name %></strong></dd>
          <dt>Booking</dt><dd><span class="ap-code"><%= activeRes.booking_ref %></span></dd>
          <dt>Dates</dt><dd><%= formatDate(activeRes.check_in_date) %> → <%= formatDate(activeRes.check_out_date) %></dd>
          <dt>Status</dt><dd><%- statusBadge(activeRes.status) %></dd>
        </dl>
      </div>
    </section>
    <% } %>

    <section class="ap-panel" aria-labelledby="cottageHistoryHeading">
      <div class="ap-panel-head"><h2 id="cottageHistoryHeading">Reservation history <span class="ap-meta">latest 10</span></h2></div>
      <% if (!reservations || reservations.length === 0) { %>
      <div class="ap-empty"><strong>No reservations yet</strong>Bookings that include this cottage will appear here.</div>
      <% } else { %>
      <div class="ap-table-wrap">
        <table class="table-br ap-table ap-stack">
          <thead><tr><th scope="col">Booking</th><th scope="col">Check-in</th><th scope="col">Check-out</th><th scope="col" class="num">Amount</th><th scope="col">Status</th></tr></thead>
          <tbody>
            <% for (const r of reservations) { %>
            <tr>
              <td class="ap-cell-title"><a href="/reservations/<%= r.id %>" class="ap-name"><%= r.customer_name %></a><span class="ap-line2 ap-code"><%= r.booking_ref %></span></td>
              <td data-label="Check-in" class="text-nowrap"><%= formatDate(r.check_in_date) %></td>
              <td data-label="Check-out" class="text-nowrap"><%= formatDate(r.check_out_date) %></td>
              <td class="num" data-label="Amount"><%= formatPeso(r.total_amount) %></td>
              <td class="ap-cell-status"><%- statusBadge(r.status) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </div>

  <aside class="cat-aside">
    <section class="ap-panel" aria-labelledby="cottageDetailsHeading">
      <div class="ap-panel-head"><h2 id="cottageDetailsHeading">Cottage details</h2></div>
      <div class="ap-panel-body">
        <p class="cat-price mb-1"><%= formatPeso(cottage.price) %> <small>/ booking</small></p>
        <p class="ap-meta mb-3">Flat rate — the total does not change with the number of hours.</p>
        <dl class="ap-dl">
          <dt>Capacity</dt><dd>Up to <%= cottage.capacity %> guests</dd>
          <dt>Status</dt><dd><%- statusBadge(cottage.status) %></dd>
        </dl>
        <% if (cottage.description) { %>
        <h3 class="cat-subhead">Description</h3>
        <p class="cat-desc-text"><%= cottage.description %></p>
        <% } %>
        <% if (cottage.amenitiesList && cottage.amenitiesList.length > 0) { %>
        <h3 class="cat-subhead">Amenities</h3>
        <ul class="cat-amenities">
          <% for (const a of cottage.amenitiesList) { %><li><%= a %></li><% } %>
        </ul>
        <% } %>
      </div>
      <% if (canManage) { %>
      <div class="ap-panel-foot">
        <form action="/cottages/<%= cottage.id %>/status" method="POST" class="cat-status-form">
          <div class="ap-field">
            <label for="cottageStatusSelect">Change status</label>
            <select name="status" id="cottageStatusSelect" class="form-select">
              <% for (const s of ['available','reserved','occupied','maintenance','unavailable']) { %>
              <option value="<%= s %>" <%= cottage.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
              <% } %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Update</button>
        </form>
      </div>
      <% } %>
    </section>
  </aside>
</div>

</div>
<script>
// A photo whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-photo > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'cat-photo photo-pending';
    box.textContent = 'Photo unavailable';
    img.closest('.cat-photo').replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
