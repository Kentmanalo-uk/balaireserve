<% layout('layouts/main') %>
<%
  const isStaffUser = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
  const homeHref  = isStaffUser ? '/dashboard' : (currentUser ? '/portal' : '/');
  const homeLabel = isStaffUser ? 'Back to dashboard' : (currentUser ? 'Back to my bookings' : 'Back to the resort site');
%>
<section class="error-page" aria-labelledby="errTitle">
  <div class="error-code">Error 403</div>
  <h1 id="errTitle">You don't have access to this page</h1>
  <p><%= message || 'You do not have permission to access this page.' %> If you think you should, ask an administrator to check your account role.</p>
  <div class="error-actions">
    <a href="<%= homeHref %>" class="btn btn-primary"><%= homeLabel %></a>
    <button type="button" onclick="history.back()" class="btn btn-outline-secondary">Go back</button>
  </div>
</section>
