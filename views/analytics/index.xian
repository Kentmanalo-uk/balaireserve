<% layout('layouts/main') %>
<div class="ap-page an-page">

<!--page-head-->
<h1 class="ph-title">Analytics</h1>
<div class="ph-actions">
    <a href="/reports" class="btn btn-outline-secondary">Open reports</a>
  </div>
<!--/page-head-->
<p class="page-intro">Trends calculated from recorded payments, bookings and guest feedback. Figures are simple counts and averages — use them alongside the Reports for decisions.</p>

<div class="ap-kpis" role="group" aria-label="Key figures">
  <div class="ap-kpi">
    <span class="ap-kpi-label">Rooms occupied now</span>
    <span class="ap-kpi-value"><%= occupancyRate %>%</span>
    <span class="ap-kpi-note">of active rooms marked Occupied</span>
  </div>
  <div class="ap-kpi <%= cancellationRate > 20 ? 'is-bad' : '' %>">
    <span class="ap-kpi-label">Cancellation rate</span>
    <span class="ap-kpi-value"><%= cancellationRate %>%</span>
    <span class="ap-kpi-note">bookings made in the last 3 months</span>
  </div>
  <div class="ap-kpi <%= revChange === null ? '' : (revChange >= 0 ? 'is-good' : 'is-bad') %>">
    <span class="ap-kpi-label">Received this month</span>
    <span class="ap-kpi-value"><%= formatPeso(thisMonthRev) %></span>
    <span class="ap-kpi-note"><%= revChange === null ? 'No payments last month to compare' : (revChange >= 0 ? '+' : '') + revChange + '% vs all of last month (' + formatPeso(lastMonthRev) + ')' %></span>
  </div>
  <div class="ap-kpi">
    <span class="ap-kpi-label">Bookings per month</span>
    <span class="ap-kpi-value"><%= projectedRes %></span>
    <span class="ap-kpi-note">average of the last 3 months</span>
  </div>
</div>

<div class="an-grid">
  <section class="ap-panel is-wide" aria-labelledby="anRevHeading">
    <div class="ap-panel-head"><h2 id="anRevHeading">Payments received, last 12 months</h2><span class="ap-meta">Recorded and verified payments, by month</span></div>
    <div class="ap-panel-body">
      <div class="rpt-chart-box"><canvas id="revTrend" role="img" aria-label="Line chart of payments received per month over the last 12 months"></canvas></div>
      <p class="ap-empty d-none" data-empty-for="revTrend"><strong>No payments in the last 12 months</strong></p>
    </div>
  </section>

  <section class="ap-panel" aria-labelledby="anEventHeading">
    <div class="ap-panel-head"><h2 id="anEventHeading">Event types, last 6 months</h2></div>
    <div class="ap-panel-body">
      <div class="rpt-chart-box"><canvas id="eventDemandChart" role="img" aria-label="Bar chart of events by type over the last 6 months"></canvas></div>
      <p class="ap-empty d-none" data-empty-for="eventDemandChart"><strong>No events in the last 6 months</strong></p>
    </div>
  </section>

  <section class="ap-panel" aria-labelledby="anVenueHeading">
    <div class="ap-panel-head"><h2 id="anVenueHeading">Venue bookings</h2><span class="ap-meta">All time</span></div>
    <div class="ap-panel-body">
      <div class="rpt-chart-box"><canvas id="venueChart" role="img" aria-label="Bar chart of bookings per venue"></canvas></div>
      <p class="ap-empty d-none" data-empty-for="venueChart"><strong>No venue bookings yet</strong></p>
    </div>
  </section>

  <section class="ap-panel" aria-labelledby="anSatHeading">
    <div class="ap-panel-head"><h2 id="anSatHeading">Average guest rating, last 6 months</h2><span class="ap-meta">Out of 5</span></div>
    <div class="ap-panel-body">
      <div class="rpt-chart-box"><canvas id="satChart" role="img" aria-label="Line chart of average guest feedback rating per month"></canvas></div>
      <p class="ap-empty d-none" data-empty-for="satChart"><strong>No feedback in the last 6 months</strong></p>
    </div>
  </section>

  <section class="ap-panel" aria-labelledby="anPeakHeading">
    <div class="ap-panel-head"><h2 id="anPeakHeading">Bookings by weekday made</h2><span class="ap-meta">All time</span></div>
    <div class="ap-panel-body">
      <div class="rpt-chart-box"><canvas id="peakChart" role="img" aria-label="Bar chart of how many bookings were made on each day of the week"></canvas></div>
      <p class="ap-empty d-none" data-empty-for="peakChart"><strong>No bookings yet</strong></p>
    </div>
  </section>

  <% if (insights && insights.length) { %>
  <section class="ap-panel is-wide" aria-labelledby="anNotesHeading">
    <div class="ap-panel-head"><h2 id="anNotesHeading">Saved notes <span class="ap-meta"><%= insights.length %></span></h2><span class="ap-meta">Suggestions only — check them against the figures before acting</span></div>
    <ul class="an-notes">
      <% for (const ins of insights) { %>
      <li>
        <div>
          <span class="an-note-kind text-capitalize"><%= ins.insight_type %><%= ins.confidence ? ' · ' + ins.confidence + ' confidence' : '' %></span>
          <p class="an-note-title"><%= ins.title %></p>
          <p class="an-note-msg"><%= ins.message %></p>
        </div>
        <form action="/analytics/dismiss/<%= ins.id %>" method="POST"><button type="submit" class="ap-act" aria-label="Dismiss note: <%= ins.title %>">Dismiss</button></form>
      </li>
      <% } %>
    </ul>
  </section>
  <% } %>
</div>

</div>
<script>
(function(){
  const revTrend    = <%- revenueTrend || '[]' %>;
  const resTrend    = <%- resTrend || '[]' %>;
  const venueUtil   = <%- venueUtil || '[]' %>;
  const eventDemand = <%- eventDemand || '[]' %>;
  const satData     = <%- satisfactionJson || '[]' %>;
  const peakDays    = <%- peakDaysJson || '[]' %>;
  if (typeof Chart === 'undefined') return;

  // Brand tokens (tokens.css): deep sea for data, hairline grid, Inter labels, sand used once for ratings
  const SEA = '#0f5c66', SEA_TINT = 'rgba(15,92,102,0.10)', SAND = '#e8b96a', SAND_INK = '#8a5a12', GRID = '#e5e9e7';
  Chart.defaults.font.family = "Inter, 'Segoe UI', system-ui, sans-serif";
  Chart.defaults.font.size = 12;
  Chart.defaults.color = '#627174';
  Chart.defaults.maintainAspectRatio = false;
  Chart.defaults.plugins.legend.display = false;
  Chart.defaults.plugins.tooltip.backgroundColor = '#0f2a30';
  Chart.defaults.plugins.tooltip.padding = 10;
  const peso = v => '₱' + Number(v).toLocaleString('en-PH');
  // Single-series charts: the panel heading names the series; axes carry titles.
  const ttl = (text) => ({ display: true, text: text, color: '#627174', font: { weight: '600' } });
  const axes = (y, xTitle, yTitle) => ({ x: { grid: { display: false }, title: ttl(xTitle || '') }, y: Object.assign({ beginAtZero: true, grid: { color: GRID }, border: { display: false }, title: ttl(yTitle || '') }, y || {}) });
  const bar = { backgroundColor: SEA, borderRadius: 4, maxBarThickness: 40 };
  function draw(id, rows, config) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!rows.length) { el.parentElement.hidden = true; const e = document.querySelector('[data-empty-for="' + id + '"]'); if (e) e.classList.remove('d-none'); return; }
    new Chart(el, config);
  }

  // Revenue Trend
  draw('revTrend', revTrend, { type: 'line', data: { labels: revTrend.map(d => d.month), datasets: [{ label: 'Received', data: revTrend.map(d => d.revenue), borderColor: SEA, backgroundColor: SEA_TINT, fill: true, tension: 0.3, pointRadius: 3, pointBackgroundColor: SEA }] },
    options: { plugins: { tooltip: { callbacks: { label: c => peso(c.parsed.y) } } }, scales: axes({ ticks: { callback: peso } }, 'Month', 'Payments received (₱)') } });

  // Event Demand
  draw('eventDemandChart', eventDemand, { type: 'bar', data: { labels: eventDemand.map(d => d.event_type), datasets: [Object.assign({ label: 'Events', data: eventDemand.map(d => d.cnt) }, bar)] },
    options: { indexAxis: 'y', scales: { x: { beginAtZero: true, grid: { color: GRID }, border: { display: false }, ticks: { stepSize: 1 }, title: ttl('Events') }, y: { grid: { display: false }, title: ttl('Event type') } } } });

  // Venue Utilization
  draw('venueChart', venueUtil, { type: 'bar', data: { labels: venueUtil.map(d => d.name), datasets: [Object.assign({ label: 'Bookings', data: venueUtil.map(d => d.bookings) }, bar)] },
    options: { scales: axes({ ticks: { stepSize: 1 } }, 'Venue', 'Bookings') } });

  // Satisfaction
  draw('satChart', satData, { type: 'line', data: { labels: satData.map(d => d.month), datasets: [{ label: 'Average rating', data: satData.map(d => d.avg_rating), borderColor: SAND_INK, backgroundColor: SAND, pointBackgroundColor: SAND, pointBorderColor: SAND_INK, pointRadius: 4, tension: 0.3 }] },
    options: { plugins: { tooltip: { callbacks: { label: c => c.parsed.y + ' / 5' } } }, scales: axes({ min: 0, max: 5, beginAtZero: true, ticks: { stepSize: 1 } }, 'Month', 'Average rating (1–5)') } });

  // Peak Days
  draw('peakChart', peakDays, { type: 'bar', data: { labels: peakDays.map(d => d.day), datasets: [Object.assign({ label: 'Bookings', data: peakDays.map(d => d.cnt) }, bar)] },
    options: { scales: axes({ ticks: { stepSize: 1 } }, 'Day of the week the booking was made', 'Bookings') } });
})();
</script>
