<% layout('layouts/main') %>
<%
  const cap = (s) => { const t = String(s || '').replace(/_/g, ' '); return t.charAt(0).toUpperCase() + t.slice(1); };
  const isOpen = inquiry.status !== 'resolved' && inquiry.status !== 'closed';
  const canAct = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
%>
<div class="ap-page">

<!--page-head-->
<a href="/inquiries" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Inquiries</a>
<h1 class="ph-title"><%= inquiry.subject %></h1>
<div class="ph-actions"><%- statusBadge(inquiry.status) %></div>
<!--/page-head-->
<div class="page-meta">Inquiry #<%= inquiry.id %> · <%= cap(inquiry.category) %> · received <%= formatDateTime(inquiry.created_at) %> via <%= cap(inquiry.source) %></div>

<div class="ap-split">
  <div>
    <section class="ap-panel" aria-labelledby="inqThreadHeading">
      <div class="ap-panel-head"><h2 id="inqThreadHeading">Conversation</h2></div>
      <ol class="ap-history inq-thread">
        <li class="inq-msg-guest">
          <time datetime="<%= formatDateTime(inquiry.created_at, 'YYYY-MM-DDTHH:mm') %>"><%= formatDateTime(inquiry.created_at) %></time>
          <div class="inq-bubble">
            <div class="ap-history-title"><span class="inq-avatar" aria-hidden="true"><%= String(inquiry.name || 'G').charAt(0).toUpperCase() %></span><%= inquiry.name || 'Guest' %> <span class="ap-history-by">wrote</span></div>
            <p class="ap-history-body inq-message"><%= inquiry.message %></p>
          </div>
        </li>
        <% if (ticket) { %>
        <li>
          <time datetime="<%= formatDateTime(ticket.created_at, 'YYYY-MM-DDTHH:mm') %>"><%= formatDateTime(ticket.created_at) %></time>
          <div>
            <div class="ap-history-title">Escalated to support ticket <span class="ap-code"><%= ticket.ticket_number %></span> <%- statusBadge(ticket.status) %></div>
            <p class="ap-history-body ap-meta">Tracked under <a href="/crm/tickets?search=<%= encodeURIComponent(ticket.ticket_number) %>">Support tickets</a>.</p>
          </div>
        </li>
        <% } %>
        <% if (inquiry.resolution) { %>
        <li class="inq-reply">
          <time datetime="<%= formatDateTime(inquiry.resolved_at || inquiry.updated_at, 'YYYY-MM-DDTHH:mm') %>"><%= formatDateTime(inquiry.resolved_at || inquiry.updated_at) %></time>
          <div class="inq-bubble">
            <div class="ap-history-title"><%= inquiry.assigned_name || 'Staff' %> <span class="ap-history-by">replied and resolved</span></div>
            <p class="ap-history-body inq-message"><%= inquiry.resolution %></p>
          </div>
        </li>
        <% } else if (isOpen) { %>
        <li class="inq-waiting">
          <span class="ap-meta">Now</span>
          <div class="ap-meta">Waiting for a reply.</div>
        </li>
        <% } %>
      </ol>
    </section>

    <% if (isOpen && canAct) { %>
    <section class="ap-panel" aria-labelledby="inqReplyHeading" id="reply">
      <div class="ap-panel-head"><h2 id="inqReplyHeading">Reply and resolve</h2></div>
      <div class="ap-panel-body">
        <form action="/inquiries/<%= inquiry.id %>/resolve" method="POST">
          <label class="form-label required" for="inqResolution">Reply to <%= inquiry.name || 'the guest' %></label>
          <textarea name="resolution" id="inqResolution" class="form-control" rows="5" placeholder="Answer the question or explain what was done." required aria-describedby="inqResolutionHelp"></textarea>
          <div class="form-text" id="inqResolutionHelp">The guest reads this reply under My Inquiries in the portal and gets a notification if they have an account. You’ll be recorded as the person who handled it.</div>
          <div class="inq-reply-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane" aria-hidden="true"></i>Send reply and resolve</button>
          </div>
        </form>
      </div>
    </section>
    <% } %>
  </div>

  <aside>
    <section class="ap-panel" aria-labelledby="inqInfoHeading">
      <div class="ap-panel-head"><h2 id="inqInfoHeading">Details</h2></div>
      <div class="ap-panel-body">
        <dl class="ap-dl">
          <dt>Status</dt><dd><%- statusBadge(inquiry.status) %></dd>
          <dt>From</dt><dd><%= inquiry.name || '—' %><% if (inquiry.customer_id && inquiry.customer_full_name) { %><span class="d-block"><a href="/crm/customers/<%= inquiry.customer_id %>">Customer profile</a></span><% } %></dd>
          <dt>Email</dt><dd><% if (inquiry.email) { %><a href="mailto:<%= inquiry.email %>"><%= inquiry.email %></a><% } else { %>—<% } %></dd>
          <dt>Phone</dt><dd><% if (inquiry.phone) { %><a href="tel:<%= inquiry.phone %>"><%= inquiry.phone %></a><% } else { %>—<% } %></dd>
          <dt>Category</dt><dd><%= cap(inquiry.category) %></dd>
          <dt>Source</dt><dd><%= cap(inquiry.source) %></dd>
          <dt>Received</dt><dd><%= formatDateTime(inquiry.created_at) %></dd>
          <dt>Handled by</dt><dd><%= inquiry.assigned_name || 'Not yet assigned' %></dd>
          <% if (inquiry.resolved_at) { %><dt>Resolved</dt><dd><%= formatDateTime(inquiry.resolved_at) %></dd><% } %>
        </dl>
      </div>
    </section>

    <% if (isOpen && canAct && staffList && staffList.length) { %>
    <section class="ap-panel" aria-labelledby="inqAssignHeading">
      <div class="ap-panel-head"><h2 id="inqAssignHeading">Assignment</h2></div>
      <div class="ap-panel-body">
        <form action="/inquiries/<%= inquiry.id %>/assign" method="POST" class="inq-assign">
          <label class="form-label" for="inqAssignee">Who handles this?</label>
          <div class="inq-assign-row">
            <select name="assigned_to" id="inqAssignee" class="form-select">
              <option value="">Unassigned</option>
              <% for (const u of staffList) { %><option value="<%= u.id %>" <%= String(inquiry.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.name %><%= currentUser && currentUser.id === u.id ? ' (you)' : '' %></option><% } %>
            </select>
            <button type="submit" class="btn btn-secondary-quiet">Assign</button>
          </div>
          <p class="form-text mb-0">Assigning marks the inquiry In progress so others know it is being handled.</p>
        </form>
      </div>
    </section>
    <% } %>

    <% if (isOpen && canAct && !ticket) { %>
    <section class="ap-panel" aria-labelledby="inqEscHeading">
      <div class="ap-panel-head"><h2 id="inqEscHeading">Needs more follow-up?</h2></div>
      <div class="ap-panel-body">
        <p class="ap-meta mb-3">Escalating creates a support ticket assigned to you and marks this inquiry Escalated. You can still reply here afterwards.</p>
        <form action="/inquiries/<%= inquiry.id %>/escalate" method="POST">
          <button type="submit" class="btn btn-secondary-quiet w-100"
            data-confirm="Create a support ticket for this inquiry and mark it Escalated?"
            data-confirm-title="Escalate to Support Ticket"
            data-confirm-ok="Escalate"><i class="fas fa-arrow-up" aria-hidden="true"></i>Escalate to support ticket</button>
        </form>
      </div>
    </section>
    <% } %>
  </aside>
</div>

</div>
