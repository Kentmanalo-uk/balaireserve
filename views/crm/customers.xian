<% layout('layouts/main') %>
<%
  const TYPE_LABELS = { regular: 'Regular', vip: 'VIP', corporate: 'Corporate' };
  const cap = (s) => { const t = String(s || '').replace(/_/g, ' '); return t.charAt(0).toUpperCase() + t.slice(1); };
  const filtered = !!(filters.search || filters.type || filters.status);
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Customers</h1>
<div class="ph-actions">
    <a href="/crm/customers/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Add customer</a>
  </div>
<!--/page-head-->

<form method="GET" action="/crm" class="ap-toolbar" role="search" aria-label="Find a customer">
  <div class="ap-field ap-field-search">
    <label for="crmSearch">Find a customer</label>
    <div class="ap-search"><i class="fas fa-search" aria-hidden="true"></i><input type="text" id="crmSearch" name="search" value="<%= filters.search %>" class="form-control" placeholder="Name, email, phone or customer code" autocomplete="off" /></div>
  </div>
  <div class="ap-field">
    <label for="crmType">Type</label>
    <select id="crmType" name="type" class="form-select"><option value="">All types</option><% for (const t of types) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= TYPE_LABELS[t] || cap(t) %></option><% } %></select>
  </div>
  <div class="ap-field">
    <label for="crmStatus">Status</label>
    <select id="crmStatus" name="status" class="form-select"><option value="">All statuses</option><% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= cap(s) %></option><% } %></select>
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (filtered) { %><a href="/crm" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="crmListHeading">
  <div class="ap-panel-head">
    <h2 id="crmListHeading"><%= filtered ? 'Matching customers' : 'All customers' %> <span class="ap-meta"><%= pagination.total %></span></h2>
    <span class="ap-meta">A–Z by first name</span>
  </div>
  <% if (!customers || customers.length === 0) { %>
  <div class="ap-empty">
    <strong><%= filtered ? 'No customers match' : 'No customers yet' %></strong>
    <%= filtered ? 'Check the spelling, or search by phone number or customer code.' : 'Customers are added automatically when guests register or book at the desk.' %>
    <div><% if (filtered) { %><a href="/crm" class="btn btn-outline-secondary btn-sm">Clear search</a> <% } %><a href="/crm/customers/new" class="btn btn-primary btn-sm">Add customer</a></div>
  </div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead>
        <tr><th scope="col">Customer</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Type</th><th scope="col" class="num">Bookings</th><th scope="col">Last booking</th><th scope="col">Status</th><th scope="col" class="text-end"><span class="br-sr-only">Actions</span></th></tr>
      </thead>
      <tbody>
        <% for (const c of customers) { %>
        <tr>
          <td class="ap-cell-title"><a href="/crm/customers/<%= c.id %>" class="ap-name"><%= c.first_name %> <%= c.last_name %></a><span class="ap-line2 ap-code"><%= c.customer_code %></span></td>
          <td data-label="Email" class="ap-wide crm-email"><%= c.email || '—' %></td>
          <td data-label="Phone" class="text-nowrap crm-phone"><%= c.phone || '—' %></td>
          <td data-label="Type"><span class="<%= c.customer_type === 'vip' ? 'crm-type-vip' : '' %>"><%= TYPE_LABELS[c.customer_type] || cap(c.customer_type) %></span></td>
          <td class="num" data-label="Bookings"><%= c.total_bookings %></td>
          <td data-label="Last booking" class="text-nowrap"><%= c.last_booking ? formatDate(c.last_booking) : '—' %></td>
          <td class="ap-cell-status"><%- statusBadge(c.status) %></td>
          <td class="ap-row-actions"><div class="ap-actions"><a href="/crm/customers/<%= c.id %>" class="ap-act">Profile<span class="br-sr-only"> of <%= c.first_name %> <%= c.last_name %></span></a></div></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
  <% if (pagination && pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
</section>

</div>
