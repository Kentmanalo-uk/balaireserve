<% layout('layouts/main') %>
<%
  const cap = (s) => { const t = String(s || '').replace(/_/g, ' '); return t.charAt(0).toUpperCase() + t.slice(1); };
  const total    = Number(summary.total) || 0;
  const positive = (Number(summary.five_star) || 0) + (Number(summary.four_star) || 0);
  const negative = (Number(summary.two_star) || 0) + (Number(summary.one_star) || 0);
  const pct      = (n) => total > 0 ? Math.round((n / total) * 100) : 0;
  const filtered = !!(filters.rating || filters.category);
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Guest feedback</h1>
<!--/page-head-->
<p class="page-intro">Ratings guests leave after a stay or event. Reviews rated 4–5 that are visible can appear on the public website; hide any that shouldn’t.</p>

<div class="fb-overview">
  <div class="ap-kpis" aria-label="Feedback summary">
    <div class="ap-kpi"><span class="ap-kpi-label">Average rating</span><span class="ap-kpi-value"><%= summary.avg_rating || '—' %><% if (summary.avg_rating) { %><span class="fb-outof"> / 5</span><% } %></span><span class="ap-kpi-note"><%= total %> review<%= total === 1 ? '' : 's' %></span></div>
    <div class="ap-kpi is-good"><span class="ap-kpi-label">Positive (4–5★)</span><span class="ap-kpi-value"><%= positive %></span><span class="ap-kpi-note"><%= pct(positive) %>% of reviews</span></div>
    <div class="ap-kpi"><span class="ap-kpi-label">Neutral (3★)</span><span class="ap-kpi-value"><%= Number(summary.three_star) || 0 %></span><span class="ap-kpi-note"><%= pct(Number(summary.three_star) || 0) %>% of reviews</span></div>
    <div class="ap-kpi <%= negative > 0 ? 'is-bad' : '' %>"><span class="ap-kpi-label">Negative (1–2★)</span><span class="ap-kpi-value"><%= negative %></span><span class="ap-kpi-note"><%= negative > 0 ? 'Worth a response' : 'None' %></span></div>
  </div>

  <% if (total > 0) { %>
  <section class="ap-panel fb-dist" aria-labelledby="fbDistHeading">
    <div class="ap-panel-head"><h2 id="fbDistHeading">Rating breakdown</h2></div>
    <div class="ap-panel-body">
      <% for (const [s, cnt] of [[5, summary.five_star], [4, summary.four_star], [3, summary.three_star], [2, summary.two_star], [1, summary.one_star]]) { const n = Number(cnt) || 0; %>
      <a class="fb-dist-row" href="/feedback?rating=<%= s %>" aria-label="<%= s %> stars: <%= n %> reviews">
        <span class="fb-dist-label"><%= s %>★</span>
        <span class="fb-dist-track"><span class="fb-dist-bar fb-dist-<%= s >= 4 ? 'good' : (s === 3 ? 'mid' : 'bad') %>" style="width:<%= pct(n) %>%"></span></span>
        <span class="fb-dist-count"><%= n %></span>
      </a>
      <% } %>
    </div>
  </section>
  <% } %>
</div>

<form method="GET" action="/feedback" class="ap-toolbar" aria-label="Filter feedback">
  <div class="ap-field">
    <label for="fbRating">Rating</label>
    <select id="fbRating" name="rating" class="form-select">
      <option value="">All ratings</option>
      <% for (let s = 5; s >= 1; s--) { %><option value="<%= s %>" <%= parseInt(filters.rating) === s ? 'selected' : '' %>><%= s %> star<%= s !== 1 ? 's' : '' %></option><% } %>
    </select>
  </div>
  <div class="ap-field">
    <label for="fbCategory">Category</label>
    <select id="fbCategory" name="category" class="form-select">
      <option value="">All categories</option>
      <% for (const c of categories) { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= cap(c) %></option><% } %>
    </select>
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filtered) { %><a href="/feedback" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="fbListHeading">
  <div class="ap-panel-head"><h2 id="fbListHeading">Reviews <span class="ap-meta"><%= pagination.total %></span></h2><span class="ap-meta">Newest first</span></div>
  <% if (!feedbackList || feedbackList.length === 0) { %>
  <div class="ap-empty"><strong><%= filtered ? 'No reviews match these filters' : 'No feedback yet' %></strong><%= filtered ? 'Try another rating or category.' : 'Guests can rate a booking from the portal once it is completed.' %></div>
  <% } else { %>
  <ul class="fb-list">
    <% for (const f of feedbackList) { %>
    <li class="fb-item">
      <div class="fb-item-head">
        <span class="fb-stars" role="img" aria-label="<%= f.rating %> out of 5"><% for (let s = 1; s <= 5; s++) { %><i class="fas fa-star <%= s <= f.rating ? 'is-on' : '' %>" aria-hidden="true"></i><% } %></span>
        <a href="/crm/customers/<%= f.customer_id %>" class="fb-name"><%= f.customer_name %></a>
        <span class="ap-meta"><%= cap(f.category) %> · <%= cap(f.reservation_type) %> · <a href="/reservations/<%= f.reservation_id %>" class="ap-code"><%= f.booking_ref %></a> · <%= formatDate(f.created_at) %></span>
      </div>
      <p class="fb-comment"><%= f.comments %></p>
      <% if (f.suggestions) { %><p class="fb-suggestion"><span class="ap-meta">Suggestion:</span> <%= f.suggestions %></p><% } %>
      <% if (f.admin_response) { %>
      <div class="fb-response"><span class="ap-meta">Our response<%= f.responded_by_name ? ' · ' + f.responded_by_name : '' %></span><p class="mb-0"><%= f.admin_response %></p></div>
      <% } %>
      <div class="fb-item-foot">
        <span class="fb-flag <%= f.admin_response ? 'is-done' : 'is-todo' %>"><i class="fas <%= f.admin_response ? 'fa-check' : 'fa-reply' %>" aria-hidden="true"></i><%= f.admin_response ? 'Responded' : 'Awaiting response' %></span>
        <% if (!f.is_public) { %><span class="fb-flag"><i class="fas fa-eye-slash" aria-hidden="true"></i>Hidden from website</span><% } %>
        <a href="/feedback/<%= f.id %>" class="ap-act ms-auto"><%= f.admin_response ? 'View' : 'Respond' %><span class="br-sr-only"> to feedback from <%= f.customer_name %></span></a>
      </div>
    </li>
    <% } %>
  </ul>
  <% } %>
  <% if (pagination && pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
</section>

</div>
