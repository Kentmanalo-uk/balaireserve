<% layout('layouts/main') %>
<% const cap = (s) => { const t = String(s || '').replace(/_/g, ' '); return t.charAt(0).toUpperCase() + t.slice(1); }; %>
<div class="ap-page">

<!--page-head-->
<a href="/feedback" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Feedback</a>
<h1 class="ph-title">Feedback from <%= fb.customer_name %></h1>
<div class="ph-actions">
    <span class="fb-flag <%= fb.admin_response ? 'is-done' : 'is-todo' %>"><i class="fas <%= fb.admin_response ? 'fa-check' : 'fa-reply' %>" aria-hidden="true"></i><%= fb.admin_response ? 'Responded' : 'Awaiting response' %></span>
    <% if (currentUser && currentUser.role === 'admin') { %>
    <form action="/feedback/<%= fb.id %>/toggle-public" method="POST" class="d-inline">
      <button type="submit" class="btn btn-outline-secondary"
        data-confirm="<%= fb.is_public ? 'Hide this review from the public landing page?' : 'Make this review visible on the public landing page?' %>"
        data-confirm-title="<%= fb.is_public ? 'Hide Review' : 'Show Review' %>"
        data-confirm-ok="<%= fb.is_public ? 'Hide' : 'Show' %>">
        <i class="fas fa-<%= fb.is_public ? 'eye-slash' : 'eye' %>" aria-hidden="true"></i><%= fb.is_public ? 'Hide from website' : 'Show on website' %>
      </button>
    </form>
    <% } %>
  </div>
<!--/page-head-->
<div class="page-meta"><%= fb.rating %>/5 · <%= cap(fb.category) %> · <%= formatDateTime(fb.created_at) %> · booking <a href="/reservations/<%= fb.reservation_id %>"><%= fb.booking_ref %></a></div>

<div class="ap-split">
  <div>
    <section class="ap-panel" aria-labelledby="fbReviewHeading">
      <div class="ap-panel-head">
        <h2 id="fbReviewHeading">Review</h2>
        <span class="ap-meta"><%= fb.is_public ? 'Visible on website (if rated 4–5)' : 'Hidden from website' %></span>
      </div>
      <div class="ap-panel-body">
        <div class="fb-review-rating">
          <span class="fb-stars fb-stars-lg" role="img" aria-label="<%= fb.rating %> out of 5"><% for (let s = 1; s <= 5; s++) { %><i class="fas fa-star <%= s <= fb.rating ? 'is-on' : '' %>" aria-hidden="true"></i><% } %></span>
          <strong><%= fb.rating %>/5</strong>
        </div>
        <blockquote class="fb-quote"><p class="mb-0"><%= fb.comments %></p></blockquote>
        <% if (fb.suggestions) { %><p class="fb-suggestion"><span class="ap-meta">Suggestion:</span> <%= fb.suggestions %></p><% } %>
        <% if (fb.admin_response) { %>
        <div class="fb-response">
          <span class="ap-meta">Our response — <%= fb.responded_by_name || 'Staff' %>, <%= formatDate(fb.responded_at) %></span>
          <p class="mb-0"><%= fb.admin_response %></p>
        </div>
        <% } %>
      </div>
    </section>

    <section class="ap-panel" aria-labelledby="fbRespondHeading">
      <div class="ap-panel-head"><h2 id="fbRespondHeading"><%= fb.admin_response ? 'Update response' : 'Write a response' %></h2></div>
      <div class="ap-panel-body">
        <form action="/feedback/<%= fb.id %>/respond" method="POST">
          <label class="form-label required" for="fbResponse">Response</label>
          <textarea name="admin_response" id="fbResponse" class="form-control" rows="4"
            placeholder="Thank the guest and address what they raised." required aria-describedby="fbResponseHelp"><%= fb.admin_response || '' %></textarea>
          <div class="form-text" id="fbResponseHelp">This response may be visible to the customer. Keep it professional and helpful.</div>
          <div class="mt-3"><button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane" aria-hidden="true"></i><%= fb.admin_response ? 'Update response' : 'Save response' %></button></div>
        </form>
      </div>
    </section>
  </div>

  <aside>
    <section class="ap-panel" aria-labelledby="fbCustHeading">
      <div class="ap-panel-head"><h2 id="fbCustHeading">Guest</h2></div>
      <div class="ap-panel-body">
        <dl class="ap-dl">
          <dt>Name</dt><dd><a href="/crm/customers/<%= fb.cust_id %>"><%= fb.customer_name %></a></dd>
          <dt>Email</dt><dd><%= fb.customer_email || '—' %></dd>
          <dt>Booking</dt><dd><a href="/reservations/<%= fb.reservation_id %>" class="ap-code"><%= fb.booking_ref %></a> <span class="ap-meta"><%= cap(fb.reservation_type) %></span></dd>
          <% if (fb.check_in_date || fb.event_date) { %><dt>Stay / event</dt><dd><%= formatDate(fb.check_in_date || fb.event_date) %></dd><% } %>
        </dl>
      </div>
    </section>

    <% if (otherFeedback && otherFeedback.length > 0) { %>
    <section class="ap-panel" aria-labelledby="fbOtherHeading">
      <div class="ap-panel-head"><h2 id="fbOtherHeading">Other feedback from this guest</h2></div>
      <ul class="fb-list fb-list-compact">
        <% for (const o of otherFeedback) { %>
        <li class="fb-item">
          <div class="fb-item-head">
            <span class="fb-stars" role="img" aria-label="<%= o.rating %> out of 5"><% for (let s = 1; s <= 5; s++) { %><i class="fas fa-star <%= s <= o.rating ? 'is-on' : '' %>" aria-hidden="true"></i><% } %></span>
            <span class="ap-meta"><%= formatDate(o.created_at) %> · <span class="ap-code"><%= o.booking_ref %></span></span>
            <a href="/feedback/<%= o.id %>" class="ap-act ms-auto">View</a>
          </div>
          <p class="fb-comment"><%= o.comments ? o.comments.slice(0, 90) + (o.comments.length > 90 ? '…' : '') : '—' %></p>
        </li>
        <% } %>
      </ul>
    </section>
    <% } %>
  </aside>
</div>

</div>
