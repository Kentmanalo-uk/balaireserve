<% layout('layouts/main') %>
<% const hasPhotos = room && room.imagesList && room.imagesList.length > 0; %>
<div class="ap-page">

<!--page-head-->
<a href="/rooms" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Rooms</a>
<h1 class="ph-title"><%= room ? 'Edit Room ' + room.room_number : 'Add New Room' %></h1>
<% if (room) { %><div class="ph-actions"><a href="/stay/room/<%= room.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public room page in a new tab</span></a></div><% } %>
<!--/page-head-->
<p class="page-intro">Changes to price, description and photos show on the public website and guest portal as soon as you save.</p>

<% if (errors && errors.length > 0) { %>
<div class="alert alert-danger ap-errors" role="alert">
  <strong>Please fix the following:</strong>
  <ul><% for (const e of errors) { %><li><%= e.msg %></li><% } %></ul>
</div>
<% } %>

<form data-guard="this room" action="<%= room ? '/rooms/' + room.id + '/edit' : '/rooms' %>"
      method="POST" enctype="multipart/form-data" id="roomForm" class="ap-form">

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Room</h2>
      <p>How the room is identified at the front desk and on the website.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label required" for="roomNumber">Room number</label>
          <input type="text" name="room_number" id="roomNumber" class="form-control"
            value="<%= old.room_number || '' %>" placeholder="e.g. CS-02"
            <%= room ? 'readonly' : '' %> required aria-describedby="roomNumberHelp" />
          <div class="form-text" id="roomNumberHelp"><%= room ? 'The room number can’t be changed after the room is created.' : 'A short unique code, e.g. CS-02.' %></div>
        </div>
        <div class="col-md-6">
          <label class="form-label required" for="roomName">Room name</label>
          <input type="text" name="name" id="roomName" class="form-control"
            value="<%= old.name || '' %>" placeholder="e.g. Casa Standard Room" required />
        </div>
        <div class="col-md-6">
          <label class="form-label required" for="roomTypeId">Room type</label>
          <select name="room_type_id" id="roomTypeId" class="form-select" required>
            <option value="">Select type…</option>
            <% for (const rt of roomTypes) { %>
            <option value="<%= rt.id %>" <%= String(old.room_type_id) === String(rt.id) ? 'selected' : '' %>><%= rt.name %> – <%= formatPeso(rt.base_price) %>/night</option>
            <% } %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="roomFloor">Floor <span class="ap-meta fw-normal">(optional)</span></label>
          <input type="text" name="floor" id="roomFloor" class="form-control"
            value="<%= old.floor || '' %>" placeholder="e.g. 1st Floor" />
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Guests and price</h2>
      <p>A room booking costs this nightly rate × the number of nights.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label required" for="roomCapacity">Sleeps (guests)</label>
          <input type="number" name="capacity" id="roomCapacity" class="form-control"
            value="<%= old.capacity || 2 %>" min="1" required />
        </div>
        <div class="col-md-4">
          <label class="form-label required" for="roomPrice">Price per night</label>
          <div class="input-group">
            <span class="input-group-text">₱</span>
            <input type="number" name="price" id="roomPrice" class="form-control"
              value="<%= old.price || '' %>" min="0" step="0.01" placeholder="0.00" required />
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label required" for="roomStatus">Status</label>
          <select name="status" id="roomStatus" class="form-select">
            <% for (const s of ['available','reserved','occupied','cleaning','maintenance','unavailable']) { %>
            <option value="<%= s %>" <%= (old.status || 'available') === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
            <% } %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Description</h2>
      <p>Only list amenities the room really has — guests rely on them when choosing.</p>
    </div>
    <div class="ap-section-body">
      <div class="mb-3">
        <label class="form-label" for="roomAmenities">Amenities</label>
        <input type="text" name="amenities" id="roomAmenities" class="form-control"
          value="<%= old.amenitiesStr || '' %>"
          placeholder="e.g. Air conditioning, Hot shower, TV" aria-describedby="roomAmenitiesHelp" />
        <div class="form-text" id="roomAmenitiesHelp">Separate each amenity with a comma.</div>
      </div>
      <div>
        <label class="form-label" for="roomDescription">Description</label>
        <textarea name="description" id="roomDescription" class="form-control" rows="4"
          placeholder="What guests should know about this room"><%= old.description || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Photos</h2>
      <p>Up to 5 photos, 5 MB each (JPG, PNG or WEBP). The first photo is the cover shown in listings.</p>
    </div>
    <div class="ap-section-body">
      <% if (hasPhotos) { %>
      <div class="cat-photo-block">
        <h3>Current photos</h3>
        <div class="ap-thumb-grid" id="existingImagesGrid">
          <% for (let i = 0; i < room.imagesList.length; i++) { const img = room.imagesList[i]; %>
          <div class="ap-thumb-item existing-img-item" data-img="<%= img %>">
            <div class="ap-thumb">
              <img src="<%= img %>" alt="Room photo <%= i + 1 %>" data-missing="Photo unavailable — file missing" />
              <% if (i === 0) { %><span class="cat-thumb-tag">Cover</span><% } %>
            </div>
            <input type="hidden" name="keep_images" value="<%= img %>" class="keep-img-input" form="roomForm" />
            <button type="button" class="ap-act is-danger remove-img-btn" aria-pressed="false">Remove</button>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="cat-photo-block">
        <h3><%= hasPhotos ? 'Add more photos' : 'Upload photos' %></h3>
        <div class="upload-dropzone cat-dropzone" id="dropZone">
          <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
          <span>Drag photos here, or</span>
          <label for="roomImageInput" class="btn btn-secondary-quiet btn-sm mb-0">Choose files</label>
          <input type="file" id="roomImageInput" name="images" form="roomForm"
            multiple accept="image/*" class="d-none" />
        </div>
        <div class="ap-thumb-grid mt-3" id="newImagesPreview" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <div class="ap-form-actions">
    <span class="ap-meta ap-required-note">Fields marked <span class="text-danger">*</span> are required.</span>
    <a href="/rooms<%= room ? '/' + room.id : '' %>" class="btn btn-secondary-quiet">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= room ? 'Save changes' : 'Create room' %></button>
  </div>
</form>

</div>

<script>
(function () {
  // Remove / undo an existing photo: a removed photo's keep_images input is disabled so it isn't submitted.
  document.querySelectorAll('.remove-img-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var wrapper = this.closest('.existing-img-item');
      var inp     = wrapper.querySelector('.keep-img-input');
      var removed = !wrapper.classList.contains('is-removed');
      if (inp) inp.disabled = removed;
      wrapper.classList.toggle('is-removed', removed);
      this.textContent = removed ? 'Undo' : 'Remove';
      this.classList.toggle('is-danger', !removed);
      this.setAttribute('aria-pressed', removed ? 'true' : 'false');
    });
  });

  var input   = document.getElementById('roomImageInput');
  var preview = document.getElementById('newImagesPreview');
  var dropZone= document.getElementById('dropZone');
  var dtFiles = new DataTransfer();

  function addFiles(files) {
    for (var i = 0; i < files.length; i++) {
      if (!files[i].type.startsWith('image/')) continue;
      if (dtFiles.items.length >= 5) break;
      dtFiles.items.add(files[i]);
    }
    input.files = dtFiles.files;
    renderPreviews();
  }

  function renderPreviews() {
    preview.innerHTML = '';
    Array.from(dtFiles.files).forEach(function (file, idx) {
      var item  = document.createElement('div');
      item.className = 'ap-thumb-item';
      var thumb = document.createElement('div');
      thumb.className = 'ap-thumb';
      var img = document.createElement('img');
      img.alt = file.name;
      img.src = URL.createObjectURL(file);
      thumb.appendChild(img);
      var name = document.createElement('span');
      name.className = 'ap-thumb-caption';
      name.textContent = (idx === 0 && !document.querySelector('.keep-img-input') ? 'Cover · ' : 'New · ') + file.name;
      var remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'ap-act is-danger';
      remove.textContent = 'Remove';
      remove.addEventListener('click', function () {
        var newDt = new DataTransfer();
        Array.from(dtFiles.files).forEach(function (f, fi) { if (fi !== idx) newDt.items.add(f); });
        dtFiles     = newDt;
        input.files = dtFiles.files;
        renderPreviews();
      });
      item.appendChild(thumb); item.appendChild(name); item.appendChild(remove);
      preview.appendChild(item);
    });
  }

  input.addEventListener('change', function () { addFiles(input.files); });

  dropZone.addEventListener('dragover',  function (e) { e.preventDefault(); this.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', function ()  { this.classList.remove('dragover'); });
  dropZone.addEventListener('drop',      function (e) {
    e.preventDefault();
    this.classList.remove('dragover');
    addFiles(e.dataTransfer.files);
  });
  dropZone.addEventListener('click', function (e) {
    if (e.target.tagName !== 'LABEL' && e.target.tagName !== 'INPUT') input.click();
  });
})();
</script>
