<% layout('layouts/main') %>
<% const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff'); %>
<div class="ap-page cat-show">

<!--page-head-->
<a href="/rooms" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Rooms</a>
<h1 class="ph-title"><%= room.name %></h1>
<div class="ph-actions">
    <a href="/stay/room/<%= room.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public room page in a new tab</span></a>
    <% if (canManage) { %>
    <a href="/rooms/<%= room.id %>/edit" class="btn btn-secondary-quiet"><i class="fas fa-pen" aria-hidden="true"></i>Edit room</a>
    <% } %>
    <a href="/reservations/new" class="btn btn-primary"><i class="fas fa-calendar-plus" aria-hidden="true"></i>New reservation</a>
  </div>
<!--/page-head-->
<div class="page-meta"><span class="ap-code"><%= room.room_number %></span> · <%= room.type_name %> · <%- statusBadge(room.status) %></div>

<div class="ap-split">
  <div class="cat-main">
    <%# Photos: one large image, the rest as smaller tiles; click to view uncropped %>
    <div class="cat-gallery<%= room.imagesList && room.imagesList.length === 1 ? ' is-single' : '' %>">
      <% if (room.imagesList && room.imagesList.length > 0) { %>
        <% for (let i = 0; i < room.imagesList.length; i++) { %>
        <button type="button" class="cat-photo" data-lightbox="<%= room.imagesList[i] %>" data-lightbox-title="<%= room.name %> — photo <%= i + 1 %>" aria-label="View photo <%= i + 1 %> of <%= room.imagesList.length %> full size">
          <img src="<%= room.imagesList[i] %>" alt="<%= room.name %> photo <%= i + 1 %>" <%- i > 0 ? 'loading="lazy"' : '' %> />
        </button>
        <% } %>
      <% } else { %>
        <div class="photo-pending"><i class="fas fa-image" aria-hidden="true"></i><span>Photos coming soon</span></div>
      <% } %>
    </div>

    <section class="ap-panel" aria-labelledby="roomHistoryHeading">
      <div class="ap-panel-head">
        <h2 id="roomHistoryHeading">Reservation history <span class="ap-meta">latest 10</span></h2>
        <a href="/reservations/new" class="ap-act">Book this room</a>
      </div>
      <% if (!reservations || reservations.length === 0) { %>
      <div class="ap-empty"><strong>No reservations yet</strong>Bookings that include this room will appear here.</div>
      <% } else { %>
      <div class="ap-table-wrap">
        <table class="table-br ap-table ap-stack">
          <thead><tr><th scope="col">Booking</th><th scope="col">Check-in</th><th scope="col">Check-out</th><th scope="col" class="num">Amount</th><th scope="col">Status</th></tr></thead>
          <tbody>
            <% for (const r of reservations) { %>
            <tr>
              <td class="ap-cell-title"><a href="/reservations/<%= r.id %>" class="ap-name"><%= r.customer_name %></a><span class="ap-line2 ap-code"><%= r.booking_ref %></span></td>
              <td data-label="Check-in" class="text-nowrap"><%= formatDate(r.check_in_date) %></td>
              <td data-label="Check-out" class="text-nowrap"><%= formatDate(r.check_out_date) %></td>
              <td class="num" data-label="Amount"><%= formatPeso(r.total_amount) %></td>
              <td class="ap-cell-status"><%- statusBadge(r.status) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </div>

  <aside class="cat-aside">
    <section class="ap-panel" aria-labelledby="roomDetailsHeading">
      <div class="ap-panel-head"><h2 id="roomDetailsHeading">Room details</h2></div>
      <div class="ap-panel-body">
        <p class="cat-price mb-3"><%= formatPeso(room.price) %> <small>/ night</small></p>
        <dl class="ap-dl">
          <dt>Room number</dt><dd><%= room.room_number %></dd>
          <dt>Type</dt><dd><%= room.type_name %></dd>
          <dt>Sleeps</dt><dd><%= room.capacity %> guests</dd>
          <dt>Floor</dt><dd><%= room.floor || '—' %></dd>
          <dt>Status</dt><dd><%- statusBadge(room.status) %></dd>
        </dl>
        <% if (room.description) { %>
        <h3 class="cat-subhead">Description</h3>
        <p class="cat-desc-text"><%= room.description %></p>
        <% } %>
        <% if (room.amenitiesList && room.amenitiesList.length > 0) { %>
        <h3 class="cat-subhead">Amenities</h3>
        <ul class="cat-amenities">
          <% for (const a of room.amenitiesList) { %><li><%= a %></li><% } %>
        </ul>
        <% } %>
      </div>
      <% if (canManage) { %>
      <div class="ap-panel-foot">
        <form action="/rooms/<%= room.id %>/status" method="POST" class="cat-status-form">
          <div class="ap-field">
            <label for="roomStatusSelect">Change status</label>
            <select name="status" id="roomStatusSelect" class="form-select">
              <% for (const s of ['available','cleaning','maintenance','unavailable']) { %>
              <option value="<%= s %>" <%= room.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
              <% } %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Update</button>
        </form>
      </div>
      <% } %>
    </section>
  </aside>
</div>

</div>
<script>
// A photo whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-photo > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'cat-photo photo-pending';
    box.textContent = 'Photo unavailable';
    img.closest('.cat-photo').replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
