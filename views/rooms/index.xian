<% layout('layouts/main') %>
<%
  const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
  const filtered  = !!(filters.search || filters.type || filters.status);
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Rooms</h1>
<% if (canManage) { %>
  <div class="ph-actions">
    <a href="/rooms/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Add room</a>
  </div>
  <% } %>
<!--/page-head-->

<form method="GET" action="/rooms" class="ap-toolbar" role="search" aria-label="Filter rooms">
  <div class="ap-field ap-field-search">
    <label for="roomSearch">Search</label>
    <div class="ap-search"><i class="fas fa-search" aria-hidden="true"></i><input type="text" id="roomSearch" name="search" value="<%= filters.search %>" class="form-control" placeholder="Room number or name" /></div>
  </div>
  <div class="ap-field">
    <label for="roomType">Room type</label>
    <select id="roomType" name="type" class="form-select">
      <option value="">All types</option>
      <% for (const rt of roomTypes) { %><option value="<%= rt.name %>" <%= filters.type === rt.name ? 'selected' : '' %>><%= rt.name %></option><% } %>
    </select>
  </div>
  <div class="ap-field">
    <label for="roomStatus">Status</label>
    <select id="roomStatus" name="status" class="form-select">
      <option value="">All statuses</option>
      <% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% } %>
    </select>
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filtered) { %><a href="/rooms" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="roomsHeading">
  <div class="ap-panel-head">
    <h2 id="roomsHeading">All rooms <span class="ap-meta"><%= pagination.total %> room<%= pagination.total === 1 ? '' : 's' %><%= filtered ? ' match' : '' %></span></h2>
  </div>
  <% if (!rooms || rooms.length === 0) { %>
  <div class="ap-empty">
    <strong><%= filtered ? 'No rooms match these filters' : 'No rooms yet' %></strong>
    <%= filtered ? 'Try a different search or clear the filters.' : 'Add the rooms guests can book overnight.' %>
    <% if (filtered) { %><div><a href="/rooms" class="btn btn-outline-secondary btn-sm">Clear filters</a></div><% } else if (canManage) { %><div><a href="/rooms/new" class="btn btn-primary btn-sm">Add room</a></div><% } %>
  </div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead>
        <tr>
          <th scope="col">Room</th>
          <th scope="col" class="cat-col-opt">Type</th>
          <th scope="col" class="num">Sleeps</th>
          <th scope="col" class="num">Price / night</th>
          <th scope="col">Status</th>
          <th scope="col" class="text-end"><span class="br-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const room of rooms) { %>
        <tr>
          <td class="ap-cell-title">
            <div class="cat-item">
              <div class="cat-thumb">
                <% if (room.imagesList && room.imagesList.length > 0) { %>
                <img src="<%= room.imagesList[0] %>" alt="" loading="lazy" sizes="240px" />
                <% } else { %>
                <div class="photo-pending"><span>Photos coming soon</span></div>
                <% } %>
              </div>
              <div class="cat-item-text">
                <a href="/rooms/<%= room.id %>" class="ap-name"><%= room.name %></a>
                <span class="ap-line2"><span class="ap-code"><%= room.room_number %></span><%= room.floor ? ' · ' + room.floor : '' %></span>
              </div>
            </div>
          </td>
          <td class="cat-col-opt" data-label="Type"><%= room.type_name %></td>
          <td class="num" data-label="Sleeps"><%= room.capacity %></td>
          <td class="num" data-label="Price / night"><strong><%= formatPeso(room.price) %></strong></td>
          <td class="ap-cell-status"><%- statusBadge(room.status) %></td>
          <td class="ap-row-actions">
            <div class="ap-actions">
              <a href="/rooms/<%= room.id %>" class="ap-act">View</a>
              <% if (canManage) { %><a href="/rooms/<%= room.id %>/edit" class="ap-act">Edit</a><% } %>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
  <% } %>
</section>

</div>
<script>
// A thumbnail whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-thumb > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'photo-pending';
    box.textContent = 'Photo unavailable';
    img.replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
