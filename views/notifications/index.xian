<% layout('layouts/main') %>
<%
  const NOTIF = {
    reservation: ['fa-calendar-check', 'Booking'],
    payment:     ['fa-money-bill-wave', 'Payment'],
    inventory:   ['fa-boxes', 'Inventory'],
    inquiry:     ['fa-comment-dots', 'Inquiry'],
  };
  const unreadCount = (notifications || []).filter(n => !n.is_read).length;
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Notifications</h1>
<div class="ph-actions">
    <form action="/notifications/clear" method="POST"><button type="submit" class="btn btn-outline-secondary">Clear read</button></form>
  </div>
<!--/page-head-->
<p class="page-intro">Updates about bookings, payments, inquiries and stock. Opening this page marks them all as read.</p>

<section class="ap-panel" aria-labelledby="ntfHeading">
  <div class="ap-panel-head">
    <h2 id="ntfHeading">All notifications <span class="ap-meta"><%= pagination.total %></span></h2>
    <% if (unreadCount > 0) { %><span class="ap-meta"><span class="ntf-dot" aria-hidden="true"></span><%= unreadCount %> new since your last visit</span><% } %>
  </div>
  <% if (!notifications || notifications.length === 0) { %>
  <div class="ap-empty"><strong>You’re all caught up</strong>New bookings, payments and inquiries will show up here.</div>
  <% } else { %>
  <ul class="ntf-list">
    <% for (const n of notifications) { const meta = NOTIF[n.type] || ['fa-bell', 'System']; %>
    <li class="ntf-item <%= n.is_read ? '' : 'is-unread' %>">
      <i class="fas <%= meta[0] %> ntf-icon" aria-hidden="true"></i>
      <div class="ntf-text">
        <div class="ntf-title">
          <% if (!n.is_read) { %><span class="ntf-dot" aria-hidden="true"></span><span class="br-sr-only">New: </span><% } %>
          <%= n.title %>
        </div>
        <p class="ntf-msg"><%= n.message %></p>
        <div class="ntf-meta"><%= meta[1] %> · <time><%= formatDateTime(n.created_at) %></time></div>
      </div>
      <% if (n.link) { %><a href="<%= n.link %>" class="ap-act ntf-open">Open<span class="br-sr-only">: <%= n.title %></span></a><% } %>
    </li>
    <% } %>
  </ul>
  <% } %>
  <% if (pagination && pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
</section>

</div>
