<% layout('layouts/main') %>

<!--page-head-->
<h1 class="ph-title">Booking calendar</h1>
<div class="ph-actions">
  <a href="/reservations" class="btn btn-secondary-quiet"><i class="fas fa-list" aria-hidden="true"></i>List</a>
  <a href="/reservations/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>New reservation</a>
</div>
<!--/page-head-->

<div class="panel">
  <%# On phones the legend and filters fold away under one toggle so the agenda comes first %>
  <details class="cal-options" id="calOptions" open>
  <summary>Legend and filters</summary>
  <!-- Status legend: same families as the status chips everywhere else -->
  <div class="cal-legend" role="group" aria-label="Status legend">
    <span class="lg-group">
      <span class="lg-group-label">Dates blocked</span>
      <span class="lg"><span class="lg-swatch lg-amber" aria-hidden="true"></span>Pending</span>
      <span class="lg"><span class="lg-swatch lg-purple" aria-hidden="true"></span>Pencil Booking <span class="lg-note">tentative · dashed edge</span></span>
      <span class="lg"><span class="lg-swatch lg-slate" aria-hidden="true"></span>On Hold <span class="lg-note">paused · hatched</span></span>
      <span class="lg"><span class="lg-swatch lg-orange" aria-hidden="true"></span>Awaiting Payment</span>
      <span class="lg"><span class="lg-swatch lg-teal" aria-hidden="true"></span>Confirmed</span>
      <span class="lg"><span class="lg-swatch lg-blue" aria-hidden="true"></span>Checked In</span>
    </span>
    <span class="lg-sep" aria-hidden="true"></span>
    <span class="lg-group">
      <span class="lg-group-label">Not blocking</span>
      <span class="lg"><span class="lg-swatch lg-red" aria-hidden="true"></span>Cancelled / Rejected <span class="text-muted">(tick below to show)</span></span>
      <span class="text-muted">Completed stays are not drawn — find them in the <a href="/reservations?status=completed">reservation list</a>.</span>
    </span>
  </div>

  <div class="cal-filters">
    <fieldset>
      <legend>Show</legend>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showRoom" checked>
        <label class="form-check-label" for="showRoom">Rooms</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showCottage" checked>
        <label class="form-check-label" for="showCottage">Cottages</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showVenue" checked>
        <label class="form-check-label" for="showVenue">Venues</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showEvent" checked>
        <label class="form-check-label" for="showEvent">Events</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showCancelled">
        <label class="form-check-label" for="showCancelled">Cancelled / rejected</label>
      </div>
    </fieldset>

    <%# ── Date range filter ── %>
    <fieldset>
      <legend>Booking dates</legend>
      <label for="dateFrom" class="visually-hidden">From date</label>
      <input type="date" id="dateFrom" class="form-control form-control-sm" style="max-width:160px;" />
      <span class="small text-muted">to</span>
      <label for="dateTo" class="visually-hidden">To date</label>
      <input type="date" id="dateTo" class="form-control form-control-sm" style="max-width:160px;" />
      <button type="button" id="applyDateFilter" class="btn btn-sm btn-primary">Apply</button>
      <button type="button" id="clearDateFilter" class="btn btn-sm btn-secondary-quiet">Clear</button>
    </fieldset>
  </div>

  </details>

  <div class="cal-body">
    <div id="calendarContainer"></div>
  </div>
</div>

<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header" id="eventModalHeader">
        <h2 class="modal-title" id="eventModalTitle">Booking details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="eventModalBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary-quiet" data-bs-dismiss="modal">Close</button>
        <a href="#" id="eventModalLink" class="btn btn-primary">Open reservation</a>
      </div>
    </div>
  </div>
</div>

<script>
window.addEventListener('load', function () {

  var rawEvents = <%- calendarEvents %>;

  // Status → colour family (tokens.css st-* / main.css ev-*). Colour is never
  // the only cue: every event title starts with its status label.
  var STATUS_FAMILY = {
    pending:          'amber',
    pencil:           'purple',
    on_hold:          'slate',
    awaiting_payment: 'orange',
    confirmed:        'teal',
    checked_in:       'blue',
    completed:        'gray',
    cancelled:        'red',
    rejected:         'red',
    no_show:          'red'
  };

  var TYPE_LABELS = {
    room:    'Room',
    venue:   'Venue',
    event:   'Event',
    cottage: 'Cottage'
  };

  // Labels that differ from the title-cased key.
  var HELD_LABELS = {
    pencil:  'Pencil Booking',
    on_hold: 'On Hold'
  };

  function statusText(s) {
    if (HELD_LABELS[s]) return HELD_LABELS[s];
    return String(s || '').replace(/_/g, ' ').replace(/\b\w/g, function (l) { return l.toUpperCase(); });
  }
  function niceDate(v) {
    if (!v) return '';
    var d = new Date(String(v).slice(0, 10) + 'T00:00:00');
    return isNaN(d) ? String(v) : d.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  }
  var BLOCKING = { pending: 1, pencil: 1, on_hold: 1, awaiting_payment: 1, confirmed: 1, checked_in: 1 };
  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
  }

  function buildEvents(raw) {
    return raw.map(function (r) {
      var family = STATUS_FAMILY[r.status] || 'gray';
      var type   = TYPE_LABELS[r.reservation_type] || (r.is_event ? 'Event' : '');
      var name   = r.is_event ? (r.event_name || r.title) : (r.customer_name || r.title || '');
      var label  = statusText(r.status) + ' · ' + name + (type ? ' (' + type + ')' : '');

      var start  = r.checkin_date || r.event_date || '';
      var end    = r.checkout_date || r.event_date || '';

      if (r.is_all_day && end) {
        var d = new Date(end);
        d.setDate(d.getDate() + 1);
        end = d.toISOString().slice(0, 10);
      }

      var classes = ['ev-st', 'ev-' + family];
      if (r.status === 'pencil')  classes.push('ev-pencil');
      if (r.status === 'on_hold') classes.push('ev-on-hold');

      return {
        id:    String(r.id) + (r.is_event ? '_ev' : '_res'),
        title: label,
        start: start,
        end:   end || start,
        allDay: true,
        classNames: classes,
        extendedProps: {
          reservationId: r.reservation_id || r.id,
          status:        r.status || '',
          family:        family,
          type:          r.reservation_type || '',
          isEvent:       !!r.is_event,
          customerName:  r.customer_name || '',
          bookingRef:    r.booking_ref || '',
          checkin:       r.checkin_date || '',
          checkout:      r.checkout_date || '',
          eventDate:     r.event_date || '',
          startTime:     r.start_time || '',
          endTime:       r.end_time || '',
          numGuests:     r.num_guests || '',
          paymentStatus: r.payment_status || '',
          venueName:     r.venue_name || '',
          roomName:      r.room_name || '',
          eventName:     r.event_name || '',
          // Inclusive date range of the booking itself (for the date filter).
          rangeStart:    (r.checkin_date || r.event_date || '').slice(0, 10),
          rangeEnd:      (r.checkout_date || r.event_date || r.checkin_date || '').slice(0, 10)
        }
      };
    });
  }

  var allEvents = buildEvents(rawEvents);

  var filterRoom     = document.getElementById('showRoom');
  var filterVenue    = document.getElementById('showVenue');
  var filterEvent    = document.getElementById('showEvent');
  var filterCottage  = document.getElementById('showCottage');
  var filterCancelled= document.getElementById('showCancelled');
  var dateFromEl     = document.getElementById('dateFrom');
  var dateToEl       = document.getElementById('dateTo');

  // Active date-range filter (empty when not applied).
  var dateRange = { from: '', to: '' };

  function getFiltered() {
    return allEvents.filter(function (e) {
      var t = e.extendedProps.type;
      var s = e.extendedProps.status;
      if (t === 'room'    && !filterRoom.checked)     return false;
      if (t === 'venue'   && !filterVenue.checked)    return false;
      if (t === 'event'   && !filterEvent.checked)    return false;
      if (t === 'cottage' && !filterCottage.checked)  return false;
      if ((s === 'cancelled' || s === 'rejected') && !filterCancelled.checked) return false;

      // Date-range filter: show only bookings whose date range overlaps the
      // selected [from, to]. Either bound may be left blank (open-ended).
      if (dateRange.from || dateRange.to) {
        var bStart = e.extendedProps.rangeStart || '';
        var bEnd   = e.extendedProps.rangeEnd || bStart;
        if (!bStart) return false;
        if (dateRange.from && bEnd  < dateRange.from) return false;  // booking ends before window
        if (dateRange.to   && bStart > dateRange.to)   return false; // booking starts after window
      }
      return true;
    });
  }

  function refreshEvents() {
    calendar.removeAllEvents();
    calendar.addEventSource(getFiltered());
  }

  var calEl = document.getElementById('calendarContainer');
  var bsModal = new bootstrap.Modal(document.getElementById('eventModal'));
  // Phones get the agenda (list) by default: a month grid is unreadable at 360px.
  var narrow = window.matchMedia('(max-width: 767.98px)').matches;
  if (narrow) document.getElementById('calOptions').removeAttribute('open');
  // Bookings are whole-day blocks, so day and week use the day grid (no empty hour rows).

  var calendar = new FullCalendar.Calendar(calEl, {
    initialView:  narrow ? 'listWeek' : 'dayGridMonth',
    height:       'auto',
    firstDay:     0,
    navLinks:     true,
    dayMaxEvents: 4,
    headerToolbar: {
      left:   'prev,next today',
      center: 'title',
      // Phones get agenda lists for day / week / month; a month grid is unreadable at 360px.
      right:  narrow ? 'listDay,listWeek,listMonth' : 'dayGridDay,dayGridWeek,dayGridMonth,listWeek'
    },
    buttonText: { today: 'Today' },
    views: {
      dayGridDay:   { buttonText: 'Day', dayMaxEvents: false },
      dayGridWeek:  { buttonText: 'Week', dayMaxEvents: false },
      dayGridMonth: { buttonText: 'Month' },
      listDay:      { buttonText: 'Day' },
      listWeek:     { buttonText: narrow ? 'Week' : 'Agenda' },
      listMonth:    { buttonText: 'Month' }
    },
    noEventsContent: 'No bookings in this period. Try the next month, or include cancelled bookings.',
    eventInteractive: true,   // every booking is a keyboard-focusable button (Enter opens it)
    events: getFiltered(),

    eventClick: function (info) {
      info.jsEvent.preventDefault();
      // Escape every text value (customer names etc.) before it goes into innerHTML.
      var p = {};
      Object.keys(info.event.extendedProps).forEach(function (key) {
        var value = info.event.extendedProps[key];
        p[key] = typeof value === 'string' ? esc(value) : value;
      });

      document.getElementById('eventModalTitle').textContent = (p.isEvent ? (info.event.extendedProps.eventName || 'Event') : (info.event.extendedProps.bookingRef || 'Booking')) + ' — ' + statusText(info.event.extendedProps.status);

      var rows = '';
      rows += '<dt>Status</dt><dd><span class="status-chip st-' + p.family + '">' + esc(statusText(info.event.extendedProps.status)) + '</span>' + (BLOCKING[info.event.extendedProps.status] ? ' <span class="small text-muted">Dates blocked</span>' : '') + '</dd>';
      rows += '<dt>Customer</dt><dd>' + (p.customerName || '&mdash;') + '</dd>';
      rows += '<dt>Booking ref</dt><dd class="tnum">' + (p.bookingRef || '&mdash;') + '</dd>';
      rows += '<dt>Type</dt><dd>' + esc(TYPE_LABELS[info.event.extendedProps.type] || info.event.extendedProps.type || '—') + '</dd>';

      if (p.isEvent) {
        rows += '<dt>Event</dt><dd>' + (p.eventName || '&mdash;') + '</dd>';
        rows += '<dt>Date</dt><dd>' + (esc(niceDate(info.event.extendedProps.eventDate)) || '&mdash;') + (p.startTime ? ' &middot; ' + p.startTime + ' &ndash; ' + p.endTime : '') + '</dd>';
        if (p.venueName) rows += '<dt>Venue</dt><dd>' + p.venueName + '</dd>';
      } else if (p.type === 'room' || p.type === 'cottage') {
        rows += '<dt>Check-in</dt><dd>' + (esc(niceDate(info.event.extendedProps.checkin)) || '&mdash;') + (p.startTime ? ' &middot; ' + p.startTime : '') + '</dd>';
        rows += '<dt>Check-out</dt><dd>' + (esc(niceDate(info.event.extendedProps.checkout)) || '&mdash;') + (p.endTime ? ' &middot; ' + p.endTime : '') + '</dd>';
        if (p.roomName) rows += '<dt>Room</dt><dd>' + p.roomName + '</dd>';
      } else {
        var day = p.checkin || p.eventDate || '';
        var dateText = (day || '&mdash;') + (p.checkout && p.checkout !== day ? ' &ndash; ' + p.checkout : '');
        rows += '<dt>Date</dt><dd>' + dateText + (p.startTime ? ' &middot; ' + p.startTime + ' &ndash; ' + (p.endTime || '') : '') + '</dd>';
        if (p.eventName) rows += '<dt>Package</dt><dd>' + p.eventName + '</dd>';
        if (p.venueName) rows += '<dt>Venue</dt><dd>' + p.venueName + '</dd>';
      }

      rows += '<dt>Guests</dt><dd>' + (p.numGuests || '&mdash;') + '</dd>';
      rows += '<dt>Payment</dt><dd>' + (p.paymentStatus ? '<span class="pay-status pay-' + p.paymentStatus + '">' + esc(statusText(info.event.extendedProps.paymentStatus)) + '</span>' : '&mdash;') + '</dd>';

      document.getElementById('eventModalBody').innerHTML = '<dl class="ev-detail">' + rows + '</dl>';
      document.getElementById('eventModalLink').href = '/reservations/' + p.reservationId;
      bsModal.show();
    },

    eventDidMount: function (info) {
      var p = info.event.extendedProps;
      var lines = [info.event.title];
      if (p.checkin)   lines.push('Check-in: ' + p.checkin);
      if (p.checkout)  lines.push('Check-out: ' + p.checkout);
      if (p.eventDate && !p.checkin) lines.push('Date: ' + p.eventDate);
      if (p.startTime) lines.push('Time: ' + p.startTime + (p.endTime ? ' – ' + p.endTime : ''));
      info.el.title = lines.join('\n');
      // List view: colour the dot by the same family.
      var dot = info.el.querySelector('.fc-list-event-dot');
      if (dot) {
        dot.classList.add('lg-swatch', 'lg-' + p.family);
        var key = document.querySelector('.cal-legend .lg-' + p.family);
        if (key) dot.style.borderColor = getComputedStyle(key).borderLeftColor;
      }
    }
  });

  calendar.render();

  [filterRoom, filterVenue, filterEvent, filterCottage, filterCancelled].forEach(function (chk) {
    chk.addEventListener('change', refreshEvents);
  });

  // ── Date range filter buttons ──
  document.getElementById('applyDateFilter').addEventListener('click', function () {
    var from = dateFromEl.value;
    var to   = dateToEl.value;
    if (from && to && from > to) {
      if (window.appNotify) window.appNotify('The "From" date cannot be after the "To" date.', 'warning');
      else alert('The "From" date cannot be after the "To" date.');
      return;
    }
    dateRange.from = from;
    dateRange.to   = to;
    refreshEvents();
    // Jump the calendar to the start of the selected range for convenience.
    if (from) calendar.gotoDate(from);
    if (window.appNotify && (from || to)) {
      window.appNotify('Showing bookings' + (from ? ' from ' + from : '') + (to ? ' to ' + to : '') + '.', 'info');
    }
  });

  document.getElementById('clearDateFilter').addEventListener('click', function () {
    dateFromEl.value = '';
    dateToEl.value   = '';
    dateRange.from = '';
    dateRange.to   = '';
    refreshEvents();
  });

});
</script>
