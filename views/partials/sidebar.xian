<%
  // A nav item is active when the path starts with its prefix, unless a more
  // specific sibling owns that path (e.g. /reservations/view/calendar belongs
  // to Booking Calendar, not Reservations).
  const navOn = (prefix, ...except) => !!currentPath && currentPath.startsWith(prefix) && !except.some(x => currentPath.startsWith(x));
  const isStaffRole = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
  const isAdminRole = currentUser && currentUser.role === 'admin';

  // Grouped exactly by the existing back-office domains (V3 §09).
  const groups = [
    { label: null, items: [
      { href: '/dashboard', icon: 'fa-gauge', text: 'Dashboard', on: navOn('/dashboard') },
    ] },
  ];
  if (isStaffRole) {
    groups.push({ label: 'Bookings', items: [
      { href: '/reservations', icon: 'fa-calendar-check', text: 'Reservations', on: navOn('/reservations', '/reservations/view/calendar'),
        badge: pendingReservationsCount, badgeText: 'need attention', badgeTitle: pendingReservationsCount + ' reservation(s) need attention (pending review or awaiting payment)' },
      { href: '/checkin/desk', icon: 'fa-qrcode', text: 'Check-in desk', on: navOn('/checkin') },
      { href: '/reservations/view/calendar', icon: 'fa-calendar-days', text: 'Booking Calendar', on: navOn('/reservations/view/calendar') },
      { href: '/guests', icon: 'fa-people-roof', text: 'Guests', on: navOn('/guests') },
      { href: '/payments', icon: 'fa-money-bill-wave', text: 'Payments', on: navOn('/payments', '/payments/refunds/requests') },
      { href: '/payments/refunds/requests', icon: 'fa-hand-holding-dollar', text: 'Refund Requests', on: navOn('/payments/refunds/requests') },
      { href: '/inquiries', icon: 'fa-inbox', text: 'Inquiries', on: navOn('/inquiries'),
        badge: pendingInquiriesCount, badgeText: 'open', badgeTitle: pendingInquiriesCount + ' open inquiry(ies)' },
    ] });
    groups.push({ label: 'Accommodations', items: [
      { href: '/rooms', icon: 'fa-bed', text: 'Rooms', on: navOn('/rooms') },
      { href: '/venues', icon: 'fa-building-columns', text: 'Venues', on: navOn('/venues') },
      { href: '/cottages', icon: 'fa-umbrella-beach', text: 'Cottages', on: navOn('/cottages') },
    ] });
    groups.push({ label: 'Events', items: [
      { href: '/events', icon: 'fa-champagne-glasses', text: 'Events', on: navOn('/events') },
      { href: '/packages', icon: 'fa-gift', text: 'Event packages', on: navOn('/packages') },
    ] });
    groups.push({ label: 'Inventory', items: [
      { href: '/inventory', icon: 'fa-boxes-stacked', text: 'Inventory', on: navOn('/inventory') },
    ] });
    groups.push({ label: 'CRM', items: [
      { href: '/crm', icon: 'fa-address-book', text: 'Customers', on: navOn('/crm', '/crm/tickets') },
      { href: '/crm/tickets', icon: 'fa-ticket', text: 'Support Tickets', on: navOn('/crm/tickets') },
      { href: '/feedback', icon: 'fa-star-half-stroke', text: 'Feedback', on: navOn('/feedback') },
    ] });
  }
  if (isAdminRole) {
    groups.push({ label: 'Management', items: [
      { href: '/reports', icon: 'fa-file-lines', text: 'Reports', on: navOn('/reports') },
      { href: '/analytics', icon: 'fa-chart-line', text: 'Analytics', on: navOn('/analytics') },
      { href: '/users', icon: 'fa-users-gear', text: 'User Management', on: navOn('/users') },
      { href: '/settings', icon: 'fa-gear', text: 'Settings', on: navOn('/settings') },
    ] });
  }
%>
<nav class="sidebar" id="sidebar" aria-label="Back office">

  <div class="sidebar-brand">
    <a href="/dashboard" class="sidebar-home" data-tip="Balai-Reserve — dashboard">
      <img src="/images/brand/balai-icon-96.png" alt="" width="38" height="38" class="brand-mark brand-logo" />
      <span class="brand-words">
        <span class="brand-text">Balai-Reserve</span>
        <span class="brand-sub">Back office</span>
      </span>
    </a>
    <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">
      <i class="fas fa-xmark" aria-hidden="true"></i>
    </button>
  </div>

  <div class="sidebar-scroll">
    <% for (const g of groups) { %>
    <% if (g.label) { %><div class="nav-section-label" role="presentation"><span><%= g.label %></span></div><% } %>
    <ul class="sidebar-nav"<%- g.label ? ' aria-label="' + g.label + '"' : '' %>>
      <% for (const it of g.items) { %>
      <li class="nav-item">
        <a href="<%= it.href %>" class="nav-link<%= it.on ? ' active' : '' %>"<%- it.on ? ' aria-current="page"' : '' %> data-tip="<%= it.text %><%= it.badge > 0 ? ' (' + it.badge + ' ' + it.badgeText + ')' : '' %>">
          <i class="fas <%= it.icon %> nav-icon" aria-hidden="true"></i><span class="nav-text"><%= it.text %></span>
          <% if (it.badge > 0) { %><span class="nav-badge" title="<%= it.badgeTitle %>"><%= it.badge %><span class="visually-hidden"> <%= it.badgeText %></span></span><% } %>
        </a>
      </li>
      <% } %>
    </ul>
    <% } %>
  </div>

  <div class="sidebar-footer">
    <% if (currentUser) { %>
    <a href="/profile" class="sidebar-user"<%- navOn('/profile') ? ' aria-current="page"' : '' %> data-tip="My profile — <%= currentUser.firstName %> <%= currentUser.lastName %>">
      <span class="user-avatar" aria-hidden="true">
        <% if (currentUser.avatar) { %><img src="<%= currentUser.avatar %>" alt="" /><% } else { %><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %><% } %>
      </span>
      <span class="user-info">
        <span class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
        <span class="user-role"><%= currentUser.roleLabel %> · My profile</span>
      </span>
    </a>
    <% } %>
    <a href="/auth/logout" class="nav-link logout-link" data-tip="Log out">
      <i class="fas fa-arrow-right-from-bracket nav-icon" aria-hidden="true"></i><span class="nav-text">Log out</span>
    </a>
    <button type="button" class="sidebar-collapse" id="sidebarCollapse" aria-controls="sidebar" aria-expanded="true" data-tip="Expand sidebar">
      <i class="fas fa-angles-left nav-icon" aria-hidden="true"></i><span class="nav-text">Collapse sidebar</span>
    </button>
  </div>

</nav>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="sidebar-tip" id="sidebarTip" role="tooltip" hidden></div>

<%# Phones only (mobile.css): the most-used desk screens one tap away. The full menu stays behind ☰. Hidden at ≥576px by .m-only. %>
<% if (isStaffRole) { %>
<nav class="m-tabbar m-only" aria-label="Quick links">
  <% for (const t of [
       { href: '/dashboard', icon: 'fa-gauge', text: 'Home', on: navOn('/dashboard') },
       { href: '/reservations', icon: 'fa-calendar-check', text: 'Bookings', on: navOn('/reservations', '/reservations/view/calendar'), badge: pendingReservationsCount, badgeText: 'need attention' },
       { href: '/checkin/desk', icon: 'fa-qrcode', text: 'Check-in', on: navOn('/checkin') },
       { href: '/payments', icon: 'fa-money-bill-wave', text: 'Payments', on: navOn('/payments') },
       { href: '/inquiries', icon: 'fa-inbox', text: 'Inquiries', on: navOn('/inquiries'), badge: pendingInquiriesCount, badgeText: 'open' },
     ]) { %>
  <a href="<%= t.href %>" class="m-tab" <%- t.on ? 'aria-current="page"' : '' %>>
    <i class="fas <%= t.icon %>" aria-hidden="true"></i><span><%= t.text %></span>
    <% if (t.badge > 0) { %><span class="m-tab-badge"><%= t.badge > 9 ? '9+' : t.badge %><span class="br-sr-only"> <%= t.badgeText %></span></span><% } %>
  </a>
  <% } %>
</nav>
<% } %>
