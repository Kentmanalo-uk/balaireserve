<%
  // Today's date in the resort's time zone, so the front desk always sees the
  // operational day regardless of the server clock.
  const phToday = new Date().toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', weekday: 'short', month: 'short', day: 'numeric' });
  // The page's own header (back link, h1 title, contextual actions) is lifted
  // out of the view by layouts/main.xian and rendered here, so a page has one
  // title — in the top bar — instead of a top bar title plus a page header.
  const head = (typeof pageHead !== 'undefined' && pageHead) ? pageHead : '';
%>
<header class="top-navbar<%= head && /class="ph-actions/.test(head) ? ' has-actions' : '' %><%= head && /class="ph-back/.test(head) ? ' has-back' : '' %>">

  <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-controls="sidebar" aria-expanded="false">
    <i class="fas fa-bars" aria-hidden="true"></i><span>Menu</span>
  </button>

  <div class="topbar-head"><%- head %></div>

  <div class="navbar-right">
    <span class="topbar-date" title="Today in Philippine time"><%= phToday %></span>

    <div class="dropdown">
      <button type="button" class="navbar-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" id="notifDropdown"
              aria-label="Notifications<%= unreadNotifCount > 0 ? ', ' + unreadNotifCount + ' unread' : '' %>">
        <i class="fas fa-bell" aria-hidden="true"></i>
        <% if (unreadNotifCount > 0) { %>
          <span class="notif-badge" aria-hidden="true"><%= unreadNotifCount > 9 ? '9+' : unreadNotifCount %></span>
        <% } %>
      </button>
      <div class="dropdown-menu dropdown-menu-end notif-dropdown" aria-labelledby="notifDropdown">
        <div class="notif-header">
          <span>Notifications</span>
          <% if (unreadNotifCount > 0) { %>
            <span class="notif-count"><%= unreadNotifCount %> unread</span>
          <% } %>
        </div>
        <div class="notif-list">
          <% if (!recentNotifications || recentNotifications.length === 0) { %>
            <div class="notif-empty">You're all caught up.</div>
          <% } else { %>
            <% for (const n of recentNotifications) { %>
              <a href="<%= n.link || '/notifications' %>" class="notif-item <%= n.is_read ? '' : 'unread' %>">
                <div class="notif-icon notif-<%= n.type %>" aria-hidden="true">
                  <% if (n.type === 'reservation') { %><i class="fas fa-calendar-check"></i>
                  <% } else if (n.type === 'payment') { %><i class="fas fa-money-bill-wave"></i>
                  <% } else if (n.type === 'inventory') { %><i class="fas fa-triangle-exclamation"></i>
                  <% } else if (n.type === 'inquiry') { %><i class="fas fa-inbox"></i>
                  <% } else { %><i class="fas fa-bell"></i><% } %>
                </div>
                <div class="notif-text">
                  <div class="notif-title"><% if (!n.is_read) { %><span class="visually-hidden">Unread: </span><% } %><%= n.title %></div>
                  <div class="notif-msg"><%= n.message %></div>
                  <div class="notif-time"><%= formatDateTime(n.created_at) %></div>
                </div>
              </a>
            <% } %>
          <% } %>
        </div>
        <div class="notif-footer">
          <a href="/notifications">View all notifications</a>
        </div>
      </div>
    </div>

    <% if (currentUser) { %>
    <div class="dropdown">
      <button type="button" class="navbar-user-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu for <%= currentUser.firstName %>">
        <span class="user-avatar-sm" aria-hidden="true">
          <% if (currentUser.avatar) { %><img src="<%= currentUser.avatar %>" alt="" /><% } else { %><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %><% } %>
        </span>
        <i class="fas fa-chevron-down nav-caret" aria-hidden="true"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end account-menu">
        <li><h6 class="dropdown-header"><%= currentUser.firstName %> <%= currentUser.lastName %><span><%= currentUser.roleLabel %></span></h6></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/profile"><i class="fas fa-circle-user" aria-hidden="true"></i>My profile</a></li>
        <li><a class="dropdown-item" href="/notifications"><i class="fas fa-bell" aria-hidden="true"></i>All notifications</a></li>
        <li><a class="dropdown-item" href="/" ><i class="fas fa-house" aria-hidden="true"></i>View resort site</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/auth/logout"><i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>Log out</a></li>
      </ul>
    </div>
    <% } %>
  </div>
</header>
