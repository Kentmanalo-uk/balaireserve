<% if (pagination && pagination.totalPages > 1) { %>
<div class="pager">
  <div class="pager-meta">
    Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %>–<%= Math.min(pagination.page * pagination.limit, pagination.total) %> of <%= pagination.total %> records
  </div>
  <nav aria-label="Pages">
    <ul class="pagination mb-0">

      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?<%= new URLSearchParams({...filters, page: pagination.page - 1}).toString() %>" aria-label="Previous page"<%- pagination.page <= 1 ? ' tabindex="-1" aria-disabled="true"' : '' %>>
          <i class="fas fa-chevron-left" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">Previous</span>
        </a>
      </li>

      <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
        <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
          <a class="page-link" href="?<%= new URLSearchParams({...filters, page: p}).toString() %>" aria-label="Page <%= p %>"<%- p === pagination.page ? ' aria-current="page"' : '' %>><%= p %></a>
        </li>
      <% } %>

      <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?<%= new URLSearchParams({...filters, page: pagination.page + 1}).toString() %>" aria-label="Next page"<%- pagination.page >= pagination.totalPages ? ' tabindex="-1" aria-disabled="true"' : '' %>>
          <span class="d-none d-sm-inline me-1">Next</span><i class="fas fa-chevron-right" aria-hidden="true"></i>
        </a>
      </li>

    </ul>
  </nav>
</div>
<% } %>
