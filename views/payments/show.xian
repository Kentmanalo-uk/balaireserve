<% layout('layouts/main') %>
<%
  const METHOD_LABELS = { cash: 'Cash', gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank transfer', bank: 'Bank transfer', credit_card: 'Credit card', check: 'Check' };
  const methodLabel = (m) => METHOD_LABELS[m] || String(m || '—').replace(/_/g, ' ');
  const typeLabel   = (t) => { const s = String(t || '—').replace(/_/g, ' '); return s.charAt(0).toUpperCase() + s.slice(1); };
  const isAdmin     = currentUser && currentUser.role === 'admin';
  const isRefunded  = payment.status === 'refunded';
  // Guest-uploaded proofs are verified from the booking page, which also moves the
  // booking to Awaiting payment / Confirmed and notifies the guest.
  const isGuestProof = payment.submitted_by === 'customer';
%>
<div class="ap-page">

<!--page-head-->
<a href="/payments" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Payments</a>
<h1 class="ph-title">Payment <span class="pay-ref-title"><%= payment.reference_number %></span></h1>
<div class="ph-actions">
    <%- statusBadge(payment.status) %>
    <% if (payment.status === 'received' && isGuestProof) { %>
    <a href="/reservations/<%= payment.reservation_id %>#proofs" class="btn btn-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i>Review proof on booking</a>
    <% } else if (isAdmin && payment.status === 'received') { %>
    <form action="/payments/<%= payment.id %>/verify" method="POST" class="d-inline">
      <button type="submit" class="btn btn-primary"
        data-confirm="Verify <%= formatPeso(payment.amount) %> (<%= methodLabel(payment.payment_method) %>, ref <%= payment.reference_number %>) for <%= payment.booking_ref %>? The guest is notified that it was verified."
        data-confirm-title="Verify Payment"
        data-confirm-ok="Verify Payment">
        <i class="fas fa-check" aria-hidden="true"></i>Verify payment
      </button>
    </form>
    <% } %>
  </div>
<!--/page-head-->
<div class="page-meta"><%= typeLabel(payment.payment_type) %> · <%= methodLabel(payment.payment_method) %> · <%= formatDate(payment.payment_date) %> · for booking <a href="/reservations/<%= payment.reservation_id %>"><%= payment.booking_ref %></a></div>

<% if (payment.status === 'received') { %>
<div class="ap-notice" role="status">
  <i class="fas fa-hourglass-half" aria-hidden="true"></i>
  <% if (isGuestProof) { %>
  <span>The guest uploaded this proof and it is waiting for verification. Compare the screenshot with the <%= methodLabel(payment.payment_method) %> account, then verify or reject it on the <a href="/reservations/<%= payment.reservation_id %>#proofs">booking page</a> — that also updates the booking status and tells the guest.</span>
  <% } else { %>
  <span>This payment is recorded but not yet verified.<%= isAdmin ? ' Check the amount against the account statement, then verify it.' : ' An administrator needs to verify it.' %></span>
  <% } %>
</div>
<% } %>

<div class="ap-split">
  <div>
    <section class="ap-panel" aria-labelledby="payDetailHeading">
      <div class="ap-panel-head"><h2 id="payDetailHeading">Payment details</h2></div>
      <div class="ap-panel-body">
        <div class="pay-hero-amount">
          <span class="ap-meta"><%= isRefunded ? 'Refunded amount' : 'Amount' %></span>
          <span class="pay-amount pay-amount-lg <%= isRefunded ? 'is-refund' : '' %>"><%= isRefunded ? '−' : '' %><%= formatPeso(payment.amount) %></span>
        </div>
        <dl class="ap-dl">
          <dt>Reference</dt><dd><span class="ap-code"><%= payment.reference_number %></span></dd>
          <dt>Booking</dt><dd><a href="/reservations/<%= payment.reservation_id %>" class="ap-code"><%= payment.booking_ref %></a></dd>
          <dt>Customer</dt><dd><a href="/crm/customers/<%= payment.customer_id %>"><%= payment.customer_name %></a><% if (payment.customer_email) { %><span class="d-block ap-meta"><%= payment.customer_email %></span><% } %></dd>
          <dt>Method</dt><dd><%= methodLabel(payment.payment_method) %></dd>
          <dt>Type</dt><dd><%= typeLabel(payment.payment_type) %></dd>
          <dt>Payment date</dt><dd><%= formatDate(payment.payment_date) %></dd>
          <dt>Received by</dt><dd><%= paymentReceiver %></dd>
          <dt>Status</dt><dd><%- statusBadge(payment.status) %></dd>
          <dt>Recorded by</dt><dd><%= isGuestProof ? 'Guest (online proof upload)' : 'Staff' %></dd>
          <% if (payment.proof_image) { %><dt>Screenshot</dt><dd><a href="/portal/payment-proof/<%= payment.id %>" data-lightbox="/portal/payment-proof/<%= payment.id %>" data-lightbox-title="Payment proof — <%= payment.booking_ref %>" class="pay-proof-link"><img src="/portal/payment-proof/<%= payment.id %>" alt="Payment screenshot for <%= formatPeso(payment.amount) %>" loading="lazy" data-missing="Screenshot unavailable" class="pay-proof-thumb" /><span>View screenshot</span></a></dd><% } %>
          <% if (payment.notes) { %><dt>Notes</dt><dd class="pay-notes"><%= payment.notes %></dd><% } %>
        </dl>
      </div>
    </section>

    <section class="ap-panel" aria-labelledby="paySiblingsHeading">
      <div class="ap-panel-head">
        <h2 id="paySiblingsHeading">All payments for <a href="/reservations/<%= payment.reservation_id %>"><%= payment.booking_ref %></a></h2>
        <span class="ap-meta">Oldest first</span>
      </div>
      <div class="ap-table-wrap">
        <table class="table-br ap-table ap-stack">
          <thead><tr><th scope="col">Payment</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col" class="num">Amount</th></tr></thead>
          <tbody>
            <% for (const p of siblingPayments) { const refunded = p.status === 'refunded'; %>
            <tr class="<%= p.id === payment.id ? 'is-highlight' : '' %>">
              <td class="ap-cell-title"><a href="/payments/<%= p.id %>" class="ap-code ap-name" <%= p.id === payment.id ? 'aria-current="page"' : '' %>><%= p.reference_number %></a><span class="ap-line2"><%= typeLabel(p.payment_type) %> · <%= methodLabel(p.payment_method) %><%= p.id === payment.id ? ' · this payment' : '' %></span></td>
              <td data-label="Date" class="text-nowrap"><%= formatDate(p.payment_date) %></td>
              <td class="ap-cell-status"><%- statusBadge(p.status) %></td>
              <td class="num" data-label="Amount"><span class="pay-amount <%= refunded ? 'is-refund' : '' %>"><%= refunded ? '−' : '' %><%= formatPeso(p.amount) %></span></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="ap-panel-foot">
        <dl class="ap-amounts pay-ledger-foot">
          <div class="is-total"><dt>Net paid</dt><dd><%= formatPeso(netPaid) %></dd></div>
          <div><dt>Balance</dt><dd class="<%= balance > 0 ? 'text-danger' : '' %>"><%= formatPeso(balance) %></dd></div>
        </dl>
      </div>
    </section>
  </div>

  <aside>
    <section class="ap-panel" aria-labelledby="payResHeading">
      <div class="ap-panel-head"><h2 id="payResHeading">Booking balance</h2></div>
      <div class="ap-panel-body">
        <dl class="ap-amounts">
          <div><dt>Booking total</dt><dd><%= formatPeso(payment.res_total) %></dd></div>
          <div><dt>Net paid</dt><dd><%= formatPeso(netPaid) %></dd></div>
          <div class="is-total"><dt>Balance due</dt><dd class="<%= balance > 0 ? 'text-danger' : '' %>"><%= formatPeso(balance) %></dd></div>
        </dl>
        <dl class="ap-dl pay-status-dl">
          <dt>Booking status</dt><dd><%- statusBadge(payment.res_status) %></dd>
          <dt>Payment status</dt><dd><%- statusBadge(payment.res_payment_status) %></dd>
        </dl>
        <a href="/reservations/<%= payment.reservation_id %>" class="btn btn-outline-secondary w-100 mt-3">Open reservation</a>
      </div>
    </section>

    <% if (isAdmin && !isRefunded) { %>
    <section class="ap-panel" aria-labelledby="payRefundHeading">
      <div class="ap-panel-head"><h2 id="payRefundHeading">Process a refund</h2></div>
      <div class="ap-panel-body">
        <p class="ap-meta mb-3">Records money returned to the guest against this payment. Refunds can’t be undone — make sure it has been approved and paid out first.</p>
        <form action="/payments/<%= payment.id %>/refund" method="POST">
          <div class="mb-3">
            <label class="form-label required" for="refundAmount">Refund amount</label>
            <div class="input-group">
              <span class="input-group-text">₱</span>
              <input type="number" name="refund_amount" id="refundAmount" class="form-control"
                value="<%= payment.amount.toFixed(2) %>"
                min="0.01" max="<%= payment.amount %>" step="0.01" required aria-describedby="refundAmountHelp" />
            </div>
            <div class="form-text" id="refundAmountHelp">Up to <%= formatPeso(payment.amount) %>.</div>
          </div>
          <div class="mb-3">
            <label class="form-label required" for="refundReason">Reason</label>
            <textarea name="refund_reason" id="refundReason" class="form-control" rows="3"
              placeholder="e.g. Booking cancelled within the refund window" required></textarea>
          </div>
          <button type="submit" class="btn btn-outline-danger w-100" id="refundSubmit"
            data-confirm="Record a refund of <%= formatPeso(payment.amount) %> on <%= payment.booking_ref %>? The payment is marked refunded and the booking's paid amount drops. This cannot be undone."
            data-confirm-title="Process Refund"
            data-confirm-type="danger"
            data-confirm-ok="Process Refund">
            <i class="fas fa-undo" aria-hidden="true"></i>Record refund
          </button>
        </form>
      </div>
    </section>
    <% } %>

    <% if (isRefunded) { %>
    <div class="ap-notice is-muted" role="status">
      <i class="fas fa-undo" aria-hidden="true"></i>
      <span><strong>This payment has been refunded.</strong> A refund was processed for this transaction.</span>
    </div>
    <% } %>
  </aside>
</div>

</div>
<script>
// The refund confirmation states the amount actually typed.
(function () {
  var amt = document.getElementById('refundAmount'), btn = document.getElementById('refundSubmit');
  if (!amt || !btn) return;
  var ref = <%- JSON.stringify(payment.booking_ref) %>;
  function sync() {
    var v = Number(amt.value || 0);
    btn.dataset.confirm = 'Record a refund of ₱' + v.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' on ' + ref + '? The payment is marked refunded and the booking’s paid amount drops. This cannot be undone.';
  }
  amt.addEventListener('input', sync); sync();
})();
</script>
