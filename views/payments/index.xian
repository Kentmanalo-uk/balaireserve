<% layout('layouts/main') %>
<%
  const METHOD_LABELS = { cash: 'Cash', gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank transfer', bank: 'Bank transfer', credit_card: 'Credit card', check: 'Check' };
  const methodLabel = (m) => METHOD_LABELS[m] || String(m || '—').replace(/_/g, ' ');
  const typeLabel   = (t) => { const s = String(t || '—').replace(/_/g, ' '); return s.charAt(0).toUpperCase() + s.slice(1); };
  const filtered    = !!(filters.search || filters.method || filters.status || filters.from || filters.to);
  const isAdmin     = currentUser && currentUser.role === 'admin';
  // Review queue: guest-submitted proofs on this page that are not yet verified or rejected
  // (cash taken at the desk stays in the ledger below).
  const toReview    = (payments || []).filter(p => p.status === 'received' && p.payment_type !== 'refund' && p.submitted_by === 'customer');
  const mismatchOf  = (n) => { const m = /NOTE:\s*(screenshot amount[^.?]*)/i.exec(n || ''); return m ? m[1].replace(/^screenshot amount/i, 'amount read from the screenshot') : ''; };
  const views = [['received', 'To review'], ['', 'All payments'], ['verified', 'Verified'], ['refunded', 'Refunded']];
  const viewHref = (st) => '/payments?' + new URLSearchParams(Object.fromEntries(Object.entries({ ...filters, status: st }).filter(([, v]) => v))).toString();
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Payments</h1>
<div class="ph-actions">
    <a href="/payments/refunds/requests" class="btn btn-outline-secondary">Refund requests</a>
    <a href="/reports/export/sales" class="btn btn-outline-secondary"><i class="fas fa-download" aria-hidden="true"></i>Export CSV</a>
  </div>
<!--/page-head-->

<nav class="quick-filters" aria-label="Show payments">
  <% for (const [st, label] of views) { const on = (filters.status || '') === st; %>
  <a href="<%= viewHref(st) %>" class="qf<%= on ? ' is-on' : '' %>"<%- on ? ' aria-current="true"' : '' %>><%= label %></a>
  <% } %>
</nav>

<% if (toReview.length) { %>
<section class="review-queue" aria-labelledby="queueTitle">
  <div class="rq-head">
    <h2 id="queueTitle">Waiting for review <span class="rq-count"><%= toReview.length %></span></h2>
    <p>Compare each screenshot with the GCash, Maya or bank record before verifying. Automatic screenshot reading is only a hint.</p>
  </div>
  <ul class="rq-list">
    <% for (const p of toReview) { const guestProof = p.submitted_by === 'customer'; const mism = mismatchOf(p.notes); %>
    <li class="rq-item<%= mism ? ' has-warning' : '' %>">
      <div class="rq-proof">
        <% if (p.proof_image) { %>
        <a href="/portal/payment-proof/<%= p.id %>" class="rq-thumb" data-lightbox="/portal/payment-proof/<%= p.id %>" data-lightbox-title="Payment proof — <%= p.booking_ref %>">
          <img src="/portal/payment-proof/<%= p.id %>" alt="Payment screenshot for <%= p.booking_ref %>, <%= formatPeso(p.amount) %>" loading="lazy" />
          <span><i class="fas fa-magnifying-glass-plus" aria-hidden="true"></i> Enlarge</span>
        </a>
        <% } else { %>
        <div class="rq-thumb is-empty"><i class="fas fa-receipt" aria-hidden="true"></i><span><%= guestProof ? 'No screenshot' : 'Recorded at the desk' %></span></div>
        <% } %>
      </div>
      <div class="rq-body">
        <div class="rq-amount"><%= formatPeso(p.amount) %> <span><%= methodLabel(p.payment_method) %> · <%= typeLabel(p.payment_type) %></span></div>
        <dl class="rq-facts">
          <div><dt>Reference</dt><dd class="ap-code"><%= p.reference_number || '—' %></dd></div>
          <div><dt>Booking</dt><dd><a href="/reservations/<%= p.reservation_id %>" class="ap-code"><%= p.booking_ref %></a> · <%= p.customer_name %></dd></div>
          <div><dt>Submitted</dt><dd><%= guestProof ? 'by the guest' : 'by ' + (p.received_by_name || 'staff') %>, <%= formatDateTime(p.created_at) %></dd></div>
        </dl>
        <% if (mism) { %>
        <div class="ocr-warn" role="note"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><span><strong>Check the amount:</strong> the <%= mism %>. Automatic reading can be wrong — compare with the screenshot.</span></div>
        <% } %>
        <div class="rq-actions">
          <% if (guestProof) { %>
          <form action="/reservations/<%= p.reservation_id %>/verify-payment/<%= p.id %>" method="POST">
            <input type="hidden" name="action" value="verify" />
            <button type="submit" class="btn btn-primary"
              data-confirm="Verify <%= formatPeso(p.amount) %> (ref <%= p.reference_number || 'none' %>) for <%= p.booking_ref %>? Only verify after matching the screenshot with the GCash, Maya or bank record. The balance and booking status update and the guest is notified."
              data-confirm-title="Verify payment" data-confirm-ok="Verify payment"><i class="fas fa-check" aria-hidden="true"></i> Verify</button>
          </form>
          <details class="proof-reject">
            <summary class="btn btn-outline-danger"><i class="fas fa-xmark" aria-hidden="true"></i> Reject…</summary>
            <form action="/reservations/<%= p.reservation_id %>/verify-payment/<%= p.id %>" method="POST" class="proof-reject-form">
              <input type="hidden" name="action" value="reject" />
              <label class="form-label" for="rqReason<%= p.id %>">Reason for the guest <span class="label-opt">optional</span></label>
              <textarea name="reason" id="rqReason<%= p.id %>" class="form-control" rows="2" maxlength="300" aria-describedby="rqReasonHelp<%= p.id %>"></textarea>
              <div class="form-text" id="rqReasonHelp<%= p.id %>">Shown to the guest, e.g. the amount doesn't match or the screenshot is unreadable.</div>
              <button type="submit" class="btn btn-danger mt-2"
                data-confirm="Reject this <%= formatPeso(p.amount) %> proof for <%= p.booking_ref %>? It stops counting toward the balance and the guest is asked to submit a new one."
                data-confirm-title="Reject payment proof" data-confirm-type="danger" data-confirm-ok="Reject proof">Reject proof</button>
            </form>
          </details>
          <% } %>
          <a href="/reservations/<%= p.reservation_id %>#proofs" class="btn btn-secondary-quiet">Open booking</a>
        </div>
      </div>
    </li>
    <% } %>
  </ul>
</section>
<% } else if (filters.status === 'received') { %>
<div class="ap-empty rq-clear"><strong>Nothing waiting for review.</strong>New guest payment proofs will appear here as they are submitted.</div>
<% } %>

<div class="ap-kpis" aria-label="Payment totals">
  <div class="ap-kpi"><span class="ap-kpi-label">Collected, all time</span><span class="ap-kpi-value"><%= formatPeso(totalCollected) %></span><span class="ap-kpi-note">Received and verified</span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Transactions</span><span class="ap-kpi-value"><%= summary.txn_count %></span><span class="ap-kpi-note"><%= filtered ? 'Matching filters' : 'All records' %></span></div>
  <% if (filtered) { %><div class="ap-kpi is-good"><span class="ap-kpi-label">Collected</span><span class="ap-kpi-value"><%= formatPeso(summary.collected) %></span><span class="ap-kpi-note">Matching filters</span></div><% } %>
  <div class="ap-kpi <%= summary.refunded > 0 ? 'is-bad' : '' %>"><span class="ap-kpi-label">Refunded</span><span class="ap-kpi-value"><%= formatPeso(summary.refunded) %></span><span class="ap-kpi-note"><%= filtered ? 'Matching filters' : 'All records' %></span></div>
</div>

<form method="GET" action="/payments" class="ap-toolbar" role="search" aria-label="Filter payments">
  <div class="ap-field ap-field-search">
    <label for="paySearch">Search</label>
    <div class="ap-search"><i class="fas fa-search" aria-hidden="true"></i><input type="text" id="paySearch" name="search" value="<%= filters.search %>" class="form-control" placeholder="Ref #, booking ref or customer" /></div>
  </div>
  <div class="ap-field">
    <label for="payMethod">Method</label>
    <select id="payMethod" name="method" class="form-select">
      <option value="">All methods</option>
      <% for (const m of methods) { %><option value="<%= m %>" <%= filters.method === m ? 'selected' : '' %>><%= methodLabel(m) %></option><% } %>
    </select>
  </div>
  <div class="ap-field">
    <label for="payStatus">Status</label>
    <select id="payStatus" name="status" class="form-select">
      <option value="">All statuses</option>
      <% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% } %>
    </select>
  </div>
  <div class="ap-field pay-date">
    <label for="payFrom">From</label>
    <input type="date" id="payFrom" name="from" value="<%= filters.from %>" class="form-control" />
  </div>
  <div class="ap-field pay-date">
    <label for="payTo">To</label>
    <input type="date" id="payTo" name="to" value="<%= filters.to %>" class="form-control" />
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filtered) { %><a href="/payments" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="payLedgerHeading">
  <div class="ap-panel-head">
    <h2 id="payLedgerHeading">Ledger <span class="ap-meta"><%= pagination.total %> record<%= pagination.total === 1 ? '' : 's' %></span></h2>
    <span class="ap-meta">Newest first</span>
  </div>
  <% if (!payments || payments.length === 0) { %>
  <div class="ap-empty">
    <strong><%= filtered ? 'No payments match these filters' : 'No payments recorded yet' %></strong>
    <%= filtered ? 'Try a wider date range or clear the filters.' : 'Payments appear here once a booking is paid at the desk or a guest’s proof is recorded.' %>
    <% if (filtered) { %><div><a href="/payments" class="btn btn-outline-secondary btn-sm">Clear filters</a></div><% } %>
  </div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack pay-ledger">
      <thead>
        <tr>
          <th scope="col">Payment</th>
          <th scope="col">Date</th>
          <th scope="col">Booking</th>
          <th scope="col" class="pay-col-by">Received by</th>
          <th scope="col">Status</th>
          <th scope="col" class="num">Amount</th>
          <th scope="col" class="text-end"><span class="br-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const p of payments) { const refunded = p.payment_type === 'refund'; %>
        <tr class="<%= refunded ? 'pay-row-refund' : '' %>" data-href="/payments/<%= p.id %>">
          <td class="ap-cell-title"><a href="/payments/<%= p.id %>" class="ap-name ap-code pay-ref"><%= p.reference_number %></a><span class="ap-line2"><%= typeLabel(p.payment_type) %> · <%= methodLabel(p.payment_method) %></span></td>
          <td data-label="Date" class="text-nowrap"><%= formatDate(p.payment_date) %></td>
          <td data-label="Booking"><a href="/reservations/<%= p.reservation_id %>" class="ap-code"><%= p.booking_ref %></a><span class="ap-line2"><%= p.customer_name %></span></td>
          <td data-label="Received by" class="ap-hide-sm ap-muted pay-col-by"><%= p.received_by_name || '—' %></td>
          <td class="ap-cell-status"><%- statusBadge(p.status) %></td>
          <td class="num" data-label="Amount"><span class="pay-amount <%= refunded ? 'is-refund' : '' %>"><%= refunded ? '−' : '' %><%= formatPeso(p.amount) %></span></td>
          <td class="ap-row-actions"><div class="ap-actions"><a href="/payments/<%= p.id %>" class="ap-act">View<span class="br-sr-only"> payment <%= p.reference_number %></span></a></div></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
  <% if (pagination && pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
</section>

</div>
