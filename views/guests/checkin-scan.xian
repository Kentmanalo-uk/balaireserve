<% layout('layouts/minimal') %>
<%
  const stay = reservation.check_in_date
    ? formatDate(reservation.check_in_date) + (reservation.check_out_date && String(reservation.check_out_date) !== String(reservation.check_in_date) ? ' – ' + formatDate(reservation.check_out_date) : '')
    : (reservation.event_date ? formatDate(reservation.event_date) : '—');
  const times = [reservation.start_time, reservation.end_time].filter(Boolean).join(' – ');
%>
<section class="checkin-sheet" aria-labelledby="ckTitle">
  <div class="ck-state is-info"><i class="fas fa-qrcode" aria-hidden="true"></i>Valid booking QR</div>
  <h1 id="ckTitle">QR check-in</h1>
  <% if (isStaff) { %>
  <p class="ck-lead">Confirm the guest in front of you matches this booking, then check them in.</p>
  <% } else { %>
  <p class="ck-lead">This QR code is valid. Only resort staff can confirm a check-in.</p>
  <% } %>

  <dl>
    <dt>Booking</dt><dd class="tnum"><%= reservation.booking_ref %></dd>
    <dt>Guest</dt><dd><%= reservation.first_name %> <%= reservation.last_name %></dd>
    <% if (isStaff && reservation.phone) { %><dt>Mobile</dt><dd class="tnum"><%= reservation.phone %></dd><% } %>
    <dt>Stay</dt><dd><%= stay %><% if (times) { %><span class="d-block small text-muted fw-normal"><%= times %></span><% } %></dd>
    <% if (isStaff) { %><dt>Status</dt><dd><%- statusBadge(reservation.status) %> <%- statusBadge(reservation.payment_status) %></dd><% } %>
  </dl>

  <% if (isStaff) { %>
  <form action="/checkin/<%= token %>" method="POST" class="d-grid" onsubmit="var b=this.querySelector('button');b.disabled=true;b.setAttribute('aria-busy','true');">
    <button type="submit" class="btn btn-primary btn-lg">
      <i class="fas fa-check me-2" aria-hidden="true"></i>Confirm Check-in
    </button>
  </form>
  <div class="d-grid mt-2"><a href="/reservations/<%= reservation.id %>" class="btn btn-outline-secondary">View reservation details</a></div>
  <% if (reservation.payment_status !== 'fully_paid' && reservation.payment_status !== 'refunded') { %>
  <p class="ck-note mb-0"><i class="fas fa-circle-info me-1" aria-hidden="true"></i>This booking still has a balance. It can be collected from the reservation page before check-out.</p>
  <% } %>
  <% } else if (isLoggedIn) { %>
  <p class="mb-0">Please show this QR code to our front desk staff so they can check you in.</p>
  <% } else { %>
  <p class="small text-muted">Guests: show this QR code at the front desk.</p>
  <div class="d-grid">
    <a href="/checkin/<%= token %>/staff" class="btn btn-primary btn-lg">
      <i class="fas fa-right-to-bracket me-2" aria-hidden="true"></i>Staff: sign in to check this guest in
    </a>
  </div>
  <% } %>
</section>
