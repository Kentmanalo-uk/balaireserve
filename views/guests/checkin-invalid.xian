<% layout('layouts/minimal') %>
<% const staffViewer = typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff'); %>
<section class="checkin-sheet" aria-labelledby="ckTitle">
  <div class="ck-state is-invalid"><i class="fas fa-circle-xmark" aria-hidden="true"></i>QR code not accepted</div>
  <h1 id="ckTitle">This QR code can't be used</h1>
  <p class="ck-lead"><%= reason || 'This QR code is not valid or has already been used.' %></p>
  <% if (staffViewer) { %>
  <p class="small text-muted mb-4">Each booking QR works once and expires after the stay. You can still find the booking by its reference and manage it from the reservation page.</p>
  <div class="d-grid gap-2">
    <a href="/reservations" class="btn btn-primary btn-lg">Find the booking</a>
    <a href="/dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
  </div>
  <% } else { %>
  <p class="small text-muted mb-4">Each booking QR works once and expires after the stay. Please speak to the front desk — they can find your booking by its reference.</p>
  <div class="d-grid gap-2">
    <a href="<%= currentUser ? '/portal/my-reservations' : '/' %>" class="btn btn-primary btn-lg"><%= currentUser ? 'My reservations' : 'Back to the resort site' %></a>
  </div>
  <% } %>
</section>
