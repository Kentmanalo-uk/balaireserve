<% layout('layouts/minimal') %>
<section class="checkin-sheet" aria-labelledby="ckTitle" role="status">
  <div class="ck-state is-ok"><i class="fas fa-circle-check" aria-hidden="true"></i>Guest checked in</div>
  <h1 id="ckTitle">Check-in Successful!</h1>
  <p class="ck-lead">Booking <strong class="tnum"><%= bookingRef %></strong> is now checked in. Its room, cottage or venue is marked occupied and the guest has been notified.</p>
  <div class="d-grid gap-2">
    <a href="/reservations/<%= reservationId %>" class="btn btn-primary btn-lg">Open reservation</a>
    <a href="/dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
  </div>
  <p class="ck-note mb-0">This QR code has now been used and won't work again.</p>
</section>
