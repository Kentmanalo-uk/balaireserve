<% layout('layouts/main') %>
<% const typeLabel = t => ({ room:'Room', cottage:'Cottage', venue:'Venue', event:'Event' })[t] || String(t || '—').replace(/_/g, ' '); %>
<!--page-head-->
<a href="/guests" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Guests</a>
<h1 class="ph-title"><%= guest.first_name %> <%= guest.last_name %></h1>
<div class="ph-actions">
    <a href="/reservations/<%= guest.reservation_id %>" class="btn btn-primary">Open reservation</a>
  </div>
<!--/page-head-->
<div class="page-meta">Guest status <%- statusBadge(guest.status) %> · Booking <a href="/reservations/<%= guest.reservation_id %>" class="ref"><%= guest.booking_ref %></a></div>

<div class="ws-grid">
  <div class="ws-main">
    <section class="ws-section" aria-labelledby="gInfo">
      <header><h2 id="gInfo">Stay details</h2></header>
      <div class="ws-body">
        <dl class="facts">
          <div><dt>Email</dt><dd><%= guest.email || '—' %></dd></div>
          <div><dt>Mobile</dt><dd><%= guest.phone || '—' %></dd></div>
          <div><dt>Guests in party</dt><dd><%= guest.num_guests %></dd></div>
          <div><dt>Check-in</dt><dd><%= formatDate(guest.check_in_date, 'ddd, MMM D, YYYY') %></dd></div>
          <div><dt>Check-out</dt><dd><%= formatDate(guest.check_out_date, 'ddd, MMM D, YYYY') %></dd></div>
          <div><dt>Booking total</dt><dd class="fw-semibold tnum"><%= formatPeso(guest.total_amount) %></dd></div>
        </dl>
      </div>
    </section>

    <section class="ws-section" aria-labelledby="gHist">
      <header><h2 id="gHist">Booking history</h2><span class="small text-muted"><%= history.length %> booking<%= history.length === 1 ? '' : 's' %></span></header>
      <div class="table-responsive">
        <table class="table table-br table-hover table-stack mb-0">
          <thead><tr><th>Booking</th><th>Type</th><th>Date</th><th class="num">Amount</th><th>Status</th></tr></thead>
          <tbody>
            <% if (!history.length) { %>
            <tr><td colspan="5" class="empty-cell text-center text-muted py-3">No bookings found.</td></tr>
            <% } %>
            <% for (const h of history) { %>
            <tr>
              <td data-cell="primary"><a href="/reservations/<%= h.id %>" class="ref"><%= h.booking_ref %></a></td>
              <td data-cell="main" class="cell-meta"><%= typeLabel(h.reservation_type) %></td>
              <td data-cell="main" class="cell-meta"><%= formatDate(h.check_in_date || h.event_date) %></td>
              <td data-cell="amount" class="num"><%= formatPeso(h.total_amount) %></td>
              <td data-cell="status"><%- statusBadge(h.status) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="ws-side" aria-label="Check-in and check-out">
    <section class="ws-section" aria-labelledby="gCk">
      <header><h2 id="gCk">Check-in / check-out</h2></header>
      <div class="action-block">
        <% if (checkIn) { %>
        <div class="d-flex gap-2 mb-2"><i class="fas fa-right-to-bracket text-success mt-1" aria-hidden="true"></i><div><strong>Checked in</strong><span class="cell-sub"><%= formatDateTime(checkIn.checked_in_at) %> · <%= checkIn.method === 'qr' ? 'QR scan' : checkIn.method %></span></div></div>
        <% } else { %>
        <p class="mb-2">Not checked in yet. Scan the guest's booking QR code to check them in.</p>
        <% } %>
        <% if (checkOut) { %>
        <div class="d-flex gap-2"><i class="fas fa-right-from-bracket text-muted mt-1" aria-hidden="true"></i><div><strong>Checked out</strong><span class="cell-sub"><%= formatDateTime(checkOut.checked_out_at) %></span></div></div>
        <% } else if (checkIn) { %>
        <p class="mb-0">Check the guest out from the <a href="/reservations/<%= guest.reservation_id %>#guestPanel">reservation page</a>, after any balance is collected.</p>
        <% } %>
      </div>
    </section>
  </aside>
</div>
