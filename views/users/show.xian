<% layout('layouts/main') %>
<% const fullName = user.first_name + ' ' + user.last_name; %>
<div class="ap-page">

<!--page-head-->
<a href="/users" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Users</a>
<h1 class="ph-title"><%= fullName %></h1>
<div class="ph-actions">
    <a href="/users/<%= user.id %>/edit" class="btn btn-outline-secondary"><i class="fas fa-pen" aria-hidden="true"></i>Edit details</a>
    <% if (user.id !== currentUser.id) { %>
    <form action="/users/<%= user.id %>/toggle" method="POST" class="d-inline">
      <button type="submit" class="btn <%= user.is_active ? 'btn-outline-danger' : 'btn-outline-primary' %>"
        data-confirm="<%= user.is_active ? 'Deactivate' : 'Activate' %> the account for <%= fullName %>?<%= user.is_active ? ' They will no longer be able to log in.' : ' They will regain login access.' %>"
        data-confirm-title="<%= user.is_active ? 'Deactivate User' : 'Activate User' %>"
        data-confirm-type="<%= user.is_active ? 'danger' : 'primary' %>"
        data-confirm-ok="<%= user.is_active ? 'Deactivate' : 'Activate' %>">
        <%= user.is_active ? 'Deactivate account' : 'Activate account' %>
      </button>
    </form>
    <% } %>
  </div>
<!--/page-head-->
<div class="page-meta"><%= user.role_label %> · <% if (user.is_active) { %><span class="status-chip st-teal">Active</span><% } else { %><span class="status-chip st-gray">Inactive</span><% } %></div>

<div class="ap-split usr-split">
  <section class="ap-panel" aria-labelledby="usrActivityHeading">
    <div class="ap-panel-head"><h2 id="usrActivityHeading">Recent activity</h2><span class="ap-meta">Latest 10 entries from the audit log</span></div>
    <% if (!recentAudit || recentAudit.length === 0) { %>
    <div class="ap-empty"><strong>No activity recorded yet</strong>Changes this person makes will appear here.</div>
    <% } else { %>
    <ol class="ap-history">
      <% for (const log of recentAudit) { %>
      <li>
        <time datetime="<%= log.created_at %>"><%= formatDateTime(log.created_at) %></time>
        <div>
          <div class="ap-history-title text-capitalize"><%= log.action.replace(/_/g,' ') %></div>
          <div class="ap-history-by text-capitalize"><%= log.module %></div>
        </div>
      </li>
      <% } %>
    </ol>
    <% } %>
  </section>

  <aside class="ap-panel" aria-labelledby="usrDetailsHeading">
    <div class="ap-panel-head"><h2 id="usrDetailsHeading">Account</h2></div>
    <div class="ap-panel-body">
      <dl class="ap-dl">
        <dt>Email</dt><dd><a href="mailto:<%= user.email %>"><%= user.email %></a></dd>
        <dt>Phone</dt><dd><%= user.phone || '—' %></dd>
        <dt>Role</dt><dd><%= user.role_label %></dd>
        <dt>Last sign-in</dt><dd><%= user.last_login ? formatDateTime(user.last_login) : 'Never' %></dd>
        <dt>Created</dt><dd><%= formatDate(user.created_at) %></dd>
      </dl>
    </div>
  </aside>
</div>

</div>
