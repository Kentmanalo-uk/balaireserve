<% layout('layouts/portal') %>
<%
  const typeName = { payment: 'Payment', reservation: 'Booking', inquiry: 'Message' };
  const typeIcon = { payment: 'fa-wallet', reservation: 'fa-calendar-check', inquiry: 'fa-comment-dots' };
  const list = notifications || [];
  const unreadCount = list.filter(n => !n.is_read).length;
  // DB timestamps are UTC ('YYYY-MM-DD HH:MM:SS'); group and label them in Philippine time.
  const msOf = (s) => { const ms = Date.parse(String(s || '').replace(' ', 'T') + (/[zZ]|[+-]\d\d:?\d\d$/.test(String(s)) ? '' : 'Z')); return isNaN(ms) ? 0 : ms; };
  const now = Date.now();
  const phDay = (ms) => new Date(ms + 8 * 3600e3).toISOString().slice(0, 10);
  const today = phDay(now), yesterday = phDay(now - 864e5);
  const ago = (ms) => {
    const m = Math.round((now - ms) / 60000);
    if (m < 1) return 'Just now';
    if (m < 60) return m + ' min ago';
    const h = Math.round(m / 60);
    if (h < 24) return h + ' hour' + (h === 1 ? '' : 's') + ' ago';
    const d = Math.round(h / 24);
    return d < 7 ? d + ' day' + (d === 1 ? '' : 's') + ' ago' : '';
  };
  const groupOf = (ms) => { const d = phDay(ms); if (d === today) return 'Today'; if (d === yesterday) return 'Yesterday'; if (now - ms < 7 * 864e5) return 'Earlier this week'; return 'Older'; };
  const groups = [];
  for (const n of list) {
    const ms = msOf(n.created_at), g = groupOf(ms);
    let grp = groups.find(x => x.title === g);
    if (!grp) { grp = { title: g, items: [] }; groups.push(grp); }
    grp.items.push(Object.assign({ ms }, n));
  }
  const goLabel = (link) => !link ? '' : /my-reservations\//.test(link) ? 'View booking' : /inquir/.test(link) ? 'Read the reply' : 'Open';
%>
<div class="pt-page pt-page--narrow">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">Notifications</h1>
      <p class="pt-lede"><% if (unreadCount) { %><strong><%= unreadCount %> new</strong> · <% } %>Updates about your bookings, payments and messages. Opening this page marks them as read.</p>
    </div>
    <% if (list.length > 0) { %>
    <form action="/portal/notifications/clear" method="POST">
      <button type="submit" class="btn btn-secondary-quiet"
        data-confirm="Clear all read notifications? This removes them from this list and cannot be undone. Your bookings and messages are not affected."
        data-confirm-title="Clear read notifications"
        data-confirm-ok="Clear">
        <i class="far fa-trash-can" aria-hidden="true"></i>Clear read
      </button>
    </form>
    <% } %>
  </div>

  <% if (list.length === 0) { %>
  <div class="hm-empty">
    <div class="hm-empty-text">
      <h2 class="hm-empty-title">You’re all caught up</h2>
      <p>Booking, payment and message updates appear here — for example when staff verify your payment or reply to a question.</p>
      <a href="/portal/my-reservations" class="btn btn-secondary-quiet">Go to my reservations</a>
    </div>
  </div>
  <% } else { %>
    <% for (const g of groups) { const gid = g.title.toLowerCase().replace(/\W+/g, '-'); %>
    <section class="pn-group" aria-labelledby="pn-<%= gid %>">
      <h2 class="pn-group-title" id="pn-<%= gid %>"><%= g.title %></h2>
      <ul class="pn-list">
        <% for (const n of g.items) { const a = ago(n.ms); %>
        <li>
          <<%= n.link ? 'a' : 'div' %> <% if (n.link) { %>href="<%= n.link %>"<% } %> class="pn-row <%= n.is_read ? '' : 'is-unread' %>">
            <span class="pn-icon pn-icon--<%= n.type %>" aria-hidden="true"><i class="fas <%= typeIcon[n.type] || 'fa-bell' %>"></i></span>
            <div class="pn-body">
              <div class="pn-title"><% if (!n.is_read) { %><span class="pn-new">New</span><% } %><span><%= n.title %></span></div>
              <div class="pn-msg"><%= n.message %></div>
              <div class="pn-time"><%= typeName[n.type] || 'Update' %> · <time datetime="<%= n.created_at %>" title="<%= formatDateTime(n.created_at) %>"><%= a ? a + ' · ' : '' %><%= formatDateTime(n.created_at, a ? 'h:mm A' : 'MMM D, YYYY · h:mm A') %></time></div>
            </div>
            <% if (n.link) { %><span class="pn-go"><span class="pn-go-label"><%= goLabel(n.link) %></span><i class="fas fa-chevron-right" aria-hidden="true"></i></span><% } %>
          </<%= n.link ? 'a' : 'div' %>>
        </li>
        <% } %>
      </ul>
    </section>
    <% } %>
    <p class="pt-meta mt-3 mb-0">Times are Philippine time. The latest 100 notifications are shown.</p>
  <% } %>
</div>
