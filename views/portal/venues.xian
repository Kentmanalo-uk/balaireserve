<% layout('layouts/portal') %>
<%
  const titleCase = (s) => String(s || '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  const showTypeFilter = venueTypes && venueTypes.length > 1;
  const cols = showTypeFilter ? 4 : 3;
  const fmtT = t => { const m = /^(\d{1,2}):(\d{2})/.exec(String(t || '')); if (!m) return ''; const h = +m[1]; return (h % 12 || 12) + ':' + m[2] + ' ' + (h >= 12 ? 'PM' : 'AM'); };
  const hasTimes = !!(filters.start_time && filters.end_time);
  const carry = new URLSearchParams();
  if (filters.date) carry.set('date', filters.date);
  if (filters.date && hasTimes) { carry.set('start_time', filters.start_time); carry.set('end_time', filters.end_time); }
  if (filters.guests) carry.set('guests', filters.guests);
  const qs = carry.toString() ? '?' + carry.toString() : '';
  const when = filters.date ? formatDate(filters.date, 'ddd, MMM D') + (hasTimes ? ', ' + fmtT(filters.start_time) + ' – ' + fmtT(filters.end_time) : '') : '';
  // Packages that fit the searched guest count.
  const shownPackages = (packages || []).filter(p => !filters.guests || !p.capacity || Number(p.capacity) >= Number(filters.guests));
%>

<div class="pt-page">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">Venues &amp; event packages</h1>
      <p class="pt-lede">Book the function hall on its own, or choose an event package. Both are one price per booking, with a <%= downpaymentPercent %>% downpayment paid online.</p>
    </div>
  </div>

  <%include('portal/_catalog-tabs')%>

  <form method="GET" action="/portal/venues" class="cat-filters" style="--cat-cols:<%= cols %>;" aria-label="Check venue availability">
    <div>
      <label class="form-label" for="fDate">Event date</label>
      <input type="date" id="fDate" name="date" value="<%= filters.date %>" class="form-control" />
    </div>
    <div>
      <label class="form-label" for="fGuests">Guests</label>
      <input type="number" id="fGuests" name="guests" value="<%= filters.guests %>" class="form-control" min="1" inputmode="numeric" placeholder="Any" />
    </div>
    <% if (showTypeFilter) { %>
    <div>
      <label class="form-label" for="fType">Venue type</label>
      <select id="fType" name="type" class="form-select">
        <option value="">All types</option>
        <% for (const t of venueTypes) { %>
        <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= titleCase(t) %></option>
        <% } %>
      </select>
    </div>
    <% } else if (filters.type) { %><input type="hidden" name="type" value="<%= filters.type %>" /><% } %>
    <div>
      <label class="form-label" for="fSort">Sort by price</label>
      <select id="fSort" name="sort" class="form-select">
        <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Lowest first</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Highest first</option>
      </select>
    </div>
    <% if (hasTimes) { %><input type="hidden" name="start_time" value="<%= filters.start_time %>" /><input type="hidden" name="end_time" value="<%= filters.end_time %>" /><% } %>
    <div class="cat-filters-actions">
      <button type="submit" class="btn btn-primary">Check availability</button>
      <% if (filters.date || filters.guests || filters.type) { %><a href="/portal/venues" class="btn btn-outline-secondary">Clear</a><% } %>
    </div>
  </form>

  <section aria-labelledby="venuesHeading">
    <h2 class="br-sr-only" id="venuesHeading">Venues</h2>
    <p class="cat-result" role="status">
      <%= venues.length %> venue<%= venues.length !== 1 ? 's' : '' %><% if (filters.guests) { %> for <%= filters.guests %>+ guests<% } %><% if (when) { %> · availability for <%= when %><% } else { %> · add a date to see if it's free<% } %>
    </p>

    <% if (!venues || venues.length === 0) { %>
    <div class="pt-surface pt-empty">
      <h2>No venues match this search</h2>
      <p>Try fewer guests or another date.</p>
      <a href="/portal/venues" class="btn btn-outline-secondary">Show all venues</a>
    </div>
    <% } else { %>
    <div class="lst-list">
      <% for (const v of venues) { %>
      <%
        const book = new URLSearchParams({ type: 'venue', item_id: String(v.id) });
        if (filters.date) book.set('date', filters.date);
        if (filters.date && hasTimes) { book.set('start_time', filters.start_time); book.set('end_time', filters.end_time); }
        const note = v.adminOnly ? 'Reserved through the resort' : v.isAvailable ? (when ? 'Open on ' + when : '') : (filters.date ? 'Booked ' + (hasTimes ? 'at that time' : 'on this date') : 'Not taking bookings right now');
      %>
      <%include('partials/listing-card', Object.assign({}, __locals, { card: {
        row: v, kind: 'venue', variant: 'row', h: 'h3', qs: qs,
        avail: filters.date || !v.isAvailable ? v.isAvailable : undefined, availNote: note,
        bookHref: '/portal/book?' + book.toString(), dp: downpaymentPercent
      } }))%>
      <% if (v.price_note) { %><p class="cat-result"><%= v.price_note %></p><% } %>
      <% } %>
    </div>
    <% } %>
  </section>

  <% if (shownPackages.length > 0) { %>
  <section class="pt-section" id="packages" aria-labelledby="packagesHeading" tabindex="-1">
    <div class="pt-section-head">
      <h2 class="pt-h2" id="packagesHeading">Event packages</h2>
      <p class="pt-meta mb-0">One price per package, including the items listed. Optional add-ons are added to your total and downpayment when you choose them in the booking form.</p>
    </div>
    <%include('partials/package-rows', Object.assign({}, __locals, { pkgRows: { list: shownPackages, dp: downpaymentPercent, date: filters.date, h: 'h3', book: true } }))%>
  </section>
  <% } %>
</div>

<%include('portal/_lightbox')%>

<script>
(function () {
  var now = new Date();
  var today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  var d = document.getElementById('fDate');
  if (d) d.min = today;
})();
</script>
