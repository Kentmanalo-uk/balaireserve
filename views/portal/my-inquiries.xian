<% layout('layouts/portal') %>
<%
  const topic = (c) => ({ general: 'General question', room: 'Rooms and stays', venue: 'Venue and events', pricing: 'Prices and packages', complaint: 'Complaint', other: 'Other' })[c || 'general'] || String(c).replace(/_/g, ' ');
  const list = inquiries || [];
  const links = (typeof bookingLinks !== 'undefined' && bookingLinks) || {};
  const answered = list.filter(q => q.resolution).length;
  const waiting = list.length - answered;
  // Booking references the guest mentioned that belong to them → link to that booking.
  const refsIn = (q) => { const found = String((q.subject || '') + ' ' + (q.message || '')).match(/BK-\d{4}-\d{3,}/g) || []; return [...new Set(found)].filter(r => links[r]); };
  const when = (s) => s ? formatDateTime(s, 'MMM D, YYYY · h:mm A') : '';
%>
<div class="pt-page pt-page--narrow">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">My inquiries</h1>
      <p class="pt-lede"><% if (list.length) { %><%= answered %> replied<% if (waiting) { %> · <%= waiting %> awaiting a reply<% } %>. <% } %>Messages you’ve sent the resort and their replies. You also get a notification when staff reply.</p>
    </div>
    <a href="/portal/inquire" class="btn btn-primary"><i class="far fa-paper-plane" aria-hidden="true"></i>New message</a>
  </div>

  <% if (list.length === 0) { %>
  <div class="hm-empty">
    <div class="hm-empty-text">
      <h2 class="hm-empty-title">No messages yet</h2>
      <p>Questions about dates, prices or an existing booking? Send a message and the reply will appear here.</p>
      <a href="/portal/inquire" class="btn btn-secondary-quiet">Send an inquiry</a>
    </div>
  </div>
  <% } else { %>
  <ul class="inq-list">
    <% for (const q of list) { const refs = refsIn(q); %>
    <li class="inq-item <%= q.resolution ? 'is-replied' : 'is-waiting' %>" id="inq-<%= q.id %>">
      <article aria-labelledby="inq-h-<%= q.id %>">
        <div class="inq-head">
          <div class="inq-head-main">
            <h2 class="inq-subject" id="inq-h-<%= q.id %>"><%= q.subject %></h2>
            <p class="pt-meta mb-0"><%= topic(q.category) %> · sent <%= when(q.created_at) %></p>
          </div>
          <span class="inq-state"><% if (q.resolution) { %><i class="fas fa-reply" aria-hidden="true"></i>Replied<% } else { %><i class="far fa-clock" aria-hidden="true"></i>Awaiting reply<% } %></span>
        </div>
        <% if (refs.length) { %>
        <p class="inq-about"><% for (const r of refs) { %><a href="/portal/my-reservations/<%= links[r] %>" class="inq-ref"><i class="far fa-calendar" aria-hidden="true"></i>Booking <%= r %></a><% } %></p>
        <% } %>
        <ol class="inq-thread">
          <li class="inq-msg-wrap">
            <div class="inq-who">You wrote</div>
            <p class="inq-msg"><%= q.message %></p>
          </li>
          <% if (q.resolution) { %>
          <li class="inq-msg-wrap is-reply inq-reply">
            <div class="inq-reply-label">Balai-Reserve replied<% if (q.resolved_at) { %> · <time datetime="<%= q.resolved_at %>"><%= when(q.resolved_at) %></time><% } %></div>
            <p><%= q.resolution %></p>
          </li>
          <% } else { %>
          <li><p class="inq-waiting"><i class="far fa-clock" aria-hidden="true"></i>No reply yet<% if (q.status === 'escalated') { %> — passed to the resort’s support team<% } %>. Staff answer here and you’ll get a notification.</p></li>
          <% } %>
        </ol>
        <% if (q.resolution) { %>
        <p class="inq-followup"><a href="/portal/inquire" class="pt-link-more">Ask a follow-up <i class="fas fa-arrow-right" aria-hidden="true"></i></a></p>
        <% } %>
      </article>
    </li>
    <% } %>
  </ul>
  <p class="pt-meta mt-3 mb-0">Times are Philippine time.</p>
  <% } %>
</div>
