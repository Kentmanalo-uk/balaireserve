<% layout('layouts/portal') %>
<%
  const hasDates = !!(filters.checkin && filters.checkout);
  const nights = hasDates ? Math.round((new Date(filters.checkout) - new Date(filters.checkin)) / 86400000) : 0;
  // Searched dates travel with each listing to its page and to the booking form.
  const carry = new URLSearchParams();
  if (hasDates && nights > 0) { carry.set('checkin', filters.checkin); carry.set('checkout', filters.checkout); }
  if (filters.guests) carry.set('guests', filters.guests);
  const qs = carry.toString() ? '?' + carry.toString() : '';
  const range = hasDates && nights > 0 ? formatDate(filters.checkin, 'MMM D') + ' – ' + formatDate(filters.checkout, 'MMM D') : '';
%>

<div class="pt-page">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">Rooms</h1>
      <p class="pt-lede">Overnight stays, priced per night. A <%= downpaymentPercent %>% downpayment is paid online to secure the booking; the balance is settled at the resort.</p>
    </div>
  </div>

  <%include('portal/_catalog-tabs')%>

  <form method="GET" action="/portal/rooms" class="cat-filters" style="--cat-cols:4;" aria-label="Check room availability">
    <div>
      <label class="form-label" for="fCheckin">Check-in</label>
      <input type="date" id="fCheckin" name="checkin" value="<%= filters.checkin %>" class="form-control" />
    </div>
    <div>
      <label class="form-label" for="fCheckout">Check-out</label>
      <input type="date" id="fCheckout" name="checkout" value="<%= filters.checkout %>" class="form-control" />
    </div>
    <div>
      <label class="form-label" for="fGuests">Guests</label>
      <input type="number" id="fGuests" name="guests" value="<%= filters.guests %>" class="form-control" min="1" inputmode="numeric" placeholder="Any" />
    </div>
    <div>
      <label class="form-label" for="fSort">Sort by price</label>
      <select id="fSort" name="sort" class="form-select">
        <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Lowest first</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Highest first</option>
      </select>
    </div>
    <% if (filters.type) { %><input type="hidden" name="type" value="<%= filters.type %>" /><% } %>
    <div class="cat-filters-actions">
      <button type="submit" class="btn btn-primary">Check availability</button>
      <% if (hasDates || filters.guests || filters.type) { %><a href="/portal/rooms" class="btn btn-outline-secondary">Clear</a><% } %>
    </div>
  </form>

  <p class="cat-result" role="status">
    <%= rooms.length %> room<%= rooms.length !== 1 ? 's' : '' %><% if (filters.guests) { %> for <%= filters.guests %>+ guests<% } %><% if (range) { %> · availability for <%= range %>, <%= formatDate(filters.checkout, 'YYYY') %> (<%= nights %> night<%= nights !== 1 ? 's' : '' %>)<% } else { %> · add dates to see which are free<% } %>
  </p>

  <% if (!rooms || rooms.length === 0) { %>
  <div class="pt-surface pt-empty">
    <h2>No rooms match this search</h2>
    <p>Try fewer guests or different dates.</p>
    <a href="/portal/rooms" class="btn btn-outline-secondary">Show all rooms</a>
  </div>
  <% } else { %>
  <div class="lst-list">
    <% for (const r of rooms) { %>
    <%
      const bookable = r.isAvailable;
      const book = new URLSearchParams({ type: 'room', item_id: String(r.id) });
      if (hasDates && nights > 0) { book.set('checkin', filters.checkin); book.set('checkout', filters.checkout); }
      const note = bookable ? (range ? 'Open for ' + range : '') : (hasDates ? 'Booked for these dates' : 'Not taking bookings right now');
    %>
    <%include('partials/listing-card', Object.assign({}, __locals, { card: {
      row: r, kind: 'room', variant: 'row', h: 'h2', qs: qs,
      avail: hasDates || !bookable ? bookable : undefined, availNote: note,
      bookHref: '/portal/book?' + book.toString(), dp: downpaymentPercent, nights: hasDates && nights > 0 ? nights : 0
    } }))%>
    <% } %>
  </div>
  <% } %>
</div>

<%include('portal/_lightbox')%>

<script>
(function () {
  // Local "today" for the date filters.
  var now = new Date();
  var today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  var ci = document.getElementById('fCheckin');
  var co = document.getElementById('fCheckout');
  if (ci) ci.min = today;
  if (co) co.min = ci && ci.value ? ci.value : today;
  if (ci) ci.addEventListener('change', function () {
    if (!co) return;
    co.min = this.value || today;
    if (co.value && co.value <= this.value) co.value = '';
  });
})();
</script>
