<% layout('layouts/portal') %>
<% const pc = (old && old.preferred_contact) || (customer && customer.preferred_contact) || 'email'; %>

<div class="pt-page">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">Profile and password</h1>
      <p class="pt-lede">Keep your contact details current so the resort can reach you about your bookings.</p>
    </div>
  </div>

  <div class="profile-layout">
    <aside class="pt-surface profile-card" aria-label="Account summary">
      <span class="profile-avatar" aria-hidden="true"><%= (account.first_name || '?').charAt(0).toUpperCase() %></span>
      <h2 class="pt-h2 mb-1"><%= account.first_name %> <%= account.last_name %></h2>
      <p class="pt-small text-muted mb-3" style="overflow-wrap:anywhere;"><%= account.email %></p>
      <dl class="pt-dl">
        <dt>Mobile</dt><dd><%= account.phone || '—' %></dd>
        <dt>Sign-in</dt><dd>Email and password</dd>
        <dt>Member since</dt><dd><%= formatDate(account.created_at) %></dd>
      </dl>
    </aside>

    <div class="profile-forms">
      <!-- Edit Profile -->
      <section class="pt-surface" id="profile" aria-labelledby="profileHeading">
        <h2 class="pt-h2" id="profileHeading">Personal details</h2>
        <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <% for (const e of errors) { %><div><%= e.msg %></div><% } %>
        </div>
        <% } %>
        <form action="/portal/profile" method="POST" class="js-validate" novalidate data-no-autosubmit-lock>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="pfFirst">First name</label>
              <input type="text" name="first_name" id="pfFirst" class="form-control" autocomplete="given-name"
                value="<%= (old && old.first_name) || account.first_name || '' %>" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="pfLast">Last name</label>
              <input type="text" name="last_name" id="pfLast" class="form-control" autocomplete="family-name"
                value="<%= (old && old.last_name) || account.last_name || '' %>" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="pfEmail">Email <span class="opt">(can't be changed here)</span></label>
              <input type="email" id="pfEmail" class="form-control" value="<%= account.email || '' %>" disabled />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="pfPhone">Mobile number</label>
              <input type="tel" name="phone" id="pfPhone" class="form-control" autocomplete="tel" inputmode="tel"
                value="<%= (old && old.phone) || account.phone || '' %>" aria-describedby="pfPhoneHint"
                data-pattern="^(?:\+639|09)\d{9}$" data-msg-pattern="Enter a Philippine mobile number: 09XXXXXXXXX or +639XXXXXXXXX." />
              <div class="form-text" id="pfPhoneHint">09XXXXXXXXX or +639XXXXXXXXX — used for booking updates.</div>
            </div>
            <div class="col-12">
              <label class="form-label" for="pfAddress">Address</label>
              <input type="text" name="address" id="pfAddress" class="form-control" autocomplete="street-address"
                value="<%= (old && old.address) || (customer && customer.address) || '' %>"
                placeholder="City, province" />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="pfContact">Preferred contact method</label>
              <select name="preferred_contact" id="pfContact" class="form-select">
                <option value="email" <%= pc === 'email' ? 'selected' : '' %>>Email</option>
                <option value="phone" <%= pc === 'phone' ? 'selected' : '' %>>Phone call</option>
                <option value="sms"   <%= pc === 'sms'   ? 'selected' : '' %>>SMS / text</option>
              </select>
            </div>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save details</button>
          </div>
        </form>
      </section>

      <!-- Change Password -->
      <section class="pt-surface" id="password" aria-labelledby="passwordHeading">
        <h2 class="pt-h2" id="passwordHeading">Change password</h2>
        <% if (pwErrors && pwErrors.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <% for (const e of pwErrors) { %><div><%= e.msg %></div><% } %>
        </div>
        <% } %>
        <form action="/portal/profile/password" method="POST" class="js-validate" novalidate data-no-autosubmit-lock>
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="currentPass">Current password</label>
              <div class="input-group">
                <input type="password" name="current_password" id="currentPass" class="form-control" required autocomplete="current-password" />
                <button type="button" class="input-group-text btn-toggle-pass" data-target="currentPass" aria-label="Show current password">
                  <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="newPass">New password</label>
              <div class="input-group">
                <input type="password" name="new_password" id="newPass" class="form-control" required minlength="8" autocomplete="new-password" aria-describedby="newPassHint" />
                <button type="button" class="input-group-text btn-toggle-pass" data-target="newPass" aria-label="Show new password">
                  <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
              </div>
              <div class="form-text" id="newPassHint">At least 8 characters.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="confirmPass">Confirm new password</label>
              <div class="input-group">
                <input type="password" name="confirm_password" id="confirmPass" class="form-control" required autocomplete="new-password" aria-describedby="pwMatch" />
                <button type="button" class="input-group-text btn-toggle-pass" data-target="confirmPass" aria-label="Show password confirmation">
                  <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
              </div>
              <div id="pwMatch" class="form-text" aria-live="polite"></div>
            </div>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-primary">Update password</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</div>

<script>
(function () {
  var np = document.getElementById('newPass');
  var cp = document.getElementById('confirmPass');
  var msg = document.getElementById('pwMatch');
  if (np && cp && msg) {
    function check() {
      if (!cp.value) { msg.textContent = ''; return; }
      if (cp.value === np.value) { msg.style.color = 'var(--br-success)'; msg.textContent = 'Passwords match'; }
      else { msg.style.color = 'var(--br-danger)'; msg.textContent = 'Passwords do not match'; }
    }
    np.addEventListener('input', check);
    cp.addEventListener('input', check);
  }
  // Show/hide password: main.js swaps the field type; keep the button's state announced.
  document.querySelectorAll('.btn-toggle-pass').forEach(function (b) {
    b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', function () {
      setTimeout(function () {
        var f = document.getElementById(b.dataset.target);
        b.setAttribute('aria-pressed', f && f.type === 'text' ? 'true' : 'false');
      }, 0);
    });
  });
  // Inline validation: concise errors under the field, focus the first problem, busy state while saving.
  function setErr(f, m) {
    var host = f.closest('.input-group') || f, id = f.id + 'Err', box = document.getElementById(id);
    if (!m) { if (box) box.remove(); f.classList.remove('is-invalid'); f.removeAttribute('aria-invalid'); return true; }
    if (!box) { box = document.createElement('div'); box.id = id; box.className = 'field-error'; host.insertAdjacentElement('afterend', box);
      f.setAttribute('aria-describedby', ((f.getAttribute('aria-describedby') || '') + ' ' + id).trim()); }
    box.textContent = m; f.classList.add('is-invalid'); f.setAttribute('aria-invalid', 'true'); return false;
  }
  function label(f) { var l = document.querySelector('label[for="' + f.id + '"]'); return l ? l.childNodes[0].textContent.trim() : 'This field'; }
  function validateField(f) {
    var v = f.value.trim();
    if (f.required && !v) return setErr(f, label(f) + ' is required.');
    if (f.minLength > 0 && v && v.length < f.minLength) return setErr(f, 'Use at least ' + f.minLength + ' characters.');
    if (f.dataset.pattern && v && !new RegExp(f.dataset.pattern).test(v.replace(/[\s-]/g, ''))) return setErr(f, f.dataset.msgPattern);
    if (f.id === 'confirmPass' && v && np && v !== np.value) return setErr(f, 'Passwords do not match.');
    return setErr(f, '');
  }
  document.querySelectorAll('form.js-validate').forEach(function (form) {
    var fields = Array.prototype.slice.call(form.querySelectorAll('input:not([type=hidden]):not(:disabled)'));
    fields.forEach(function (f) { f.addEventListener('blur', function () { if (f.value || f.classList.contains('is-invalid')) validateField(f); }); });
    form.addEventListener('submit', function (e) {
      var bad = fields.filter(function (f) { return !validateField(f); });
      if (bad.length) { e.preventDefault(); bad[0].focus(); return; }
      var btn = form.querySelector('[type=submit]');
      if (btn) { btn.setAttribute('aria-busy', 'true'); btn.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Saving…'; }
    });
  });
  // After a password error the server re-renders with the password section active.
  <% if (activeTab === 'password') { %>
  var pw = document.getElementById('password');
  if (pw) pw.scrollIntoView({ block: 'start' });
  <% } %>
})();
</script>
