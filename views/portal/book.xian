<% layout('layouts/portal') %>
<link rel="stylesheet" href="/css/booking.css" />

<%# Embed package inclusions data for JS — one JSON object keyed by package id %>
<script id="pkgData" type="application/json">
{
  <%- packages.map(p => {
    const safe = JSON.stringify({
      id:       p.id,
      name:     p.name,
      price:    p.price,
      capacity: p.capacity,
      defaults: (p.defaultInclusions || []).map(i => ({ name: i.name, price: i.price, is_optional: i.is_optional })),
      addons:   (p.addonInclusions   || []).map(i => ({ name: i.name, price: i.price })),
      hallId:   p.hall ? p.hall.id : null,
      hallName: p.hall ? p.hall.name : '',
      places:   (p.places || []).map(pl => ({ type: pl.item_type, text: (pl.quantity > 1 ? pl.quantity + ' × ' : '') + pl.row.name, note: pl.note || '' })),
    }).replace(/</g, '\\u003c');
    return JSON.stringify(String(p.id)) + ': ' + safe;
  }).join(',\n  ') %>
}
</script>
<%
  const _sel = (old.reservation_type || filters.type || '');
  const minOf = (rows) => (rows && rows.length) ? Math.min(...rows.map(r => Number(r.price) || 0)) : null;
  const titleCase = (s) => String(s || '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  const eventTypes = [...new Set((packages || []).map(p => p.event_type).filter(t => t && t !== 'other'))].map(titleCase);
  const typeOptions = [
    ['room',    'Room',          'Overnight stay, priced per night.',                         minOf(rooms),    '/night',   'fa-bed'],
    ['cottage', 'Cottage',       'Day use on one date with a time in and out. Flat rate.',    minOf(cottages), '/booking', 'fa-umbrella-beach'],
    ['venue',   (venues && venues.length === 1) ? venues[0].name : 'Venue', 'Function hall for your own event. Flat rate per booking.', minOf(venues), '/booking', 'fa-people-roof'],
    ['event',   'Event package', eventTypes.length ? eventTypes.join(', ') + ' and more.' : 'Packaged events with inclusions.', minOf(packages), '/event', 'fa-champagne-glasses'],
  ];
  const _blk = (row) => JSON.stringify(row.blocked || []);
  const browseFor = { room: '/portal/rooms', cottage: '/portal/cottages', venue: '/portal/venues', event: '/portal/venues#packages' };
  const isPlaceholder = (v) => !v || v === '—' || /^[X\-\s—]+$/i.test(String(v));
  const payMethods = paymentInfo.methods || [];
  const pm0 = payMethods.includes(old.payment_method) ? old.payment_method : (payMethods[0] || '');
  const payNames = payMethods.map(m => ({ gcash: 'GCash', maya: 'Maya', bank_transfer: 'bank transfer' }[m]));
  const payList = payNames.length > 1 ? payNames.slice(0, -1).join(', ') + ' or ' + payNames[payNames.length - 1] : (payNames[0] || 'the resort’s accounts');
  // Prefill from a detail page / catalogue link (?start_time=09:00&end_time=17:00&guests=4); junk falls back to the defaults.
  const _hm = (v) => { const m = /^([01]\d|2[0-3]):([0-5]\d)(?::[0-5]\d)?$/.exec(String(v || '').trim()); return m ? m[1] + ':' + m[2] : ''; };
  const _qStart = _hm(filters.start_time), _qEnd = _hm(filters.end_time);
  const _qGuests = /^[1-9]\d{0,2}$/.test(String(filters.guests || '').trim()) && Number(filters.guests) <= 500 ? String(Number(filters.guests)) : '';
%>

<div class="pt-page bw-page">
  <div class="pt-page-head bw-head">
    <div>
      <a href="<%= browseFor[_sel] || '/portal' %>" class="pt-back"><i class="fas fa-arrow-left" aria-hidden="true"></i><%= _sel ? 'Back to browsing' : 'Portal home' %></a>
      <h1 class="pt-title">Book your stay</h1>
      <p class="pt-lede">Four short steps. You won’t pay on this page: when you submit, the booking is saved as <strong>Awaiting payment</strong> and you pay the <%= terms.downpaymentPercent %>% downpayment by GCash, Maya or bank transfer afterwards.</p>
    </div>
  </div>

  <!-- Wizard progress: "Step 2 of 4" + a thin bar -->
  <div class="bw-progress">
    <p class="wiz-caption" id="wizCaption" aria-live="polite">Step 1 of 4 · What to book</p>
  <ol class="wiz-progress" aria-label="Booking steps">
    <li class="wizard-step-btn active" id="hdr1" aria-current="step"><span class="step-num">1</span><span class="step-label">What to book</span></li>
    <li class="wizard-step-btn" id="hdr2"><span class="step-num">2</span><span class="step-label">Dates &amp; details</span></li>
    <li class="wizard-step-btn" id="hdr3"><span class="step-num">3</span><span class="step-label">Guest info</span></li>
    <li class="wizard-step-btn" id="hdr4"><span class="step-num">4</span><span class="step-label">Payment</span></li>
  </ol>
  </div>

  <% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger mb-3" role="alert">
    <% for (const e of errors) { %><div><%= e.msg %></div><% } %>
  </div>
  <% } %>

  <div class="wiz-layout">

    <!-- Booking summary: sticky side column on desktop, collapsible at the top on phones -->
    <aside class="wiz-aside" aria-labelledby="summaryHeading">
      <div class="wiz-summary" id="bookingSummary">
        <button type="button" class="wiz-sum-toggle" id="summaryToggle" aria-expanded="false" aria-controls="summaryBody">
          <span class="t">Booking summary</span>
          <span class="v"><span id="summaryTotalMini">No total yet</span><i class="fas fa-chevron-down" aria-hidden="true"></i></span>
        </button>
        <h2 class="wiz-sum-title" id="summaryHeading">Booking summary</h2>
        <div class="wiz-sum-body" id="summaryBody">
          <div id="summaryContent">
            <div class="sum-empty">Choose what to book to see your total.</div>
          </div>
          <p class="wiz-sum-note">Prices come from the live catalogue. The final amount is checked again when you submit.</p>
        </div>
      </div>
    </aside>

    <div class="wiz-main">
      <form action="/portal/book" method="POST" id="bookingForm" novalidate>

        <!-- ═══ STEP 1 — What to Book ════════════════════════════════════ -->
        <section class="wizard-panel active" id="panel1" aria-labelledby="step1Title">
          <div class="pt-surface">
            <h2 class="wiz-step-title" id="step1Title" tabindex="-1">What would you like to book?</h2>
            <p class="wiz-step-lede">Pick one. You'll choose the exact room, cottage, venue or package next.</p>
            <div class="type-options" role="group" aria-labelledby="step1Title">
              <% for (const [val, label, desc, from, unit, icon] of typeOptions) { %>
              <button type="button"
                class="type-card <%= _sel === val ? 'selected' : '' %> <%= (lockedSelection && _sel !== val) ? 'type-card-disabled' : '' %>"
                data-type="<%= val %>" aria-pressed="<%= _sel === val ? 'true' : 'false' %>"
                <%- lockedSelection ? 'data-locked="1"' : '' %> <%- (lockedSelection && _sel !== val) ? 'disabled' : '' %>>
                <span class="type-icon" aria-hidden="true"><i class="fas <%= icon %>"></i></span>
                <span class="label"><%= label %></span>
                <span class="type-desc"><%= desc %></span>
                <% if (from != null) { %><span class="type-price">From <%= formatPrice(from) %> <%= unit %></span><% } %>
                <% if (lockedSelection && _sel === val) { %><span class="type-lock-badge">Selected</span><% } else { %><span class="type-check" aria-hidden="true">Selected</span><% } %>
              </button>
              <% } %>
            </div>
            <div id="typeError"></div>
            <% if (lockedSelection) { %>
            <% const _sp = (selectedItem.imagesList || [])[0]; const _unit = _sel === 'room' ? 'per night' : 'per booking'; %>
            <div class="sel-item mt-4">
              <div class="sel-item-photo pt-photo">
                <% if (_sp) { %><img src="<%= _sp %>" alt="<%= selectedItem.name %>" /><% } else { %><div class="photo-pending"><i class="far fa-image" aria-hidden="true"></i>Photos coming soon</div><% } %>
              </div>
              <div class="sel-item-body">
                <p class="pt-meta mb-1">You’re booking</p>
                <p class="sel-item-name"><%= selectedItem.name %></p>
                <p class="sel-item-facts"><%= _sel === 'room' ? 'Sleeps ' : 'Up to ' %><%= selectedItem.capacity %><%= _sel === 'room' ? '' : ' guests' %> · <strong><%= formatPrice(selectedItem.price) %></strong> <%= _unit %></p>
              </div>
            </div>
            <p class="lock-note"><i class="fas fa-lock" aria-hidden="true"></i><span>You chose this from its listing, so the type and the <%= _sel === 'room' ? 'room' : (_sel === 'cottage' ? 'cottage' : 'venue') %> are locked for this booking. <a href="<%= browseFor[_sel] || '/portal' %>">Go back to browse</a> to pick a different one.</span></p>
            <% } %>
            <input type="hidden" name="reservation_type" id="reservationType" value="<%= old.reservation_type || filters.type || '' %>" required />
          </div>
          <div class="wiz-nav">
            <button type="button" class="btn btn-primary" id="nextStep1">Continue to dates <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
          </div>
        </section>

        <!-- ═══ STEP 2 — Dates & Details ════════════════════════════════ -->
        <section class="wizard-panel" id="panel2" aria-labelledby="step2Title">
          <div class="pt-surface">
            <h2 class="wiz-step-title" id="step2Title" tabindex="-1">Select room &amp; dates</h2>
            <p class="wiz-step-lede" id="step2Lede">Choose your option and dates. The summary updates as you go.</p>
            <%# Selected room / cottage / venue: real photo (if any), capacity and rate unit — filled by the script %>
            <div class="sel-item" id="itemCard" hidden aria-live="polite"></div>
            <% if (lockedSelection) { %><p class="lock-note lock-note--step2"><i class="fas fa-lock" aria-hidden="true"></i><span>Locked to your chosen listing. <a href="<%= browseFor[_sel] || '/portal' %>">Go back to browse</a> to pick a different one.</span></p><% } %>
            <div class="mb-4"></div>

            <!-- ── Room fields (room type only) ── -->
            <div id="roomFields" style="display:none;">
              <div class="mb-3">
                <label class="form-label" for="roomSelect">Room</label>
                <select name="item_id" id="roomSelect" class="form-select" <%- lockedSelection ? 'data-locked="1"' : '' %>>
                  <option value="">Choose a room</option>
                  <% for (const r of rooms) { %>
                  <option value="<%= r.id %>"
                    data-price="<%= r.price %>"
                    data-name="<%= r.name %>"
                    data-type="<%= r.type_name %>"
                    data-cap="<%= r.capacity %>"
                    data-images="<%= encodeURIComponent(JSON.stringify(r.imagesList || [])) %>"
                    data-blocked="<%= _blk(r) %>"
                    <%= String(filters.item_id) === String(r.id) ? 'selected' : '' %>>
                    <%= r.name %> · sleeps <%= r.capacity %> · <%= formatPrice(r.price) %> / night
                  </option>
                  <% } %>
                </select>
              </div>
              <div class="row g-3">
                <div class="col-6">
                  <label class="form-label" for="checkInDate">Check-in</label>
                  <input type="date" name="check_in_date" id="checkInDate" class="form-control" value="<%= old.check_in_date || filters.checkin || '' %>" />
                </div>
                <div class="col-6">
                  <label class="form-label" for="checkOutDate">Check-out</label>
                  <input type="date" name="check_out_date" id="checkOutDate" class="form-control" value="<%= old.check_out_date || filters.checkout || '' %>" />
                </div>
              </div>
              <div class="bw-cal" id="roomCal" aria-label="Availability calendar for the selected room"></div>
              <p class="wiz-hint d-none" id="roomPricePreview"><span id="roomPriceText"></span></p>
            </div>

            <!-- ── Cottage fields (cottage type only) ── -->
            <%#
              Cottage inputs use DISTINCT names (cottage_item_id, cottage_checkin,
              cottage_start_time, cottage_end_time) to avoid duplicate field names in the POST body.
              The pre-submit handler copies the active values into canonical reservation fields.
            %>
            <div id="cottageFields" style="display:none;">
              <div class="mb-3">
                <label class="form-label" for="cottageSelect">Cottage</label>
                <select name="cottage_item_id" id="cottageSelect" class="form-select" <%- lockedSelection ? 'data-locked="1"' : '' %>>
                  <option value="">Choose a cottage</option>
                  <% for (const c of cottages) { %>
                  <option value="<%= c.id %>"
                    data-price="<%= c.price %>"
                    data-name="<%= c.name %>"
                    data-cap="<%= c.capacity %>"
                    data-images="<%= encodeURIComponent(JSON.stringify(c.imagesList || [])) %>"
                    data-blocked="<%= _blk(c) %>"
                    <%= String(filters.item_id) === String(c.id) ? 'selected' : '' %>>
                    <%= c.name %> · up to <%= c.capacity %> guests · <%= formatPrice(c.price) %> per booking
                  </option>
                  <% } %>
                </select>
              </div>
              <div class="row g-3">
                <div class="col-12 col-sm-4">
                  <label class="form-label" for="cottageDate">Date</label>
                  <input type="date" name="cottage_checkin" id="cottageDate" class="form-control" value="<%= old.check_in_date || filters.checkin || filters.date || '' %>" />
                </div>
                <div class="col-6 col-sm-4">
                  <label class="form-label" for="cottageStartTime">Time in</label>
                  <input type="time" name="cottage_start_time" id="cottageStartTime" class="form-control" value="<%= old.start_time || _qStart || '14:00' %>" />
                </div>
                <div class="col-6 col-sm-4">
                  <label class="form-label" for="cottageEndTime">Time out</label>
                  <input type="time" name="cottage_end_time" id="cottageEndTime" class="form-control" value="<%= old.end_time || _qEnd || '22:00' %>" />
                </div>
              </div>
              <div class="bw-cal" id="cottageCal" aria-label="Availability calendar for the selected cottage"></div>
              <% if (cottages && cottages.length > 0) { %>
              <p class="wiz-hint d-none" id="cottagePricePreview"><span id="cottagePriceText"></span></p>
              <% } %>
            </div>

            <!-- ── Venue / Event fields ── -->
            <div id="venueFields" style="display:none;">
              <div class="mb-3" id="venueGroup">
                <label class="form-label" for="venueSelect"><span id="venueLabel">Venue</span> <span class="opt" id="venueOpt">(optional, adds the venue fee)</span></label>
                <%# Venue uses venue_item_id to avoid colliding with roomSelect's item_id %>
                <select name="venue_item_id" id="venueSelect" class="form-select" <%- lockedSelection ? 'data-locked="1"' : '' %>>
                  <option value="">No venue</option>
                  <% for (const v of venues) { %>
                  <option value="<%= v.id %>" data-price="<%= v.price %>" data-name="<%= v.name %>" data-cap="<%= v.capacity %>"
                    data-images="<%= encodeURIComponent(JSON.stringify(v.imagesList || [])) %>"
                    data-blocked="<%= _blk(v) %>"
                    <%= String(filters.item_id) === String(v.id) ? 'selected' : '' %>>
                    <%= v.name %> · up to <%= v.capacity %> guests · <%= formatPrice(v.price) %> per booking
                  </option>
                  <% } %>
                </select>
                <p class="wiz-hint" id="pkgHallNote" hidden></p>
              </div>

              <!-- Package selector -->
              <div class="mb-2" id="packageGroup">
                <label class="form-label" for="packageSelect">Event package <span class="opt" id="packageOpt">(optional)</span></label>
                <select name="package_id" id="packageSelect" class="form-select">
                  <option value="">No package</option>
                  <% for (const p of packages) { %>
                  <option value="<%= p.id %>"
                    data-price="<%= p.price %>"
                    data-name="<%= p.name %>"
                    <%= String(filters.package_id) === String(p.id) ? 'selected' : '' %>>
                    <%= p.name %><%= p.capacity ? ' · up to ' + p.capacity + ' guests' : '' %> · <%= formatPrice(p.price) %>
                  </option>
                  <% } %>
                </select>
              </div>

              <!-- ══ INCLUSIONS PANEL (shown when a package is selected) ═══ -->
              <div class="inclusions-panel" id="inclusionsPanel">
                <div class="inclusions-header">
                  <span class="inclusions-header-title">Package inclusions</span>
                  <span class="inclusions-addon-total" id="addonTotalBadge">No add-ons selected</span>
                </div>

                <!-- Places the package includes (hall reserved; rooms / cottages set aside by staff) -->
                <div class="inclusions-defaults" id="pkgPlacesWrap" hidden>
                  <p class="inc-label">Places included</p>
                  <div id="pkgPlacesList"></div>
                </div>

                <!-- Default (included) inclusions -->
                <div class="inclusions-defaults" id="defaultInclusionsWrap">
                  <p class="inc-label">Included in the package price</p>
                  <div id="defaultInclusionsList"></div>
                </div>

                <!-- Optional add-ons -->
                <div class="inclusions-addons" id="addonInclusionsWrap" style="display:none;">
                  <p class="inc-label">Optional add-ons — each one you select is added to your total and the downpayment.</p>
                  <div class="addon-grid" id="addonGrid"></div>
                </div>

                <!-- Add your own request (noted for staff; not priced online) -->
                <div class="inclusions-custom">
                  <label class="inc-label d-block" for="customIncName">Anything else for your event? <span class="fw-normal">Added to your special requests — staff will confirm and quote any cost.</span></label>
                  <div class="add-own-row">
                    <input type="text" id="customIncName" class="form-control" placeholder="e.g. Flower wall backdrop" maxlength="80" />
                    <button type="button" class="btn btn-outline-secondary" id="addCustomIncBtn">Add</button>
                  </div>
                  <div class="custom-inc-list" id="customIncList"></div>
                </div>
              </div>
              <!-- /inclusions-panel -->

              <!-- Hidden inputs — populated by JS before submit -->
              <div id="inclusionHiddenInputs"></div>

              <div class="row g-3 mt-1">
                <div class="col-12 col-sm-4">
                  <label class="form-label" for="eventDate">Event date</label>
                  <input type="date" name="event_date" id="eventDate" class="form-control" value="<%= old.event_date || filters.date || '' %>" />
                </div>
                <div class="col-6 col-sm-4">
                  <label class="form-label" for="eventStartTime">Start time</label>
                  <input type="time" name="start_time" id="eventStartTime" class="form-control" value="<%= old.start_time || _qStart || '14:00' %>" />
                </div>
                <div class="col-6 col-sm-4">
                  <label class="form-label" for="eventEndTime">End time</label>
                  <input type="time" name="end_time" id="eventEndTime" class="form-control" value="<%= old.end_time || _qEnd || '22:00' %>" />
                </div>
              </div>
              <div class="bw-cal" id="eventCal" aria-label="Availability calendar for the event date"></div>
            </div>

            <%# ── Photo gallery of the selected item ── %>
            <div id="itemGallery" class="wiz-group d-none">
              <p class="inc-label">Photos — select to enlarge</p>
              <div id="itemGalleryThumbs" class="item-gallery"></div>
            </div>

            <input type="hidden" name="total_amount" id="totalAmount" value="<%= old.total_amount || '' %>" />
          </div>
          <div class="wiz-nav">
            <button type="button" class="btn btn-outline-secondary" id="prevStep2"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button type="button" class="btn btn-primary" id="nextStep2">Continue to guest details <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
          </div>
        </section>

        <!-- ═══ STEP 3 — Guest Info ══════════════════════════════════════ -->
        <section class="wizard-panel" id="panel3" aria-labelledby="step3Title">
          <div class="pt-surface">
            <h2 class="wiz-step-title" id="step3Title" tabindex="-1">Guest information</h2>
            <p class="wiz-step-lede">Booking for <strong><%= currentUser.firstName %> <%= currentUser.lastName %></strong><% if (currentUser.email) { %> · <%= currentUser.email %><% } %>.</p>
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label" for="numGuests">Number of guests</label>
                <input type="number" name="num_guests" id="numGuests" class="form-control" value="<%= old.num_guests || _qGuests || 1 %>" min="1" max="500" inputmode="numeric" required aria-describedby="guestCapHint" />
                <div class="form-text" id="guestCapHint"></div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="contactPhone">Mobile number</label>
                <input type="tel" name="contact_phone" id="contactPhone" class="form-control" value="<%= old.contact_phone || '' %>" placeholder="09171234567" inputmode="tel" autocomplete="tel" pattern="(?:\+639|09)[0-9]{9}" title="Enter a valid Philippine mobile number, such as +639545425256 or 09545425256." required aria-describedby="phoneHint" />
                <div class="form-text" id="phoneHint">Philippine mobile: 09XXXXXXXXX or +639XXXXXXXXX. Staff use it if they need to reach you.</div>
              </div>
              <div class="col-12">
                <label class="form-label" for="specialRequests">Special requests <span class="opt">(optional)</span></label>
                <textarea name="special_requests" id="specialRequests" class="form-control" rows="4" placeholder="Arrival time, dietary needs, accessibility, occasion details…"><%= old.special_requests || '' %></textarea>
              </div>
            </div>
          </div>
          <div class="wiz-nav">
            <button type="button" class="btn btn-outline-secondary" id="prevStep3"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button type="button" class="btn btn-primary" id="nextStep3">Review payment <i class="fas fa-arrow-right" aria-hidden="true"></i></button>
          </div>
        </section>

        <!-- ═══ STEP 4 — Payment & Confirm ══════════════════════════════ -->
        <section class="wizard-panel" id="panel4" aria-labelledby="step4Title">
          <div class="pt-surface">
            <h2 class="wiz-step-title" id="step4Title" tabindex="-1">Payment</h2>
            <p class="wiz-step-lede">Pay through <%= payList %>, then upload your receipt for verification. You pay outside this site after you submit; cash isn’t available for online bookings.</p>

            <fieldset>
              <legend class="inc-label">Payment method</legend>
              <% if (!payMethods.length) { %><p class="pt-small">The resort hasn’t published its payment details yet. Please <a href="/portal/inquire">contact the resort</a> to complete your booking.</p><% } %>
              <div class="pay-options" id="paymentMethods">
                <% if (payMethods.includes('gcash')) { %>
                <label class="pay-card <%= pm0 === 'gcash' ? 'selected' : '' %>" for="pm_gcash">
                  <input type="radio" name="payment_method" id="pm_gcash" value="gcash" <%= pm0 === 'gcash' ? 'checked' : '' %> required />
                  <span class="pay-radio" aria-hidden="true"></span>
                  <span class="flex-grow-1">
                    <span class="pay-card-name d-block">GCash</span>
                    <span class="pay-card-sub d-block"><%= isPlaceholder(paymentInfo.gcash_number) ? (paymentInfo.gcash_qr_path ? 'Pay by scanning the resort’s GCash QR' : 'Number not published yet — contact the resort first') : 'Send to ' + paymentInfo.gcash_number + ' · ' + paymentInfo.gcash_name %></span>
                  </span>
                  <span class="check-icon <%= pm0 === 'gcash' ? '' : 'd-none' %>">Selected</span>
                </label>

                <% } %>
                <% if (payMethods.includes('maya')) { %>
                <label class="pay-card <%= pm0 === 'maya' ? 'selected' : '' %>" for="pm_maya">
                  <input type="radio" name="payment_method" id="pm_maya" value="maya" <%= pm0 === 'maya' ? 'checked' : '' %> />
                  <span class="pay-radio" aria-hidden="true"></span>
                  <span class="flex-grow-1">
                    <span class="pay-card-name d-block">Maya</span>
                    <span class="pay-card-sub d-block"><%= isPlaceholder(paymentInfo.maya_number) ? (paymentInfo.maya_qr_path ? 'Pay by scanning the resort’s Maya QR' : 'Number not published yet — contact the resort first') : 'Send to ' + paymentInfo.maya_number + ' · ' + paymentInfo.maya_name %></span>
                  </span>
                  <span class="check-icon <%= pm0 === 'maya' ? '' : 'd-none' %>">Selected</span>
                </label>

                <% } %>
                <% if (payMethods.includes('bank_transfer')) { %>
                <label class="pay-card <%= pm0 === 'bank_transfer' ? 'selected' : '' %>" for="pm_bank">
                  <input type="radio" name="payment_method" id="pm_bank" value="bank_transfer" <%= pm0 === 'bank_transfer' ? 'checked' : '' %> />
                  <span class="pay-radio" aria-hidden="true"></span>
                  <span class="flex-grow-1">
                    <span class="pay-card-name d-block">Bank transfer</span>
                    <span class="pay-card-sub d-block"><%= paymentInfo.banks.map(b => b.bank).join(', ') %></span>
                  </span>
                  <span class="check-icon <%= pm0 === 'bank_transfer' ? '' : 'd-none' %>">Selected</span>
                </label>
                <% } %>
              </div>
            </fieldset>

            <%# Account details per method — copied into #payInstrText when a method is picked %>
            <template id="payInfo-gcash">
              <dl class="pt-dl">
                <dt>Send to</dt>
                <dd><% if (!isPlaceholder(paymentInfo.gcash_number)) { %><span class="pay-acct"><span class="acct-num"><%= paymentInfo.gcash_number %></span><button type="button" class="copy-btn" data-copy="<%= paymentInfo.gcash_number %>" aria-label="Copy GCash number"><i class="far fa-copy" aria-hidden="true"></i>Copy number</button></span><% } else { %><span class="pay-missing">Not published yet<%= paymentInfo.gcash_qr_path ? ' — scan the QR code below' : ' — contact the resort before paying' %></span><% } %></dd>
                <dt>Account name</dt><dd><%= paymentInfo.gcash_name %></dd>
                <dt>Message</dt><dd>Your BK- booking reference (shown after you submit)</dd>
              </dl>
            </template>
            <template id="payInfo-maya">
              <dl class="pt-dl">
                <dt>Send to</dt>
                <dd><% if (!isPlaceholder(paymentInfo.maya_number)) { %><span class="pay-acct"><span class="acct-num"><%= paymentInfo.maya_number %></span><button type="button" class="copy-btn" data-copy="<%= paymentInfo.maya_number %>" aria-label="Copy Maya number"><i class="far fa-copy" aria-hidden="true"></i>Copy number</button></span><% } else { %><span class="pay-missing">Not published yet<%= paymentInfo.maya_qr_path ? ' — scan the QR code below' : ' — contact the resort before paying' %></span><% } %></dd>
                <dt>Account name</dt><dd><%= paymentInfo.maya_name %></dd>
                <dt>Message</dt><dd>Your BK- booking reference (shown after you submit)</dd>
              </dl>
            </template>
            <template id="payInfo-bank_transfer">
              <dl class="pt-dl">
                <% for (const b of paymentInfo.banks) { %>
                <dt><%= b.bank %></dt><dd><span class="pay-acct"><span class="acct-num"><%= b.number %></span><button type="button" class="copy-btn" data-copy="<%= b.number %>" aria-label="Copy <%= b.bank %> account number">Copy number</button></span><span class="d-block pt-small"><%= b.account_name %></span></dd>
                <% } %>
                <dt>Reference</dt><dd>Your BK- booking reference (shown after you submit)</dd>
              </dl>
            </template>

            <div id="paymentInstructions" class="pay-details d-none" aria-live="polite">
              <p class="inc-label mb-2">Where to send the downpayment</p>
              <div id="payInstrText"></div>
              <div class="pay-qr d-none" data-pay-qr="gcash">
                <% if (paymentInfo.gcash_qr_path) { %>
                <figure class="mb-0">
                  <img src="<%= paymentInfo.gcash_qr_path %>" alt="GCash QR code for <%= paymentInfo.gcash_name %>" />
                  <figcaption>Scan with the GCash app</figcaption>
                </figure>
                <% } else { %>
                <p class="pay-qr-missing">No GCash QR code has been uploaded yet — send to the number above.</p>
                <% } %>
              </div>
              <div class="pay-qr d-none" data-pay-qr="maya">
                <% if (paymentInfo.maya_qr_path) { %>
                <figure class="mb-0">
                  <img src="<%= paymentInfo.maya_qr_path %>" alt="Maya QR code for <%= paymentInfo.maya_name %>" />
                  <figcaption>Scan with the Maya app</figcaption>
                </figure>
                <% } else { %>
                <p class="pay-qr-missing">No Maya QR code has been uploaded yet — send to the number above.</p>
                <% } %>
              </div>
            </div>

            <div class="wiz-group">
              <h3 class="pt-h3">What happens after you submit</h3>
              <ol class="next-steps">
                <li>Your booking is saved with a <strong>BK-YYYY-NNNN</strong> reference and shows as <strong>Awaiting payment</strong> (payment: Unpaid). It is not confirmed or paid yet.</li>
                <li>Pay the downpayment (<span data-sum="dp">shown in the summary</span>) by your chosen method, and add your BK- reference as the message. Please pay within 48 hours — unpaid bookings may be released.</li>
                <li>Upload a screenshot of your payment on the booking page. Staff check it against the resort’s account.</li>
                <li>Once staff verify your payment you’re notified and the status updates; the remaining balance is paid at the resort.</li>
              </ol>
            </div>

            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" id="agreeTerms" required />
              <label class="form-check-label" for="agreeTerms">
                I agree to the <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">booking terms and cancellation policy</a> and understand the downpayment requirement.
              </label>
            </div>
            <div id="agreeTermsSlot"></div>
          </div>
          <div class="wiz-nav">
            <button type="button" class="btn btn-outline-secondary" id="prevStep4"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button type="submit" class="btn btn-primary btn-lg" id="submitBooking">Submit booking</button>
          </div>
        </section>

      </form>
    </div>
  </div>
</div>

<script src="/js/br-datepicker.js"></script>
<script>
(function () {
  'use strict';
  var downpaymentPercent = Number('<%= terms.downpaymentPercent %>');
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Package data injected from server ─────────────────────────────────── */
  var pkgData = {};
  try { pkgData = JSON.parse(document.getElementById('pkgData').textContent); } catch (e) {}

  /* ── State ─────────────────────────────────────────────────────────────── */
  var currentStep      = 1;
  var selectedAddons   = {};   // key: addonName → price
  var removedDefaults  = {};   // key: incName → true  (defaults the user removed)
  var customInclusions = [];   // [{name, price:0}] guest requests, noted for staff
  var STEP_NAMES = ['', 'What to book', 'Dates & details', 'Guest info', 'Payment'];
  var TYPE_LABEL = { room: 'Room', cottage: 'Cottage', venue: 'Venue', event: 'Event package' };

  /* ── Helpers ───────────────────────────────────────────────────────────── */
  // Amounts due (total, downpayment, balance): always 2 decimals, like formatPeso.
  function fmt(n) {
    return '₱' + Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  // Catalogue rates: no ".00" for whole pesos, like formatPrice.
  function fmtPrice(n) {
    var v = Number(n) || 0, whole = Math.round(v * 100) % 100 === 0;
    return '₱' + v.toLocaleString('en-PH', { minimumFractionDigits: whole ? 0 : 2, maximumFractionDigits: 2 });
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  // A resized WebP copy of a catalogue photo (src/utils/images.js); other images unchanged.
  function sized(src, w) {
    return /^\/(uploads|images\/landing)\/[\w./-]+\.(jpe?g|png|webp)$/i.test(src || '') ? '/img/' + w + src : src;
  }
  function fmtDate(ymd) {
    if (!ymd) return '';
    var d = new Date(ymd + 'T00:00:00Z');
    if (isNaN(d)) return ymd;
    return d.toLocaleDateString('en-PH', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  }
  function fmtTime(hm) {
    if (!hm) return '';
    var p = hm.split(':'), h = parseInt(p[0], 10), m = p[1] || '00';
    if (isNaN(h)) return hm;
    return ((h % 12) || 12) + ':' + m + ' ' + (h < 12 ? 'AM' : 'PM');
  }
  function localToday() {
    var now = new Date();
    return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  }
  function onwardMessage(min) {
    var d = new Date(min + 'T00:00:00');
    return 'Please select ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' onward.';
  }
  function selOpt(sel) { return sel && sel.selectedIndex >= 0 ? sel.options[sel.selectedIndex] : null; }

  // Professional in-app message (falls back to native alert only if unavailable).
  function notify(message, type) {
    if (window.appNotify) { window.appNotify(message, type || 'warning'); }
    else { alert(message); }
  }

  // Inline validation: message right below the field, field marked invalid and focused.
  function clearFieldErrors(scope) {
    (scope || document).querySelectorAll('.field-error[data-js]').forEach(function (e) { e.remove(); });
    (scope || document).querySelectorAll('[aria-invalid="true"]').forEach(function (f) {
      f.removeAttribute('aria-invalid'); f.classList.remove('is-invalid');
    });
  }
  function fieldError(field, message, anchor) {
    if (!field) { notify(message, 'warning'); return false; }
    var id = (field.id || 'field') + 'Err';
    var box = document.getElementById(id);
    if (!box) {
      box = document.createElement('div');
      box.id = id; box.className = 'field-error'; box.setAttribute('data-js', '1'); box.setAttribute('role', 'alert');
      (anchor || field.closest('.input-group') || field).insertAdjacentElement('afterend', box);
    }
    box.textContent = message;
    if (field.classList && field.matches('input,select,textarea')) {
      field.classList.add('is-invalid'); field.setAttribute('aria-invalid', 'true');
      var desc = (field.getAttribute('aria-describedby') || '').split(' ').filter(Boolean);
      if (desc.indexOf(id) < 0) { desc.push(id); field.setAttribute('aria-describedby', desc.join(' ')); }
    }
    if (field.focus) field.focus();
    return false;
  }
  document.addEventListener('input', function (e) {
    var f = e.target;
    if (f.getAttribute && f.getAttribute('aria-invalid') === 'true') {
      f.removeAttribute('aria-invalid'); f.classList.remove('is-invalid');
      var box = document.getElementById(f.id + 'Err'); if (box) box.remove();
    }
  });
  document.addEventListener('change', function (e) {
    var f = e.target;
    if (f.getAttribute && f.getAttribute('aria-invalid') === 'true') {
      f.removeAttribute('aria-invalid'); f.classList.remove('is-invalid');
      var box = document.getElementById(f.id + 'Err'); if (box) box.remove();
    }
  });

  function goTo(step) {
    for (var i = 1; i <= 4; i++) {
      var panel = document.getElementById('panel' + i);
      var hdr   = document.getElementById('hdr' + i);
      if (panel) panel.className = 'wizard-panel' + (i === step ? ' active' : '');
      if (hdr) {
        hdr.className = 'wizard-step-btn';
        if (i < step)   hdr.className += ' done';
        if (i === step) hdr.className += ' active';
        if (i === step) hdr.setAttribute('aria-current', 'step'); else hdr.removeAttribute('aria-current');
      }
    }
    currentStep = step;
    var cap = document.getElementById('wizCaption');
    if (cap) cap.textContent = 'Step ' + step + ' of 4 · ' + STEP_NAMES[step];
    if (step === 4) setSummaryOpen(true);
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    var title = document.getElementById('step' + step + 'Title');
    if (title) title.focus({ preventScroll: true });
  }

  /* ── Mobile summary toggle ──────────────────────────────────────────────── */
  var summaryBox = document.getElementById('bookingSummary');
  var summaryToggle = document.getElementById('summaryToggle');
  function setSummaryOpen(open) {
    if (!summaryBox) return;
    summaryBox.classList.toggle('is-open', !!open);
    if (summaryToggle) summaryToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  if (summaryToggle) summaryToggle.addEventListener('click', function () {
    setSummaryOpen(!summaryBox.classList.contains('is-open'));
  });

  /* ── Step 1: What to book ──────────────────────────────────────────────── */
  var typeCards    = document.querySelectorAll('.type-card');
  var resTypeInput = document.getElementById('reservationType');
  var nextStep1Btn = document.getElementById('nextStep1');

  // When the selection is locked (customer arrived from a specific "Book"
  // button), the type cannot be changed.
  var selectionLocked = !!document.querySelector('.type-card[data-locked="1"]');

  typeCards.forEach(function (card) {
    card.addEventListener('click', function () {
      if (selectionLocked) return;   // locked: ignore type changes
      typeCards.forEach(function (c) { c.classList.remove('selected'); c.setAttribute('aria-pressed', 'false'); });
      this.classList.add('selected');
      this.setAttribute('aria-pressed', 'true');
      resTypeInput.value = this.dataset.type;
      var te = document.getElementById('typeErrorErr'); if (te) te.remove();
      updateStep2Fields(this.dataset.type);
    });
  });

  // Locked item selects: revert any attempt to change them, keeping the
  // pre-chosen value (which still posts because the select stays enabled).
  ['roomSelect','cottageSelect','venueSelect'].forEach(function (id) {
    var sel = document.getElementById(id);
    if (!sel || !sel.hasAttribute('data-locked')) return;
    var lockedValue = sel.value;
    if (!lockedValue) return;   // only the type's own list carries the chosen item
    sel.classList.add('is-locked-select');
    sel.setAttribute('aria-readonly', 'true');
    // Show the choice as a locked card (renderItemCard) instead of a dropdown that looks changeable;
    // the hidden select still posts the value.
    var box = sel.closest('.mb-3');
    if (box) box.hidden = true;
    sel.addEventListener('mousedown', function (e) { e.preventDefault(); });  // block dropdown open
    sel.addEventListener('change', function () {
      if (this.value !== lockedValue) {
        this.value = lockedValue;
        this.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
    sel.addEventListener('keydown', function (e) { if (e.key !== 'Tab') e.preventDefault(); });
  });

  nextStep1Btn.addEventListener('click', function () {
    if (!resTypeInput.value) {
      return fieldError(document.getElementById('typeError'), 'Please choose what you would like to book.');
    }
    updateStep2Fields(resTypeInput.value);
    goTo(2);
  });

  function updateStep2Fields(type) {
    var roomF           = document.getElementById('roomFields');
    var cottageF        = document.getElementById('cottageFields');
    var venueF          = document.getElementById('venueFields');
    var eventStartTime  = document.getElementById('eventStartTime');
    var eventEndTime    = document.getElementById('eventEndTime');
    var title           = document.getElementById('step2Title');
    var isEventTimeType = type === 'venue' || type === 'event';
    roomF.style.display    = (type === 'room')    ? '' : 'none';
    cottageF.style.display = (type === 'cottage') ? '' : 'none';
    venueF.style.display   = isEventTimeType ? '' : 'none';
    if (eventStartTime) eventStartTime.disabled = !isEventTimeType;
    if (eventEndTime)   eventEndTime.disabled = !isEventTimeType;
    if (type === 'room')    title.textContent = 'Choose your room and dates';
    if (type === 'cottage') title.textContent = 'Choose your cottage, date and time';
    if (type === 'venue')   title.textContent = 'Choose the venue and event date';
    if (type === 'event')   title.textContent = 'Choose your package and event date';
    applyPackageHall();
    // Venue is required for a venue booking; a package is the point of an event booking.
    var vOpt = document.getElementById('venueOpt'), pOpt = document.getElementById('packageOpt');
    if (vOpt) vOpt.style.display = type === 'venue' ? 'none' : '';
    if (pOpt) pOpt.style.display = type === 'event' ? 'none' : '';
    var pg = document.getElementById('packageGroup'), vg = document.getElementById('venueGroup');
    if (pg && vg && pg.parentNode === vg.parentNode) {
      if (type === 'event' && vg.nextElementSibling === pg) vg.parentNode.insertBefore(pg, vg);
      if (type === 'venue' && pg.nextElementSibling === vg) pg.parentNode.insertBefore(vg, pg);
    }
    recalcTotal();
    renderGalleryForType();
  }

  /* ── Pre-select item_id from URL ───────────────────────────────────────── */
  var sp = new URLSearchParams(location.search);
  var urlItemId = sp.get('item_id');
  var urlType = sp.get('type');
  if (urlItemId) {
    var targetSel = { room: 'roomSelect', venue: 'venueSelect', cottage: 'cottageSelect' }[urlType];
    (targetSel ? [targetSel] : ['roomSelect','venueSelect','cottageSelect']).forEach(function (selId) {
      var sel = document.getElementById(selId);
      if (!sel) return;
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === urlItemId) { sel.selectedIndex = i; break; }
      }
    });
  }

  /* ═══════════════════════════════════════════════════════════════════════
     INCLUSIONS PANEL
     ═══════════════════════════════════════════════════════════════════════ */
  var pkgSelect       = document.getElementById('packageSelect');
  var inclusionsPanel = document.getElementById('inclusionsPanel');
  var defaultList     = document.getElementById('defaultInclusionsList');
  var addonWrap       = document.getElementById('addonInclusionsWrap');
  var addonGrid       = document.getElementById('addonGrid');
  var addonBadge      = document.getElementById('addonTotalBadge');
  var hiddenInputsDiv = document.getElementById('inclusionHiddenInputs');
  var customListDiv   = document.getElementById('customIncList');

  // Selected priced add-ons are charged: the server adds each one's catalogue price to the total.
  function getAddonTotal() {
    var t = 0;
    for (var k in selectedAddons) { if (selectedAddons.hasOwnProperty(k)) t += selectedAddons[k]; }
    return t;
  }

  function renderInclusionsPanel(pkgId) {
    var pkg = pkgData[String(pkgId)];

    // Reset state
    selectedAddons  = {};
    removedDefaults = {};
    customInclusions = [];
    customListDiv.innerHTML = '';

    if (!pkg || pkgId === '' || pkgId === null) {
      inclusionsPanel.classList.remove('visible');
      return;
    }

    inclusionsPanel.classList.add('visible');

    /* ── Places included ─── */
    var placesWrap = document.getElementById('pkgPlacesWrap'), placesList = document.getElementById('pkgPlacesList');
    placesList.innerHTML = '';
    (pkg.places || []).forEach(function (pl) {
      var row = document.createElement('div');
      row.className = 'default-inc-item';
      var icon = document.createElement('i');
      icon.className = 'fas ' + (pl.type === 'room' ? 'fa-bed' : pl.type === 'cottage' ? 'fa-umbrella-beach' : 'fa-building-columns');
      icon.setAttribute('aria-hidden', 'true');
      var text = document.createElement('span');
      text.textContent = pl.text + (pl.type === 'venue' ? ' (reserved for your event)' : '') + (pl.note ? ' — ' + pl.note : '');
      row.appendChild(icon); row.appendChild(text);
      placesList.appendChild(row);
    });
    placesWrap.hidden = !(pkg.places || []).length;
    if (window.ikionsRender) window.ikionsRender(placesList);

    /* ── Default (included) inclusions ─── */
    defaultList.innerHTML = '';
    if (!(pkg.defaults || []).length) {
      defaultList.innerHTML = '<div class="default-inc-item text-muted">The resort confirms this package\'s inclusions with you.</div>';
    }
    (pkg.defaults || []).forEach(function (inc) {
      var row = document.createElement('div');
      row.className = 'default-inc-item';
      row.dataset.name = inc.name;

      var icon = document.createElement('i');
      icon.className = 'fas fa-check';
      icon.setAttribute('aria-hidden', 'true');
      row.appendChild(icon);

      var nameSpan = document.createElement('span');
      nameSpan.textContent = inc.name;
      row.appendChild(nameSpan);

      // Removable defaults (is_optional = 1 with price = 0) get a "Remove" btn
      if (inc.is_optional) {
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'default-inc-removable';
        removeBtn.textContent = 'Remove';
        removeBtn.setAttribute('aria-label', 'Remove ' + inc.name);
        var addBack = document.createElement('button');
        addBack.type = 'button';
        addBack.className = 'default-inc-add-back';
        addBack.textContent = 'Add back';
        addBack.setAttribute('aria-label', 'Add back ' + inc.name);
        removeBtn.addEventListener('click', function () {
          removedDefaults[inc.name] = true;
          row.classList.add('removed');
          removeBtn.remove();
          row.appendChild(addBack);
          addBack.focus();
          syncHiddenInputs(); updateAddonBadge(); calcVenuePrice();
        });
        addBack.addEventListener('click', function () {
          delete removedDefaults[inc.name];
          row.classList.remove('removed');
          addBack.remove();
          row.appendChild(removeBtn);
          removeBtn.focus();
          syncHiddenInputs(); updateAddonBadge(); calcVenuePrice();
        });
        row.appendChild(removeBtn);
      }
      defaultList.appendChild(row);
    });

    /* ── Add-on inclusions ─── */
    addonGrid.innerHTML = '';
    if (pkg.addons && pkg.addons.length > 0) {
      addonWrap.style.display = '';
      pkg.addons.forEach(function (addon) {
        var card = document.createElement('button');
        card.type = 'button';
        card.className = 'addon-item';
        card.dataset.name  = addon.name;
        card.dataset.price = addon.price;
        card.setAttribute('aria-pressed', 'false');

        var chk = document.createElement('span');
        chk.className = 'addon-check';
        chk.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
        card.appendChild(chk);

        var nm = document.createElement('span');
        nm.className = 'addon-name';
        nm.textContent = addon.name;
        card.appendChild(nm);

        var pr = document.createElement('span');
        pr.className = 'addon-price';
        pr.textContent = '+' + fmtPrice(addon.price);
        card.appendChild(pr);

        card.addEventListener('click', function () {
          if (card.classList.contains('selected')) {
            card.classList.remove('selected');
            card.setAttribute('aria-pressed', 'false');
            delete selectedAddons[addon.name];
          } else {
            card.classList.add('selected');
            card.setAttribute('aria-pressed', 'true');
            selectedAddons[addon.name] = Number(addon.price) || 0;
          }
          syncHiddenInputs();
          updateAddonBadge();
          calcVenuePrice();
        });
        addonGrid.appendChild(card);
      });
    } else {
      addonWrap.style.display = 'none';
    }

    syncHiddenInputs();
    updateAddonBadge();
  }

  function updateAddonBadge() {
    var t = getAddonTotal();
    var n = Object.keys(selectedAddons).length;
    addonBadge.textContent = t > 0 ? n + ' add-on' + (n === 1 ? '' : 's') + ': +' + fmt(t) + ' to your total' : 'No add-ons selected';
  }

  /* Sync hidden inputs — one per selected/custom inclusion */
  function syncHiddenInputs() {
    hiddenInputsDiv.innerHTML = '';

    var pkg = pkgData[String(pkgSelect ? pkgSelect.value : '')];

    // Default inclusions that are NOT removed
    if (pkg) {
      (pkg.defaults || []).forEach(function (inc) {
        if (!removedDefaults[inc.name]) {
          var inp = document.createElement('input');
          inp.type  = 'hidden';
          inp.name  = 'selected_inclusions[]';
          inp.value = JSON.stringify({ name: inc.name, price: 0 });
          hiddenInputsDiv.appendChild(inp);
        }
      });
    }

    // Selected optional add-ons
    for (var name in selectedAddons) {
      if (selectedAddons.hasOwnProperty(name)) {
        var inp2 = document.createElement('input');
        inp2.type  = 'hidden';
        inp2.name  = 'selected_inclusions[]';
        inp2.value = JSON.stringify({ name: name, price: selectedAddons[name] });
        hiddenInputsDiv.appendChild(inp2);
      }
    }

    // Custom (guest-typed) requests
    customInclusions.forEach(function (ci) {
      var inp3 = document.createElement('input');
      inp3.type  = 'hidden';
      inp3.name  = 'selected_inclusions[]';
      inp3.value = JSON.stringify({ name: ci.name, price: 0 });
      hiddenInputsDiv.appendChild(inp3);
    });
  }

  if (pkgSelect) {
    pkgSelect.addEventListener('change', function () {
      renderInclusionsPanel(this.value);
      applyPackageHall();
      calcVenuePrice();
      updateSummary();
    });
  }

  /* ── Custom request (noted for staff, not priced online) ─────────────── */
  function addCustomRequest() {
    var nameEl = document.getElementById('customIncName');
    var name   = (nameEl.value || '').trim();
    if (!name) { nameEl.focus(); return; }
    // A request that names one of the package's priced add-ons is that add-on (and is charged), so select it instead.
    var match = Array.prototype.find.call(addonGrid.querySelectorAll('.addon-item'), function (c) { return c.dataset.name === name; });
    if (match) { if (!match.classList.contains('selected')) match.click(); nameEl.value = ''; match.focus(); return; }

    customInclusions.push({ name: name, price: 0 });

    var chip = document.createElement('div');
    chip.className = 'custom-inc-item';

    var nm = document.createElement('span');
    nm.className = 'custom-inc-name';
    nm.textContent = name;
    chip.appendChild(nm);

    var pr = document.createElement('span');
    pr.className = 'custom-inc-price';
    pr.textContent = 'Staff will confirm';
    chip.appendChild(pr);

    var rmBtn = document.createElement('button');
    rmBtn.type = 'button';
    rmBtn.className = 'custom-inc-remove';
    rmBtn.setAttribute('aria-label', 'Remove ' + name);
    rmBtn.innerHTML = '<i class="fas fa-times" aria-hidden="true"></i>';
    var entry = customInclusions[customInclusions.length - 1];
    rmBtn.addEventListener('click', function () {
      var i = customInclusions.indexOf(entry);
      if (i >= 0) customInclusions.splice(i, 1);
      chip.remove();
      syncHiddenInputs();
      updateSummary();
      nameEl.focus();
    });
    chip.appendChild(rmBtn);

    customListDiv.appendChild(chip);
    nameEl.value = '';
    nameEl.focus();

    syncHiddenInputs();
    updateSummary();
  }
  document.getElementById('addCustomIncBtn').addEventListener('click', addCustomRequest);
  document.getElementById('customIncName').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); addCustomRequest(); }
  });

  /* ── Step 2: validation & price calc ───────────────────────────────── */
  function checkDateMin(field) {
    if (field && field.value && field.min && field.value < field.min) return fieldError(field, onwardMessage(field.min));
    return true;
  }

  document.getElementById('prevStep2').addEventListener('click', function () { goTo(1); });
  document.getElementById('nextStep2').addEventListener('click', function () {
    var type = resTypeInput.value;
    clearFieldErrors(document.getElementById('panel2'));
    if (type === 'room') {
      var rs = document.getElementById('roomSelect');
      var ci = document.getElementById('checkInDate');
      var co = document.getElementById('checkOutDate');
      if (!rs.value) return fieldError(rs, 'Please choose a room.');
      if (!ci.value) return fieldError(ci, 'Please choose a check-in date.');
      if (!checkDateMin(ci)) return;
      if (!co.value) return fieldError(co, 'Please choose a check-out date.');
      if (ci.value >= co.value) return fieldError(co, 'Check-out must be after check-in.');
      if (!checkDateMin(co)) return;
      checkAvailability();
      if (roomConflict) return fieldError(ci, 'These nights overlap an existing booking — see the note below the dates.');
    } else if (type === 'cottage') {
      var cs = document.getElementById('cottageSelect');
      var cd = document.getElementById('cottageDate');
      var cst = document.getElementById('cottageStartTime');
      var cet = document.getElementById('cottageEndTime');
      if (!cs.value) return fieldError(cs, 'Please choose a cottage.');
      if (!cd.value) return fieldError(cd, 'Please choose a date.');
      if (!checkDateMin(cd)) return;
      if (!cst.value) return fieldError(cst, 'Please choose a time in.');
      if (!cet.value) return fieldError(cet, 'Please choose a time out.');
      if (cet.value <= cst.value) return fieldError(cet, 'Time out must be after time in.');
      checkAvailability();
      if (dayConflict) return fieldError(cd, dayConflict);
    } else {
      var vs = document.getElementById('venueSelect');
      var ed = document.getElementById('eventDate');
      var est = document.getElementById('eventStartTime');
      var eet = document.getElementById('eventEndTime');
      if (type === 'venue' && !vs.value) return fieldError(vs, 'Please choose the venue.');
      if (type === 'event' && !pkgSelect.value && !vs.value) return fieldError(pkgSelect, 'Please choose an event package.');
      if (!ed || !ed.value) return fieldError(ed, 'Please choose an event date.');
      if (!checkDateMin(ed)) return;
      if ((est.value || eet.value) && !(est.value && eet.value && eet.value > est.value)) return fieldError(eet, 'End time must be after start time.');
      checkAvailability();
      if (dayConflict) return fieldError(ed, dayConflict);
    }
    if (!(parseFloat(totalHid.value) > 0)) {
      return fieldError(document.getElementById('nextStep2'), 'We could not work out a price for this selection. Please check your choices.', document.querySelector('#panel2 .pt-surface'));
    }
    goTo(3);
  });

  var checkIn  = document.getElementById('checkInDate');
  var checkOut = document.getElementById('checkOutDate');
  var roomSel  = document.getElementById('roomSelect');
  var totalHid = document.getElementById('totalAmount');
  var preview  = document.getElementById('roomPricePreview');
  var prevText = document.getElementById('roomPriceText');

  function calcRoomPrice() {
    if (!roomSel || !checkIn || !checkOut) return;
    var opt = selOpt(roomSel);
    var price = parseFloat((opt && opt.dataset && opt.dataset.price) || 0);
    var nights = (checkIn.value && checkOut.value) ? Math.round((new Date(checkOut.value) - new Date(checkIn.value)) / 86400000) : 0;
    if (price > 0 && nights > 0) {
      var total = price * nights;
      totalHid.value = total.toFixed(2);
      prevText.innerHTML = nights + ' night' + (nights === 1 ? '' : 's') + ' × ' + fmtPrice(price) + ' = <strong>' + fmt(total) +
        '</strong> · downpayment ' + fmt(Math.ceil(total * downpaymentPercent / 100));
      preview.classList.remove('d-none');
    } else {
      totalHid.value = '';
      preview.classList.add('d-none');
    }
    updateSummary();
  }
  if (checkIn)  checkIn.addEventListener('change', calcRoomPrice);
  if (checkOut) checkOut.addEventListener('change', calcRoomPrice);
  if (roomSel)  roomSel.addEventListener('change', calcRoomPrice);

  // ── Cottage price calc ───────────────────────────────────────────────────
  var cottageSel     = document.getElementById('cottageSelect');
  var cottagePreview = document.getElementById('cottagePricePreview');
  var cottagePrevTxt = document.getElementById('cottagePriceText');
  var cottageDateEl  = document.getElementById('cottageDate');
  var cottageStartEl = document.getElementById('cottageStartTime');
  var cottageEndEl   = document.getElementById('cottageEndTime');

  function calcCottagePrice() {
    if (!cottageSel || !cottageStartEl || !cottageEndEl) return;
    var opt = selOpt(cottageSel);
    var rate = parseFloat((opt && opt.dataset && opt.dataset.price) || 0);
    // The cottage rate is the total; time in/out is kept for scheduling only.
    var total = rate > 0 ? rate : 0;
    totalHid.value = total > 0 ? total.toFixed(2) : '';
    if (cottagePrevTxt && total > 0) {
      cottagePrevTxt.innerHTML = 'Flat rate for this booking: <strong>' + fmt(total) +
        '</strong> · downpayment ' + fmt(Math.ceil(total * downpaymentPercent / 100)) + '. The price is the same whatever times you choose.';
    }
    if (cottagePreview) cottagePreview.classList.toggle('d-none', !(total > 0));
    updateSummary();
  }
  if (cottageSel)    cottageSel.addEventListener('change', calcCottagePrice);
  if (cottageDateEl) cottageDateEl.addEventListener('change', calcCottagePrice);
  if (cottageStartEl) cottageStartEl.addEventListener('change', calcCottagePrice);
  if (cottageEndEl)   cottageEndEl.addEventListener('change', calcCottagePrice);

  var venueSel = document.getElementById('venueSelect');
  function calcVenuePrice() {
    var vo = selOpt(venueSel), po = selOpt(pkgSelect);
    // A hall that comes with the event package is part of the package price.
    var vPrice = vo && vo.value && vo.value !== packageHallId() ? parseFloat(vo.dataset.price || 0) : 0;
    var pPrice = po && po.value ? parseFloat(po.dataset.price || 0) : 0;
    // Same rule as the server: venue + package + each selected priced add-on of that package.
    var total = vPrice + pPrice + (pPrice > 0 ? getAddonTotal() : 0);
    totalHid.value = total > 0 ? total.toFixed(2) : '';
    updateSummary();
  }
  if (venueSel) venueSel.addEventListener('change', function () { calcVenuePrice(); });

  // An event package that includes a function hall is always held there: the hall is chosen and locked.
  function packageHallId() {
    if (resTypeInput.value !== 'event' || !pkgSelect) return '';
    var pkg = pkgData[String(pkgSelect.value || '')];
    return pkg && pkg.hallId ? String(pkg.hallId) : '';
  }
  function applyPackageHall() {
    if (!venueSel) return;
    var hallId = packageHallId(), note = document.getElementById('pkgHallNote');
    var hasOption = hallId && venueSel.querySelector('option[value="' + hallId + '"]');
    if (hallId && hasOption) {
      if (venueSel.value !== hallId) { venueSel.value = hallId; venueSel.dispatchEvent(new Event('change', { bubbles: true })); }
      venueSel.disabled = true;
      if (note) { note.hidden = false; note.textContent = 'The ' + pkgData[String(pkgSelect.value)].hallName + ' comes with this package and is reserved for your event — no extra venue fee.'; }
    } else {
      if (venueSel.disabled && venueSel.dataset.pkgLocked) venueSel.value = '';
      venueSel.disabled = false;
      if (note) {
        note.hidden = !hallId;
        if (hallId) note.textContent = 'This package’s function hall isn’t taking bookings right now. Please send an inquiry or choose another package.';
      }
    }
    venueSel.dataset.pkgLocked = hallId && hasOption ? '1' : '';
  }
  ['eventDate','eventStartTime','eventEndTime'].forEach(function (id) {
    var el = document.getElementById(id); if (el) el.addEventListener('change', updateSummary);
  });

  // One entry point: recompute the total for whatever type is selected.
  function recalcTotal() {
    var t = resTypeInput.value;
    if (t === 'room') calcRoomPrice();
    else if (t === 'cottage') calcCottagePrice();
    else if (t === 'venue' || t === 'event') calcVenuePrice();
    else { totalHid.value = ''; updateSummary(); }
  }

  /* ── Step 3 ─────────────────────────────────────────────────────────── */
  document.getElementById('prevStep3').addEventListener('click', function () { goTo(2); });
  var contactPhoneInput = document.querySelector('[name="contact_phone"]');
  var contactPhonePattern = /^(?:\+639|09)\d{9}$/;
  var contactPhoneMessage = 'Enter a valid Philippine mobile number, such as +639545425256 or 09545425256.';
  if (contactPhoneInput) contactPhoneInput.addEventListener('input', function () {
    var value = this.value.trim();
    this.setCustomValidity(value && !contactPhonePattern.test(value) ? contactPhoneMessage : '');
  });

  function activeResource() {
    var t = resTypeInput.value;
    var sel = t === 'room' ? roomSel : t === 'cottage' ? cottageSel : (t === 'venue' || t === 'event') ? venueSel : null;
    var o = selOpt(sel);
    return o && o.value ? { name: o.dataset.name || o.text, cap: parseInt(o.dataset.cap || '0', 10) } : null;
  }
  function updateCapHint() {
    var hint = document.getElementById('guestCapHint');
    if (!hint) return;
    var r = activeResource();
    hint.textContent = r && r.cap ? r.name + ' fits up to ' + r.cap + ' guests.' : '';
  }
  var numGuestsEl = document.getElementById('numGuests');
  if (numGuestsEl) numGuestsEl.addEventListener('input', updateSummary);

  document.getElementById('nextStep3').addEventListener('click', function () {
    clearFieldErrors(document.getElementById('panel3'));
    var ng = numGuestsEl;
    var n = parseInt(ng.value, 10);
    if (!ng.value || !(n >= 1)) return fieldError(ng, 'Please enter the number of guests (at least 1).');
    if (n > 500) return fieldError(ng, 'Online bookings take up to 500 guests.');
    var r = activeResource();
    if (r && r.cap && n > r.cap) return fieldError(ng, r.name + ' fits up to ' + r.cap + ' guests. Lower the number or choose a larger option.');
    if (contactPhoneInput) {
      var v = contactPhoneInput.value.trim();
      if (!v) return fieldError(contactPhoneInput, 'Please enter your mobile number.');
      if (!contactPhonePattern.test(v)) return fieldError(contactPhoneInput, contactPhoneMessage);
    }
    updateSummary();
    goTo(4);
  });

  /* ── Step 4: payment ────────────────────────────────────────────────── */
  document.getElementById('prevStep4').addEventListener('click', function () { goTo(3); });

  var payCards  = document.querySelectorAll('.pay-card');
  var payRadios = document.querySelectorAll('.pay-card input[type=radio]');
  var instrBox  = document.getElementById('paymentInstructions');
  var instrText = document.getElementById('payInstrText');

  payRadios.forEach(function (radio) {
    radio.addEventListener('change', function () {
      payCards.forEach(function (c) { c.classList.remove('selected'); c.querySelector('.check-icon').classList.add('d-none'); });
      this.closest('.pay-card').classList.add('selected');
      this.closest('.pay-card').querySelector('.check-icon').classList.remove('d-none');
      var tpl = document.getElementById('payInfo-' + this.value);
      instrText.innerHTML = tpl ? tpl.innerHTML : '';
      var method = this.value;
      document.querySelectorAll('[data-pay-qr]').forEach(function (qr) {
        qr.classList.toggle('d-none', qr.getAttribute('data-pay-qr') !== method);
      });
      instrBox.classList.remove('d-none');
      var pe = document.getElementById('paymentMethodsErr'); if (pe) pe.remove();
      updateSummary();
    });
    if (radio.checked) radio.dispatchEvent(new Event('change'));
  });

  // Copy account numbers (falls back to a hidden textarea on plain-http LAN links).
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-copy]');
    if (!b) return;
    var text = b.getAttribute('data-copy');
    function done() {
      if (b.classList.contains('is-copied')) return; var label = b.innerHTML;
      b.textContent = 'Copied'; b.classList.add('is-copied');
      setTimeout(function () { b.innerHTML = label; b.classList.remove('is-copied'); }, 1800);
    }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (err) { notify('Copy failed — please select the number manually.', 'warning'); }
      ta.remove();
    }
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, fallback);
    else fallback();
  });

  /* ═══════════════════════════════════════════════════════════════════════
     SUMMARY BUILDER
     Item, dates, guests, package inclusions, then total / downpayment / balance.
     ═══════════════════════════════════════════════════════════════════════ */
  function row(label, value, cls) {
    return '<div class="sum-row' + (cls ? ' ' + cls : '') + '"><span>' + label + '</span><span>' + value + '</span></div>';
  }
  function updateSummary() {
    var type   = resTypeInput.value;
    var total  = parseFloat(totalHid.value) || 0;
    var dp     = Math.ceil(total * downpaymentPercent / 100);
    var method = document.querySelector('.pay-card input:checked');
    var ng     = parseInt((numGuestsEl || {}).value || 1, 10) || 1;
    var html = '';
    var item = '', sub = '';

    if (!type) {
      document.getElementById('summaryContent').innerHTML = '<div class="sum-empty">Choose what to book to see your total.</div>';
      setMini(0);
      return;
    }

    if (type === 'room') {
      var opt = selOpt(roomSel);
      var ci = (checkIn || {}).value || '', co = (checkOut || {}).value || '';
      if (opt && opt.value) { item = opt.dataset.name || opt.text; sub = 'Room · sleeps up to ' + opt.dataset.cap; }
      html += item ? '<div class="sum-item"><div class="sum-item-name">' + esc(item) + '</div><div class="sum-item-sub">' + esc(sub) + '</div></div>' : row('Type', 'Room');
      if (ci) html += row('Check-in', esc(fmtDate(ci)));
      if (co) html += row('Check-out', esc(fmtDate(co)));
      var nights2 = ci && co ? Math.round((new Date(co) - new Date(ci)) / 86400000) : 0;
      if (opt && opt.value && opt.dataset.price) {
        html += nights2 > 0
          ? row(fmtPrice(opt.dataset.price) + ' × ' + nights2 + ' night' + (nights2 === 1 ? '' : 's'), fmt(parseFloat(opt.dataset.price) * nights2), 'sum-line')
          : row('Rate', fmtPrice(opt.dataset.price) + ' / night');
      }

    } else if (type === 'cottage') {
      var copt = selOpt(cottageSel);
      var cd2 = (cottageDateEl || {}).value || '';
      var cst2 = (cottageStartEl || {}).value || '', cet2 = (cottageEndEl || {}).value || '';
      if (copt && copt.value) { item = copt.dataset.name || copt.text; sub = 'Cottage · up to ' + copt.dataset.cap + ' guests'; }
      html += item ? '<div class="sum-item"><div class="sum-item-name">' + esc(item) + '</div><div class="sum-item-sub">' + esc(sub) + '</div></div>' : row('Type', 'Cottage');
      if (cd2) html += row('Date', esc(fmtDate(cd2)));
      if (cst2 && cet2) html += row('Time', esc(fmtTime(cst2) + ' – ' + fmtTime(cet2)));
      if (copt && copt.value && copt.dataset.price) html += row('Flat rate (any hours)', fmt(copt.dataset.price), 'sum-line');

    } else {
      var vopt = selOpt(venueSel), popt = selOpt(pkgSelect);
      var hasPkg = popt && popt.value, hasVenue = vopt && vopt.value;
      if (hasPkg) { item = popt.dataset.name || popt.text; sub = 'Event package'; }
      else if (hasVenue) { item = vopt.dataset.name || vopt.text; sub = 'Venue'; }
      html += item ? '<div class="sum-item"><div class="sum-item-name">' + esc(item) + '</div><div class="sum-item-sub">' + esc(sub) + '</div></div>' : row('Type', TYPE_LABEL[type] || 'Event');
      if (hasVenue) {
        html += hasPkg
          ? row('Venue', esc(vopt.dataset.name || '') + ' · ' + fmtPrice(vopt.dataset.price || 0))
          : row('Venue fee (flat rate)', fmt(vopt.dataset.price || 0), 'sum-line');
      }
      if (hasPkg) {
        html += row('Package price', fmt(parseFloat(popt.dataset.price) || 0), 'sum-line');
        var pkg = pkgData[String(pkgSelect.value)];
        if (pkg) {
          var activeDefaults = (pkg.defaults || []).filter(function (inc) { return !removedDefaults[inc.name]; });
          if (activeDefaults.length > 0) {
            html += row('Included in the price', activeDefaults.length + ' item' + (activeDefaults.length === 1 ? '' : 's'));
          }
          var removedKeys = Object.keys(removedDefaults);
          if (removedKeys.length > 0) {
            html += '<p class="sum-label">Removed (no price change)</p>';
            removedKeys.forEach(function (name) { html += '<div class="summary-inclusion is-removed"><span>' + esc(name) + '</span><span></span></div>'; });
          }
          var addonKeys = Object.keys(selectedAddons);
          if (addonKeys.length > 0) {
            html += '<p class="sum-label">Add-ons (added to the total)</p>';
            addonKeys.forEach(function (name) { html += '<div class="summary-inclusion sum-line"><span>' + esc(name) + '</span><span>+' + fmt(selectedAddons[name]) + '</span></div>'; });
          }
        }
      }
      if (customInclusions.length > 0) {
        html += '<p class="sum-label">Your requests (staff will confirm)</p>';
        customInclusions.forEach(function (ci2) { html += '<div class="summary-inclusion"><span>' + esc(ci2.name) + '</span><span>Noted</span></div>'; });
      }
      var ed = (document.getElementById('eventDate') || {}).value || '';
      var est2 = (document.getElementById('eventStartTime') || {}).value || '', eet2 = (document.getElementById('eventEndTime') || {}).value || '';
      if (ed) html += row('Event date', esc(fmtDate(ed)));
      if (est2 && eet2) html += row('Time', esc(fmtTime(est2) + ' – ' + fmtTime(eet2)));
    }

    html += row('Guests', String(ng));
    if (method) html += row('Payment', { gcash: 'GCash', maya: 'Maya', bank_transfer: 'Bank transfer' }[method.value] || esc(method.value));

    if (total > 0) {
      html += '<div class="sum-totals">';
      html += row('Total', fmt(total), 'sum-total');
      html += row('Downpayment to pay (' + downpaymentPercent + '%)', fmt(dp), 'sum-dp');
      html += row('Balance at the resort', fmt(total - dp));
      html += '<p class="sum-pay-note">Paid by GCash, Maya or bank transfer after you submit. Staff verify your proof before the booking is confirmed.</p>';
      html += '</div>';
    } else {
      html += '<div class="sum-empty">Your total appears once you choose an option' + (type === 'room' ? ' and dates' : '') + '.</div>';
    }

    var ao = selOpt(type === 'room' ? roomSel : type === 'cottage' ? cottageSel : venueSel);
    var aImgs = [];
    try { aImgs = JSON.parse(decodeURIComponent((ao && ao.value && ao.dataset.images) || '%5B%5D')); } catch (e) { aImgs = []; }
    if (aImgs && aImgs.length) html = '<div class="sum-photo pt-photo"><img src="' + esc(sized(aImgs[0], 800)) + '" alt="" /></div>' + html;

    document.getElementById('summaryContent').innerHTML = html;
    setMini(total, dp);
    checkAvailability();
    document.querySelectorAll('[data-sum="dp"]').forEach(function (el) { el.textContent = total > 0 ? fmt(dp) : 'shown in the summary'; });
  }
  function setMini(total, dp) {
    var mini = document.getElementById('summaryTotalMini');
    if (mini) mini.innerHTML = total > 0 ? '<span>Total ' + fmt(total) + '</span><span class="pt-meta">' + fmt(dp) + ' downpayment</span>' : 'No total yet';
  }

  /* ── Availability: the selected item's booked periods (the same data the date picker shows).
     Explained next to the calendar; the server checks again when the booking is submitted. */
  var roomConflict = '', dayConflict = '';
  function blockedOf(sel) {
    var o = selOpt(sel);
    if (!o || !o.value) return [];
    try { return JSON.parse(o.getAttribute('data-blocked') || '[]'); } catch (e) { return []; }
  }
  function periodText(b, withTimes) {
    var d = b.end && b.end !== b.start ? fmtDate(b.start) + ' – ' + fmtDate(b.end) : fmtDate(b.start);
    return withTimes ? d + (b.from && b.to ? ', ' + fmtTime(b.from) + ' – ' + fmtTime(b.to) : ' (whole day)') : d;
  }
  function checkAvailability() {
    var old = document.getElementById('availWarn'); if (old) old.remove();
    roomConflict = ''; dayConflict = '';
    var t = resTypeInput.value, o, msg = '', anchor = null, ok = false;
    if (t === 'room') {
      o = selOpt(roomSel);
      var ci = checkIn && checkIn.value, co = checkOut && checkOut.value;
      if (!o || !o.value || !ci || !co || co <= ci) return;
      var hits = blockedOf(roomSel).filter(function (b) { return b.start < co && b.end > ci; });
      if (!hits.length) return;
      roomConflict = (o.dataset.name || 'This room') + ' is already booked for some of these nights. Choose other dates or another room.';
      msg = roomConflict + ' Booked: ' + hits.map(function (b) { return periodText(b, false); }).join('; ') + '.';
      anchor = document.getElementById('roomCal');
    } else if (t === 'cottage' || t === 'venue' || t === 'event') {
      var sel = t === 'cottage' ? cottageSel : venueSel;
      var dEl = t === 'cottage' ? cottageDateEl : document.getElementById('eventDate');
      var sEl = t === 'cottage' ? cottageStartEl : document.getElementById('eventStartTime');
      var eEl = t === 'cottage' ? cottageEndEl : document.getElementById('eventEndTime');
      o = selOpt(sel);
      if (!o || !o.value || !dEl || !dEl.value) return;
      var d = dEl.value, st = sEl ? sEl.value : '', en = eEl ? eEl.value : '';
      var same = blockedOf(sel).filter(function (b) { return b.start <= d && d <= (b.end || b.start); });
      if (!same.length) return;
      // Same rule as the server: no times on either side means the whole day overlaps.
      var clash = same.filter(function (b) { return !(b.from && b.to) || !(st && en) || (b.from < en && b.to > st); });
      var list = same.map(function (b) { return b.from && b.to ? fmtTime(b.from) + ' – ' + fmtTime(b.to) : 'the whole day'; }).join(', ');
      if (clash.length) {
        dayConflict = (o.dataset.name || 'This place') + ' is already booked on ' + fmtDate(d) + ' (' + list + '). Choose hours that don’t overlap, or another date.';
        msg = dayConflict;
      } else {
        ok = true;
        msg = (o.dataset.name || 'This place') + ' has other bookings on ' + fmtDate(d) + ' (' + list + '). Your hours don’t overlap them.';
      }
      anchor = document.getElementById(t === 'cottage' ? 'cottageCal' : 'eventCal');
    }
    if (!msg || !anchor) return;
    var box = document.createElement('div');
    box.id = 'availWarn'; box.className = ok ? 'field-warn field-ok' : 'field-warn'; box.setAttribute('role', 'status');
    box.innerHTML = '<i class="fas ' + (ok ? 'fa-circle-info' : 'fa-exclamation-triangle') + '" aria-hidden="true"></i><span>' + esc(msg) + '</span>';
    anchor.insertAdjacentElement('afterend', box);
  }

  /* ── Item photo gallery ─────────────────────────────────────────────── */
  var galleryWrap   = document.getElementById('itemGallery');
  var galleryThumbs = document.getElementById('itemGalleryThumbs');
  var itemCard = document.getElementById('itemCard');
  function renderItemCard(selectEl, imgs) {
    if (!itemCard) return;
    var opt = selOpt(selectEl);
    if (!opt || !opt.value) { itemCard.hidden = true; itemCard.innerHTML = ''; return; }
    var t = resTypeInput.value, cap = opt.dataset.cap;
    var photo = imgs && imgs.length
      ? '<img src="' + esc(sized(imgs[0], 320)) + '" alt="' + esc(opt.dataset.name || '') + '" />'
      : '<div class="photo-pending"><i class="far fa-image" aria-hidden="true"></i>Photos coming soon</div>';
    itemCard.innerHTML = '<div class="sel-item-photo pt-photo">' + photo + '</div>' +
      '<div class="sel-item-body"><p class="sel-item-name">' + esc(opt.dataset.name || opt.text) + '</p>' +
      '<p class="sel-item-facts">' + (cap ? (t === 'room' ? 'Sleeps ' + esc(cap) : 'Up to ' + esc(cap) + ' guests') + ' · ' : '') +
      (t === 'event' && opt.value === packageHallId() ? '<strong>Included in the package</strong>' : '<strong>' + fmtPrice(opt.dataset.price) + '</strong> ' + (t === 'room' ? 'per night' : 'per booking')) + '</p>' +
      (t === 'cottage' ? '<p class="pt-meta mb-0">Flat rate — the same whatever times you choose.</p>' : '') + '</div>' +
      (selectEl.classList.contains('is-locked-select') ? '<span class="sel-item-lock"><i class="fas fa-lock" aria-hidden="true"></i>Locked</span>' : '');
    itemCard.classList.toggle('is-locked', selectEl.classList.contains('is-locked-select'));
    itemCard.hidden = false;
  }
  function renderGallery(selectEl) {
    if (!galleryWrap || !galleryThumbs) return;
    var opt = selOpt(selectEl);
    var imgs = [];
    try { imgs = JSON.parse(decodeURIComponent((opt && opt.value && opt.dataset && opt.dataset.images) || '%5B%5D')); } catch (e) { imgs = []; }
    renderItemCard(selectEl, imgs);
    if (!imgs || imgs.length < 2) { galleryWrap.classList.add('d-none'); galleryThumbs.innerHTML = ''; return; }
    var name = opt.dataset.name || '';
    galleryThumbs.innerHTML = imgs.map(function (src, i) {
      return '<button type="button" data-book-photo="' + esc(src) + '" aria-label="Enlarge photo ' + (i + 1) + ' of ' + esc(name) + '">' +
        '<img src="' + esc(sized(src, 320)) + '" alt="" loading="lazy" /></button>';
    }).join('');
    galleryWrap.classList.remove('d-none');
  }
  function renderGalleryForType() {
    var t = resTypeInput.value;
    renderGallery(t === 'room' ? roomSel : t === 'cottage' ? cottageSel : (t === 'venue' || t === 'event') ? venueSel : null);
  }
  ['roomSelect','cottageSelect','venueSelect'].forEach(function (id) {
    var sel = document.getElementById(id);
    if (sel) sel.addEventListener('change', function () { renderGallery(sel); updateCapHint(); });
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-book-photo]');
    if (b) openBookLightbox(b.getAttribute('data-book-photo'));
  });

  /* ── Form submit guard + confirmation modal ─────────────────────────── */
  var bookingForm = document.getElementById('bookingForm');
  // Opt this form out of main.js's global "Processing…" double-submit handler,
  // which otherwise disabled the button while we only opened the confirm modal.
  bookingForm.setAttribute('data-no-autosubmit-lock', '1');

  // Validate Step-4 fields. Returns true when the booking is ready to submit.
  function validateBooking() {
    clearFieldErrors(document.getElementById('panel4'));
    if (!document.querySelector('.pay-card input:checked')) {
      return fieldError(document.getElementById('paymentMethods'), 'Please choose a payment method.');
    }
    var agree = document.getElementById('agreeTerms');
    if (!agree.checked) {
      return fieldError(agree, 'Please agree to the booking terms to continue.', agree.closest('.form-check'));
    }
    if (!totalHid.value || parseFloat(totalHid.value) <= 0) {
      notify('We could not work out the booking total. Please go back and check your selection and dates.', 'warning');
      return false;
    }
    return true;
  }

  // Keep entries if the server sends the guest back with an error (e.g. dates just taken).
  var DRAFT_KEY = 'br-book-draft';
  var DRAFT_FIELDS = ['reservationType','roomSelect','checkInDate','checkOutDate','cottageSelect','cottageDate','cottageStartTime','cottageEndTime',
                      'venueSelect','packageSelect','eventDate','eventStartTime','eventEndTime','numGuests','contactPhone','specialRequests'];
  function saveDraft() {
    try {
      var d = {};
      DRAFT_FIELDS.forEach(function (id) { var el = document.getElementById(id); if (el) d[id] = el.value; });
      var m = document.querySelector('.pay-card input:checked'); d.payment_method = m ? m.value : '';
      sessionStorage.setItem(DRAFT_KEY, JSON.stringify(d));
    } catch (e) { /* storage unavailable */ }
  }

  // Consolidate per-section fields into the canonical POST fields, then submit.
  // Uses form.submit() (not requestSubmit) so it bypasses the submit-event
  // guards entirely and always posts exactly once.
  function finalizeAndSubmit() {
    var type = resTypeInput.value;
    var form = bookingForm;
    saveDraft();

    function setHidden(name, value) {
      var el = form.querySelector('input[type=hidden][name="' + name + '"]');
      if (!el) { el = document.createElement('input'); el.type = 'hidden'; el.name = name; form.appendChild(el); }
      el.value = value || '';
    }
    // Fields of the types NOT being booked must not post (a stale room id or package would change the booking).
    function disableWithin(id) {
      var box = document.getElementById(id);
      if (box) box.querySelectorAll('input, select, textarea').forEach(function (f) { f.disabled = true; });
    }

    // Package requests and removed inclusions go to the special requests so staff see them.
    var notes = [];
    if ((type === 'venue' || type === 'event') && pkgSelect && pkgSelect.value) {
      var removed = Object.keys(removedDefaults);
      if (removed.length) notes.push('Remove from package: ' + removed.join(', '));
      if (customInclusions.length) notes.push('Package requests: ' + customInclusions.map(function (c) { return c.name; }).join(', '));
    } else if ((type === 'venue' || type === 'event') && customInclusions.length) {
      notes.push('Event requests: ' + customInclusions.map(function (c) { return c.name; }).join(', '));
    }
    if (notes.length) {
      var sr = document.getElementById('specialRequests');
      sr.value = (sr.value ? sr.value.trim() + '\n' : '') + notes.join('\n');
    }

    if (type === 'room') {
      disableWithin('cottageFields');
      disableWithin('venueFields');
    } else if (type === 'cottage') {
      var cs = document.getElementById('cottageSelect');
      var cd = document.getElementById('cottageDate');
      var cst = document.getElementById('cottageStartTime');
      var cet = document.getElementById('cottageEndTime');
      setHidden('item_id',        cs ? cs.value : '');
      setHidden('check_in_date',  cd ? cd.value : '');
      setHidden('start_time',     cst ? cst.value : '');
      setHidden('end_time',       cet ? cet.value : '');
      disableWithin('roomFields');
      disableWithin('venueFields');
      disableWithin('cottageFields');
    } else if (type === 'venue' || type === 'event') {
      var vs = document.getElementById('venueSelect');
      var ed = document.getElementById('eventDate');
      setHidden('item_id',     vs ? vs.value : '');
      setHidden('event_date',  ed ? ed.value : '');
      if (vs) vs.disabled = true;
      disableWithin('roomFields');
      disableWithin('cottageFields');
    }

    if (type === 'venue' || type === 'event') syncHiddenInputs();
    else hiddenInputsDiv.innerHTML = '';

    var btn = document.getElementById('submitBooking');
    if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Submitting…'; }

    form.submit();   // native submit — does NOT re-fire the submit event
  }

  // The visible "Submit booking" button first validates, then opens the modal.
  bookingForm.addEventListener('submit', function (e) {
    e.preventDefault();          // never submit directly from the form button
    if (currentStep !== 4) return;
    if (!validateBooking()) return;
    showBookingConfirm();
  });

  /* ── Min dates ──────────────────────────────────────────────────────── */
  var today = localToday();
  ['checkInDate','checkOutDate','eventDate','cottageDate'].forEach(function (id) {
    var el = document.getElementById(id); if (el) el.min = today;
  });
  if (checkIn) checkIn.addEventListener('change', function () {
    if (checkOut) { checkOut.min = this.value || today; if (checkOut.value && checkOut.value <= this.value) checkOut.value = ''; calcRoomPrice(); }
  });

  /* ── Booking confirmation modal ─────────────────────────────────────── */
  window.showBookingConfirm = function () {
    // Build a readable summary from the live summary content.
    var summaryHtml = document.getElementById('summaryContent') ? document.getElementById('summaryContent').innerHTML : '';
    var body = document.getElementById('bookingConfirmBody');
    if (body) body.innerHTML = summaryHtml || '<p class="text-muted">Please review your booking details.</p>';
    var modalEl = document.getElementById('bookingConfirmModal');
    if (window.bootstrap && modalEl) {
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    } else if (window.confirmModal) {
      // Fallback: professional confirm modal from main.js
      window.confirmModal({ title: 'Submit your booking?', message: 'Your booking is confirmed only after you pay the downpayment and staff verify your proof.', okText: 'Submit booking' })
        .then(function (ok) { if (ok) finalizeAndSubmit(); });
    } else if (confirm('Submit this booking?')) {
      finalizeAndSubmit();
    }
  };
  // NOTE: the confirmation & terms modals are rendered AFTER this inline script
  // in the document, so their buttons don't exist yet when this runs. Use
  // delegated listeners on document so the clicks are always caught.
  document.addEventListener('click', function (e) {
    // Confirm & Submit Booking
    if (e.target.closest('#bookingConfirmProceed')) {
      e.preventDefault();
      var modalEl = document.getElementById('bookingConfirmModal');
      if (window.bootstrap && modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).hide();
      finalizeAndSubmit();
      return;
    }
    // "I understand and agree" in the Terms modal ticks the agreement checkbox.
    if (e.target.closest('#termsAgreeBtn')) {
      var cb = document.getElementById('agreeTerms');
      if (cb) { cb.checked = true; cb.dispatchEvent(new Event('change', { bubbles: true })); }
    }
  });

  /* ── Simple lightbox for booking-page photos ────────────────────────── */
  window.openBookLightbox = function (src) {
    var lb = document.getElementById('bookLightbox');
    if (!lb) return;
    document.getElementById('bookLightboxImg').src = src;
    lb.classList.add('open'); lb.hidden = false;
    document.body.style.overflow = 'hidden';
    var c = document.getElementById('bookLightboxClose'); if (c) c.focus();
  };
  window.closeBookLightbox = function () {
    var lb = document.getElementById('bookLightbox');
    if (!lb || lb.hidden) return;
    lb.classList.remove('open'); lb.hidden = true;
    document.getElementById('bookLightboxImg').src = '';
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBookLightbox(); });
  document.addEventListener('click', function (e) {
    if (e.target.closest('#bookLightboxClose') || e.target.id === 'bookLightbox') closeBookLightbox();
  });

  /* ── Initial state ──────────────────────────────────────────────────── */
  var flashError = document.querySelector('#portalFlash .alert-danger');
  var draft = null;
  try { draft = JSON.parse(sessionStorage.getItem(DRAFT_KEY) || 'null'); } catch (e) { draft = null; }
  if (flashError && draft && !sp.get('type') && !sp.get('item_id')) {
    // Server sent us back with an error: restore what the guest entered.
    DRAFT_FIELDS.forEach(function (id) { var el = document.getElementById(id); if (el && draft[id] != null) el.value = draft[id]; });
    if (draft.payment_method) {
      var r = document.querySelector('.pay-card input[value="' + draft.payment_method + '"]');
      if (r) { r.checked = true; r.dispatchEvent(new Event('change')); }
    }
    if (pkgSelect && pkgSelect.value) renderInclusionsPanel(pkgSelect.value);
  }
  try { sessionStorage.removeItem(DRAFT_KEY); } catch (e) {}

  /* ── Date pickers: write into the native date inputs (names / ids unchanged) ── */
  var pickers = {};
  if (window.BrDatePicker) {
    pickers.room = BrDatePicker.create(document.getElementById('roomCal'), {
      start: checkIn, end: checkOut, nightly: true, blocked: blockedOf(roomSel), min: today
    });
    pickers.cottage = BrDatePicker.create(document.getElementById('cottageCal'), {
      start: cottageDateEl, blocked: blockedOf(cottageSel), min: today
    });
    pickers.event = BrDatePicker.create(document.getElementById('eventCal'), {
      start: document.getElementById('eventDate'), blocked: blockedOf(venueSel), min: today,
      note: 'Event packages on their own aren’t tied to one room; booked days shown are for the venue you choose.'
    });
    if (roomSel) roomSel.addEventListener('change', function () { if (pickers.room) pickers.room.setBlocked(blockedOf(roomSel)); });
    if (cottageSel) cottageSel.addEventListener('change', function () { if (pickers.cottage) pickers.cottage.setBlocked(blockedOf(cottageSel)); });
    if (venueSel) venueSel.addEventListener('change', function () { if (pickers.event) pickers.event.setBlocked(blockedOf(venueSel)); });
  }
  ['cottageStartTime', 'cottageEndTime'].forEach(function (id) { var el = document.getElementById(id); if (el) el.addEventListener('change', checkAvailability); });

  /* ── Add-ons chosen on the package page (?addon=Name&addon=Name) ────────── */
  var addonsApplied = false;
  function addonsFromUrl() {
    if (addonsApplied) return false;
    addonsApplied = true;
    var names = sp.getAll('addon');
    if (!names.length || !pkgSelect || !pkgSelect.value) return false;
    var n = 0;
    addonGrid.querySelectorAll('.addon-item').forEach(function (card) {
      if (names.indexOf(card.dataset.name) !== -1 && !card.classList.contains('selected')) { card.click(); n++; }
    });
    return n > 0;
  }

  var initialType = resTypeInput.value;
  if (initialType) {
    typeCards.forEach(function (c) {
      var on = c.dataset.type === initialType;
      c.classList.toggle('selected', on); c.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (pkgSelect && pkgSelect.value && !inclusionsPanel.classList.contains('visible')) renderInclusionsPanel(pkgSelect.value);
    updateStep2Fields(initialType);
    updateCapHint();
    if (flashError && draft) goTo(2);
    else if (addonsFromUrl()) goTo(2);
    else if (selectionLocked || (initialType === 'event' && pkgSelect && pkgSelect.value)) goTo(2);
  } else {
    updateSummary();
  }
})();
</script>

<%# ── Booking confirmation modal ──────────────────────────────────────── %>
<div class="modal fade" id="bookingConfirmModal" tabindex="-1" aria-labelledby="bookingConfirmTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="bookingConfirmTitle">Submit this booking?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="bookingConfirmBody" class="mb-3"></div>
        <p class="pt-small mb-0">Your booking will be saved as <strong>Awaiting payment</strong> with a BK-YYYY-NNNN reference. It is not paid or confirmed yet — pay the downpayment, upload your proof on the booking page, and staff verify it.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep editing</button>
        <button type="button" class="btn btn-primary" id="bookingConfirmProceed">Yes, submit booking</button>
      </div>
    </div>
  </div>
</div>

<%# ── Booking Terms & Conditions modal ────────────────────────────────── %>
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="termsModalLabel">Booking terms and conditions</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-small" style="line-height:1.6;">
        <p class="text-muted">These terms apply to all reservations made with <strong><%= terms.resortName %></strong>. Please read them carefully before confirming your booking.</p>

        <h3 class="pt-h3 mt-3">1. Reservation &amp; downpayment</h3>
        <p>A reservation is only confirmed once the required downpayment of <strong><%= terms.downpaymentPercent %>%</strong> of the total amount has been paid and verified by our staff. Bookings without a submitted downpayment may be released after 48 hours.</p>

        <h3 class="pt-h3 mt-3">2. Payment</h3>
        <p>Downpayments may be paid via GCash, Maya, or bank transfer. For online payments, you must upload a clear screenshot of your payment receipt. The remaining balance must be settled on or before check-in.</p>

        <h3 class="pt-h3 mt-3">3. Check-in &amp; check-out</h3>
        <p>Standard check-in time is <strong><%= terms.checkInTime %></strong> and check-out time is <strong><%= terms.checkOutTime %></strong>. Early check-in or late check-out is subject to availability and may incur additional charges.</p>

        <h3 class="pt-h3 mt-3">4. Cancellation &amp; refund policy</h3>
        <p><%= terms.cancellationPolicy %></p>
        <p>Approved refunds are processed to your nominated GCash account or through the original payment method, subject to staff review.</p>

        <h3 class="pt-h3 mt-3">5. Guest responsibilities</h3>
        <ul class="mb-2">
          <li>The number of guests must not exceed the stated capacity of the room, cottage, or venue.</li>
          <li>Guests are responsible for any damage to property or facilities during their stay.</li>
          <li>Valid identification may be required upon check-in.</li>
        </ul>

        <h3 class="pt-h3 mt-3">6. Liability</h3>
        <p>The resort is not liable for loss of personal belongings. Guests are advised to secure their valuables. Management reserves the right to refuse service or cancel a reservation for violations of these terms.</p>

        <p class="text-muted mt-3 mb-0">By checking the agreement box, you acknowledge that you have read, understood, and agreed to these terms and conditions.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="termsAgreeBtn" data-bs-dismiss="modal">I understand and agree</button>
      </div>
    </div>
  </div>
</div>

<%# ── Booking-page image lightbox ─────────────────────────────────────── %>
<div id="bookLightbox" class="lb-overlay" role="dialog" aria-modal="true" aria-label="Photo" hidden>
  <button type="button" class="lb-close" id="bookLightboxClose" aria-label="Close photo"><i class="fas fa-times" aria-hidden="true"></i></button>
  <div class="lb-content"><img id="bookLightboxImg" src="" alt="Enlarged photo" /></div>
</div>
