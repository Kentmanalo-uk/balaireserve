<div class="pt-page">
  <div class="pt-page-head">
    <div>
      <h1 class="pt-title">Availability calendar</h1>
      <p class="pt-lede">Marked days already have bookings. Select an open day to start a booking from that date — you'll pick the exact room, cottage, venue or package next, and the booking page checks your dates again.</p>
    </div>
  </div>

  <%include('portal/_catalog-tabs')%>

  <ul class="pt-cal-legend" aria-label="What the colours mean">
    <li><span class="cal-swatch cal-open" aria-hidden="true"></span>No entry — nothing booked yet</li>
    <li><span class="cal-swatch cal-booked" aria-hidden="true"></span>Booked</li>
    <li><span class="cal-swatch cal-pencil" aria-hidden="true"></span>Pencil booking (tentative, dates held)</li>
    <li><span class="cal-swatch cal-hold" aria-hidden="true"></span>On hold (dates held)</li>
  </ul>

  <div class="pt-surface pt-calendar">
    <div id="portalCalendar"></div>
  </div>
  <p class="pt-small text-muted mt-3 mb-2">Each entry names what's booked, so a marked day can still have other rooms or cottages free. The list view shows one line per booking — handy on a phone.</p>
  <a href="/portal/book" class="btn btn-secondary-quiet">Start a booking</a>
</div>

<script src="/vendor/fullcalendar.min.js"></script>
<script>
(function () {
  var el = document.getElementById('portalCalendar');
  if (!el || typeof FullCalendar === 'undefined') return;

  function toISO(d) {
    // Local date -> YYYY-MM-DD (avoids UTC off-by-one).
    var y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0'), day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  var today = new Date(); today.setHours(0, 0, 0, 0);
  var mq = window.matchMedia('(max-width: 575.98px)'), narrow = mq.matches;
  // Status colours follow the shared status system; the label stays in the event title.
  var COLORS = { booked: '#0f5c66', pencil: '#5b2a91', on_hold: '#33414f' };

  var calendar = new FullCalendar.Calendar(el, {
    initialView: narrow ? 'listMonth' : 'dayGridMonth',
    height: 'auto',
    firstDay: 0,
    headerToolbar: narrow
      ? { left: 'prev,next', center: 'title', right: 'listMonth,dayGridMonth' }
      : { left: 'prev,next today', center: 'title', right: 'dayGridMonth,listMonth' },
    buttonText: { today: 'Today', month: 'Month', list: 'List' },
    noEventsContent: 'No bookings this month',
    events: '/portal/calendar/feed',
    eventDataTransform: function (ev) {
      var s = ev.extendedProps && ev.extendedProps.status;
      ev.color = COLORS[s] || COLORS.booked;
      return ev;
    },
    displayEventTime: false,
    selectable: false,
    dateClick: function (info) {
      var clicked = new Date(info.date); clicked.setHours(0, 0, 0, 0);
      if (clicked < today) {
        return; // ignore past dates
      }
      // Start a booking prefilled with the chosen check-in date (+1 day checkout).
      var checkin = info.dateStr;
      var co = new Date(info.date); co.setDate(co.getDate() + 1);
      var checkout = toISO(co);
      window.location.href = '/portal/book?checkin=' + encodeURIComponent(checkin) + '&checkout=' + encodeURIComponent(checkout);
    },
  });

  calendar.render();
  // Phones get the day-by-day agenda; follow rotation / resizes across the breakpoint.
  if (mq.addEventListener) mq.addEventListener('change', function (e) { calendar.changeView(e.matches ? 'listMonth' : 'dayGridMonth'); });
})();
</script>
