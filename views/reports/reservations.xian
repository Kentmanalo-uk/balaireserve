<% layout('layouts/main') %>
<%
  const isAdmin = currentUser && currentUser.role === 'admin';
  const exportQs = 'from=' + filters.from + '&to=' + filters.to + '&status=' + filters.status + '&type=' + filters.type;
  const listedValue = (reservations || []).reduce((s, r) => s + Number(r.total_amount || 0), 0);
  const allInPeriod = (statusSummary || []).reduce((s, x) => s + Number(x.cnt || 0), 0);
  const filtered = !!(filters.status || filters.type);
%>
<div class="ap-page rpt-page">

<div class="print-header d-none">
  <div class="print-resort-name"><%= reportBrand.name %></div>
  <div class="print-resort-addr"><%= reportBrand.address %></div>
  <div class="print-report-title">Reservation Report &mdash; <%= filters.from %> to <%= filters.to %></div>
</div>

<div class="page-header no-print">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/reports">Reports</a></li><li class="breadcrumb-item active" aria-current="page">Reservations</li></ol></nav>
    <h1>Reservation report</h1>
    <p class="ap-sub">Bookings created from <strong><%= formatDate(filters.from) %></strong> to <strong><%= formatDate(filters.to) %></strong><%= filtered ? ', filtered by ' + [filters.status && statusLabel(filters.status), filters.type].filter(Boolean).join(' · ') : '' %>.</p>
  </div>
  <div class="page-header-actions rpt-actions">
    <% if (isAdmin) { %>
    <span class="ap-meta rpt-actions-label">Download</span>
    <a href="/reports/export/reservations?format=xlsx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-excel rpt-ic-xlsx" aria-hidden="true"></i>Excel</a>
    <a href="/reports/export/reservations?format=docx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-word rpt-ic-docx" aria-hidden="true"></i>Word</a>
    <a href="/reports/export/reservations?format=csv&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-csv rpt-ic-csv" aria-hidden="true"></i>CSV</a>
    <% } %>
    <button type="button" class="btn btn-outline-secondary btn-print" data-action="print"><i class="fas fa-print" aria-hidden="true"></i>Print</button>
  </div>
</div>

<form method="GET" action="/reports/reservations" class="ap-toolbar no-print" aria-label="Report filters">
  <div class="ap-field"><label for="rptFrom">Booked from</label><input type="date" id="rptFrom" name="from" value="<%= filters.from %>" class="form-control" /></div>
  <div class="ap-field"><label for="rptTo">Booked to</label><input type="date" id="rptTo" name="to" value="<%= filters.to %>" class="form-control" /></div>
  <div class="ap-field"><label for="rptStatus">Status</label><select id="rptStatus" name="status" class="form-select"><option value="">All statuses</option><% for (const s of ['pending','awaiting_payment','confirmed','checked_in','completed','cancelled','no_show']) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% } %></select></div>
  <div class="ap-field"><label for="rptType">Type</label><select id="rptType" name="type" class="form-select"><option value="">All types</option><% for (const t of ['room','venue','event','cottage']) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option><% } %></select></div>
  <div class="ap-toolbar-actions"><button type="submit" class="btn btn-primary">Update report</button></div>
</form>

<div class="ap-kpis" role="group" aria-label="Totals">
  <div class="ap-kpi"><span class="ap-kpi-label">Bookings listed</span><span class="ap-kpi-value"><%= reservations ? reservations.length : 0 %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Booked value (listed)</span><span class="ap-kpi-value"><%= formatPeso(listedValue) %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">All bookings in period</span><span class="ap-kpi-value"><%= allInPeriod %></span><span class="ap-kpi-note">any status or type</span></div>
</div>

<% if (statusSummary && statusSummary.length) { %>
<section class="rpt-status-summary" aria-labelledby="rptStatusHeading">
  <h2 id="rptStatusHeading">By status <span class="ap-meta">(all bookings created in the period)</span></h2>
  <ul>
    <% for (const s of statusSummary) { %>
    <li><%- statusBadge(s.status) %><span class="rpt-count"><%= s.cnt %></span></li>
    <% } %>
  </ul>
</section>
<% } %>

<section class="ap-panel" aria-labelledby="rptListHeading">
  <div class="ap-panel-head"><h2 id="rptListHeading">Bookings <span class="ap-meta"><%= reservations ? reservations.length : 0 %></span></h2></div>
  <% if (!reservations || reservations.length === 0) { %>
  <div class="ap-empty"><strong>No reservations in this period</strong>Try a wider date range or clear the status and type filters.</div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead><tr><th scope="col">Booking</th><th scope="col">Guest</th><th scope="col">Type</th><th scope="col">Stay / event date</th><th scope="col" class="num">Amount</th><th scope="col">Payment</th><th scope="col">Status</th></tr></thead>
      <tbody>
        <% for (const r of reservations) { %>
        <tr>
          <td class="ap-cell-title"><a href="/reservations/<%= r.id %>" class="ap-name text-nowrap"><%= r.booking_ref %></a></td>
          <td data-label="Guest"><%= r.customer_name %></td>
          <td data-label="Type" class="text-capitalize"><%= r.reservation_type %></td>
          <td data-label="Date" class="text-nowrap"><%= formatDate(r.check_in_date || r.event_date) %></td>
          <td class="num" data-label="Amount"><%= formatPeso(r.total_amount) %></td>
          <td data-label="Payment"><%- statusBadge(r.payment_status) %></td>
          <td class="ap-cell-status"><%- statusBadge(r.status) %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<div class="print-footer d-none">Generated by <%= resort.name %> Booking System</div>
</div>
