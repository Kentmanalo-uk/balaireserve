<% layout('layouts/main') %>
<%
  const isAdmin = currentUser && currentUser.role === 'admin';
  const exportQs = 'from=' + filters.from + '&to=' + filters.to;
%>
<div class="ap-page rpt-page">

<div class="print-header d-none">
  <div class="print-resort-name"><%= reportBrand.name %></div>
  <div class="print-resort-addr"><%= reportBrand.address %></div>
  <div class="print-report-title">Event Report &mdash; <%= filters.from %> to <%= filters.to %></div>
</div>

<div class="page-header no-print">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/reports">Reports</a></li><li class="breadcrumb-item active" aria-current="page">Events</li></ol></nav>
    <h1>Event report</h1>
    <p class="ap-sub">Events dated from <strong><%= formatDate(filters.from) %></strong> to <strong><%= formatDate(filters.to) %></strong>.</p>
  </div>
  <div class="page-header-actions rpt-actions">
    <% if (isAdmin) { %>
    <span class="ap-meta rpt-actions-label">Download</span>
    <a href="/reports/export/events?format=xlsx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-excel rpt-ic-xlsx" aria-hidden="true"></i>Excel</a>
    <a href="/reports/export/events?format=docx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-word rpt-ic-docx" aria-hidden="true"></i>Word</a>
    <a href="/reports/export/events?format=csv&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-csv rpt-ic-csv" aria-hidden="true"></i>CSV</a>
    <% } %>
    <button type="button" class="btn btn-outline-secondary btn-print" data-action="print"><i class="fas fa-print" aria-hidden="true"></i>Print</button>
  </div>
</div>

<form method="GET" action="/reports/events" class="ap-toolbar no-print" aria-label="Report period">
  <div class="ap-field"><label for="rptFrom">Event date from</label><input type="date" id="rptFrom" name="from" value="<%= filters.from %>" class="form-control" /></div>
  <div class="ap-field"><label for="rptTo">Event date to</label><input type="date" id="rptTo" name="to" value="<%= filters.to %>" class="form-control" /></div>
  <div class="ap-toolbar-actions"><button type="submit" class="btn btn-primary">Update report</button></div>
</form>

<div class="ap-kpis" role="group" aria-label="Totals for this period">
  <div class="ap-kpi"><span class="ap-kpi-label">Events</span><span class="ap-kpi-value"><%= events.length %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Attendees</span><span class="ap-kpi-value"><%= totalAttendees.toLocaleString() %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Total event cost</span><span class="ap-kpi-value"><%= formatPeso(totalRevenue) %></span></div>
</div>

<section class="ap-panel" aria-labelledby="rptListHeading">
  <div class="ap-panel-head"><h2 id="rptListHeading">Events <span class="ap-meta"><%= events.length %></span></h2></div>
  <% if (!events || events.length === 0) { %>
  <div class="ap-empty"><strong>No events in this period</strong>Try a wider date range.</div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead><tr><th scope="col">Event</th><th scope="col">Customer</th><th scope="col">Type</th><th scope="col">Date</th><th scope="col">Venue</th><th scope="col" class="num">Attendees</th><th scope="col" class="num">Cost</th><th scope="col">Status</th></tr></thead>
      <tbody>
        <% for (const e of events) { %>
        <tr>
          <td class="ap-cell-title"><a href="/events/<%= e.id %>" class="ap-name"><%= e.event_name %></a></td>
          <td data-label="Customer"><%= e.customer_name %></td>
          <td data-label="Type" class="text-capitalize"><%= e.event_type %></td>
          <td data-label="Date" class="text-nowrap"><%= formatDate(e.event_date) %></td>
          <td data-label="Venue"><%= e.venue_name || '—' %></td>
          <td class="num" data-label="Attendees"><%= e.num_attendees %></td>
          <td class="num" data-label="Cost"><%= formatPeso(e.total_cost) %></td>
          <td class="ap-cell-status"><%- statusBadge(e.status) %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<div class="print-footer d-none">Generated by <%= resort.name %> Booking System</div>
</div>
