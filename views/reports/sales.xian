<% layout('layouts/main') %>
<%
  const exportQs = 'from=' + filters.from + '&to=' + filters.to + '&type=' + filters.type;
  const GROUPS = { daily: 'Day', weekly: 'Week', monthly: 'Month', yearly: 'Year' };
%>
<div class="ap-page rpt-page">

<%# Print-only branded header (hidden on screen, shown when printing) %>
<div class="print-header d-none">
  <div class="print-resort-name"><%= reportBrand.name %></div>
  <div class="print-resort-addr"><%= reportBrand.address %></div>
  <div class="print-report-title">Sales Report &mdash; <%= filters.from %> to <%= filters.to %></div>
</div>

<div class="page-header no-print">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/reports">Reports</a></li><li class="breadcrumb-item active" aria-current="page">Sales</li></ol></nav>
    <h1>Sales report</h1>
    <p class="ap-sub">Payments received (recorded or verified) from <strong><%= formatDate(filters.from) %></strong> to <strong><%= formatDate(filters.to) %></strong>, by payment date.</p>
  </div>
  <div class="page-header-actions rpt-actions">
    <span class="ap-meta rpt-actions-label">Download</span>
    <a href="/reports/export/sales?format=xlsx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-excel rpt-ic-xlsx" aria-hidden="true"></i>Excel</a>
    <a href="/reports/export/sales?format=docx&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-word rpt-ic-docx" aria-hidden="true"></i>Word</a>
    <a href="/reports/export/sales?format=csv&<%= exportQs %>" class="btn btn-outline-secondary"><i class="fas fa-file-csv rpt-ic-csv" aria-hidden="true"></i>CSV</a>
    <button type="button" class="btn btn-outline-secondary btn-print" data-action="print"><i class="fas fa-print" aria-hidden="true"></i>Print</button>
  </div>
</div>

<form method="GET" action="/reports/sales" class="ap-toolbar no-print" aria-label="Report period">
  <div class="ap-field"><label for="rptFrom">From</label><input type="date" id="rptFrom" name="from" value="<%= filters.from %>" class="form-control" /></div>
  <div class="ap-field"><label for="rptTo">To</label><input type="date" id="rptTo" name="to" value="<%= filters.to %>" class="form-control" /></div>
  <div class="ap-field"><label for="rptGroup">Group by</label><select id="rptGroup" name="type" class="form-select"><% for (const t of ['daily','weekly','monthly','yearly']) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= GROUPS[t] %></option><% } %></select></div>
  <div class="ap-toolbar-actions"><button type="submit" class="btn btn-primary">Update report</button></div>
</form>

<div class="ap-kpis" role="group" aria-label="Totals for this period">
  <div class="ap-kpi"><span class="ap-kpi-label">Total received</span><span class="ap-kpi-value"><%= formatPeso(totalRevenue) %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Payments</span><span class="ap-kpi-value"><%= totalTxns %></span></div>
  <div class="ap-kpi"><span class="ap-kpi-label">Average payment</span><span class="ap-kpi-value"><%= totalTxns > 0 ? formatPeso(totalRevenue / totalTxns) : '—' %></span></div>
</div>

<div class="rpt-charts">
  <section class="ap-panel" aria-labelledby="rptChartHeading">
    <div class="ap-panel-head"><h2 id="rptChartHeading">Received by <%= labelFormat.toLowerCase() %></h2></div>
    <div class="ap-panel-body">
      <% if (salesData && salesData.length) { %>
      <div class="rpt-chart-box"><canvas id="salesChart" role="img" aria-label="Bar chart of payments received by <%= labelFormat.toLowerCase() %>. The same figures are in the table below."></canvas></div>
      <% } else { %>
      <div class="ap-empty"><strong>No payments in this period</strong>Try a wider date range.</div>
      <% } %>
    </div>
  </section>
  <section class="ap-panel" aria-labelledby="rptTypeHeading">
    <div class="ap-panel-head"><h2 id="rptTypeHeading">By booking type</h2></div>
    <div class="ap-panel-body">
      <% if (byType && byType.length) { %>
      <dl class="ap-amounts">
        <% for (const t of byType) { %>
        <div><dt class="text-capitalize"><%= t.reservation_type %></dt><dd><%= formatPeso(t.total) %></dd></div>
        <% } %>
      </dl>
      <% } else { %>
      <p class="ap-meta mb-0">No payments in this period.</p>
      <% } %>
    </div>
  </section>
</div>

<section class="ap-panel" aria-labelledby="rptDataHeading">
  <div class="ap-panel-head"><h2 id="rptDataHeading">Sales by <%= labelFormat.toLowerCase() %></h2></div>
  <% if (!salesData || salesData.length === 0) { %>
  <div class="ap-empty"><strong>No sales data in this range</strong>Payments appear here once they are recorded or verified.</div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table">
      <thead><tr><th scope="col"><%= labelFormat %></th><th scope="col" class="num">Payments</th><th scope="col" class="num">Received</th></tr></thead>
      <tbody>
        <% for (const d of salesData) { %>
        <tr><td class="fw-semibold"><%= d.period %></td><td class="num"><%= d.transactions %></td><td class="num"><%= formatPeso(d.total) %></td></tr>
        <% } %>
      </tbody>
      <tfoot><tr><th scope="row">Total</th><td class="num"><%= totalTxns %></td><td class="num"><%= formatPeso(totalRevenue) %></td></tr></tfoot>
    </table>
  </div>
  <% } %>
</section>

<%# Print-only footer %>
<div class="print-footer d-none">Generated by <%= resort.name %> Booking System</div>
</div>

<script>
(function () {
  const sd = <%- salesDataJson || '[]' %>;
  const sc = document.getElementById('salesChart');
  if (!sc || !sd.length || typeof Chart === 'undefined') return;
  const peso = v => '₱' + Number(v).toLocaleString('en-PH');
  Chart.defaults.font.family = "Inter, 'Segoe UI', system-ui, sans-serif";
  Chart.defaults.color = '#627174';
  new Chart(sc, {
    type: 'bar',
    data: { labels: sd.map(d => d.period), datasets: [{ label: 'Received', data: sd.map(d => d.total), backgroundColor: '#0f5c66', borderRadius: 4, maxBarThickness: 48 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => peso(c.parsed.y) } } },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, grid: { color: '#e5e9e7' }, border: { display: false }, ticks: { callback: peso } },
      },
    },
  });
})();
</script>
