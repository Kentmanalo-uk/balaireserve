<% layout('layouts/main') %>
<%
  const isAdmin = currentUser && currentUser.role === 'admin';
  const REPORTS = [
    { href: '/reports/sales', title: 'Sales Report', button: 'View Sales Report', icon: 'fa-coins', tone: 'sales', adminOnly: true,
      text: 'Daily, weekly, monthly and yearly sales, with revenue by booking type.' },
    { href: '/reports/reservations', title: 'Reservation Report', button: 'View Reservation Report', icon: 'fa-calendar-check', tone: 'res',
      text: 'All reservations by status, type and date range, with summary totals.' },
    { href: '/reports/events', title: 'Event Report', button: 'View Event Report', icon: 'fa-star', tone: 'event',
      text: 'Event bookings, types, revenue, attendee counts and upcoming events.' },
  ];
  const EXPORTS = [
    { type: 'sales',        label: 'Sales',        note: 'Every payment recorded in the range (by payment date).' },
    { type: 'reservations', label: 'Reservations', note: 'Every booking created in the range.' },
    { type: 'events',       label: 'Events',       note: 'Every event dated in the range.' },
  ];
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Reports</h1>
<!--/page-head-->

<p class="rpt-lede">Generate and export business reports.</p>
<h2 class="visually-hidden">View a report</h2>
<ul class="rpt-cards">
  <% for (const r of REPORTS) { if (r.adminOnly && !isAdmin) continue; %>
  <li class="rpt-card rpt-card--<%= r.tone %>">
    <span class="rpt-card-icon" aria-hidden="true"><i class="fas <%= r.icon %>"></i></span>
    <h3 class="rpt-card-title"><%= r.title %></h3>
    <p class="rpt-card-text"><%= r.text %></p>
    <a href="<%= r.href %>" class="rpt-card-btn"><i class="fas fa-chart-bar" aria-hidden="true"></i><%= r.button %></a>
  </li>
  <% } %>
</ul>

<% if (isAdmin) { %>
<section class="ap-panel" aria-labelledby="rptExportHeading">
  <div class="ap-panel-head">
    <h2 id="rptExportHeading">Export records</h2>
    <span class="ap-meta">Files include the resort name and address. Leave dates empty to export everything up to today.</span>
  </div>
  <div class="rpt-exports">
    <% for (const x of EXPORTS) { %>
    <form method="GET" action="/reports/export/<%= x.type %>" class="rpt-export" data-no-autosubmit-lock aria-labelledby="rptExp<%= x.type %>">
      <h3 id="rptExp<%= x.type %>"><%= x.label %></h3>
      <p class="ap-meta"><%= x.note %></p>
      <div class="rpt-export-dates">
        <div class="ap-field"><label for="<%= x.type %>From">From</label><input type="date" id="<%= x.type %>From" name="from" class="form-control" /></div>
        <div class="ap-field"><label for="<%= x.type %>To">To</label><input type="date" id="<%= x.type %>To" name="to" class="form-control" /></div>
      </div>
      <div class="rpt-export-buttons" role="group" aria-label="Download <%= x.label.toLowerCase() %> as">
        <button type="submit" name="format" value="xlsx" class="btn btn-outline-secondary"><i class="fas fa-file-excel rpt-ic-xlsx" aria-hidden="true"></i>Excel</button>
        <button type="submit" name="format" value="docx" class="btn btn-outline-secondary"><i class="fas fa-file-word rpt-ic-docx" aria-hidden="true"></i>Word</button>
        <button type="submit" name="format" value="csv" class="btn btn-outline-secondary"><i class="fas fa-file-csv rpt-ic-csv" aria-hidden="true"></i>CSV</button>
      </div>
    </form>
    <% } %>
  </div>
</section>
<% } %>

</div>
