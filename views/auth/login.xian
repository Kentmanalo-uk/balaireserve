<% layout('layouts/auth') %>

<% if (errors && errors.length > 0) { %>
<div class="alert alert-danger auth-alert" role="alert">
  <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
  <div><% for (const e of errors) { %><div><%= e.msg %></div><% } %></div>
</div>
<% } %>

<h1 class="auth-title">Sign in</h1>
<p class="auth-subtitle">Guests can book and track their stays. Resort staff sign in to the back office here too.</p>

<form action="/auth/login" method="POST" novalidate class="auth-form">
  <div class="auth-field">
    <label for="email" class="form-label">Email address</label>
    <input type="email" id="email" name="email" class="form-control"
      value="<%= old && old.email ? escape(old.email) : '' %>"
      placeholder="you@example.com" required autocomplete="email" inputmode="email" />
  </div>
  <div class="auth-field">
    <label for="password" class="form-label">Password</label>
    <div class="auth-pass">
      <input type="password" id="password" name="password" class="form-control"
        required autocomplete="current-password" />
      <button type="button" class="auth-pass-toggle" id="togglePass" aria-controls="password" aria-pressed="false" aria-label="Show password">
        <i class="fas fa-eye" aria-hidden="true"></i><span class="auth-pass-label">Show</span>
      </button>
    </div>
  </div>
  <p class="auth-forgot"><a href="/auth/forgot-password">Forgot password?</a></p>
  <button type="submit" class="btn btn-primary btn-auth w-100">Sign in</button>
</form>

<% if (googleLoginEnabled) { %>
<div class="auth-divider"><span>or</span></div>
<a href="/auth/google" class="btn auth-google w-100">
  <i class="fab fa-google" aria-hidden="true"></i>Continue with Google
</a>
<% } %>

<div class="auth-alt">
  <p>New to Balai-Reserve? <a href="/auth/register">Create an account</a></p>
  <p><a href="/portal" class="auth-quiet-link">Browse rooms and venues without signing in</a></p>
</div>

<script>
(function () {
  'use strict';
  var passInput = document.getElementById('password');
  var toggleBtn = document.getElementById('togglePass');
  if (!toggleBtn) return;

  toggleBtn.addEventListener('click', function () {
    var icon = toggleBtn.querySelector('i');
    var label = toggleBtn.querySelector('.auth-pass-label');
    var showPassword = passInput.type === 'password';
    passInput.type = showPassword ? 'text' : 'password';
    icon.classList.toggle('fa-eye', !showPassword);
    icon.classList.toggle('fa-eye-slash', showPassword);
    toggleBtn.setAttribute('aria-pressed', String(showPassword));
    toggleBtn.setAttribute('aria-label', showPassword ? 'Hide password' : 'Show password');
    if (label) label.textContent = showPassword ? 'Hide' : 'Show';
  });
})();
</script>
