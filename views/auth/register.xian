<% layout('layouts/auth') %>
<%
  const errList = errors || [];
  const errFor = (k) => errList.filter(e => (e.path || e.param) === k).map(e => e.msg);
  const invalid = (k) => errFor(k).length ? 'is-invalid' : '';
  const generalErrors = errList.filter(e => !(e.path || e.param));
%>

<% if (errList.length > 0) { %>
<div class="alert alert-danger auth-alert" role="alert">
  <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
  <div>
    <% if (generalErrors.length) { %><% for (const e of generalErrors) { %><div><%= e.msg %></div><% } %>
    <% } else { %><div>Please check the highlighted fields.</div><% } %>
  </div>
</div>
<% } %>

<h1 class="auth-title">Create an account</h1>
<p class="auth-subtitle">Book rooms, cottages and event venues, pay your downpayment online and track every booking in one place.</p>

<form action="/auth/register" method="POST" novalidate class="auth-form">
  <div class="row g-3 mb-3">
    <div class="col-sm-6">
      <label class="form-label" for="regFirstName">First name <span class="auth-req" aria-hidden="true">*</span></label>
      <input type="text" id="regFirstName" name="first_name" class="form-control <%= invalid('first_name') %>"
        value="<%= old && old.first_name ? old.first_name : '' %>"
        required autocomplete="given-name" />
      <% for (const m of errFor('first_name')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
    </div>
    <div class="col-sm-6">
      <label class="form-label" for="regLastName">Last name <span class="auth-req" aria-hidden="true">*</span></label>
      <input type="text" id="regLastName" name="last_name" class="form-control <%= invalid('last_name') %>"
        value="<%= old && old.last_name ? old.last_name : '' %>"
        required autocomplete="family-name" />
      <% for (const m of errFor('last_name')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
    </div>
  </div>
  <div class="auth-field">
    <label class="form-label" for="regEmail">Email address <span class="auth-req" aria-hidden="true">*</span></label>
    <input type="email" id="regEmail" name="email" class="form-control <%= invalid('email') %>"
      value="<%= old && old.email ? old.email : '' %>"
      placeholder="you@example.com" required autocomplete="email" inputmode="email" />
    <% for (const m of errFor('email')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
  </div>
  <div class="auth-field">
    <label class="form-label" for="regPhone">Mobile number <span class="auth-optional">(optional)</span></label>
    <input type="tel" id="regPhone" name="phone" class="form-control <%= invalid('phone') %>"
      value="<%= old && old.phone ? old.phone : '' %>"
      placeholder="09XX XXX XXXX" autocomplete="tel" inputmode="tel" />
    <% for (const m of errFor('phone')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
  </div>
  <div class="auth-field">
    <label class="form-label" for="regPassword">Password <span class="auth-req" aria-hidden="true">*</span></label>
    <div class="auth-pass">
      <input type="password" name="password" id="regPassword" class="form-control <%= invalid('password') %>"
        required minlength="8" autocomplete="new-password" aria-describedby="pwHelp" />
      <button type="button" class="auth-pass-toggle" id="togglePass" aria-controls="regPassword" aria-pressed="false" aria-label="Show password">
        <i class="fas fa-eye" aria-hidden="true"></i><span class="auth-pass-label">Show</span>
      </button>
    </div>
    <div id="pwStrength" class="auth-strength" aria-hidden="true"><div id="pwStrengthBar"></div></div>
    <div class="form-text" id="pwHelp">At least 8 characters. Adding capitals, numbers and symbols makes it stronger.</div>
    <% for (const m of errFor('password')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
  </div>
  <div class="auth-field">
    <label class="form-label" for="regPasswordConfirm">Confirm password <span class="auth-req" aria-hidden="true">*</span></label>
    <input type="password" name="password_confirm" id="regPasswordConfirm" class="form-control <%= invalid('password_confirm') %>"
      required autocomplete="new-password" />
    <div id="pwMatchMsg" class="form-text" aria-live="polite"></div>
    <% for (const m of errFor('password_confirm')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
  </div>
  <div class="form-check auth-check">
    <input class="form-check-input <%= invalid('agree_terms') %>" type="checkbox" id="agreeTerms" name="agree_terms" required <%= old && old.agree_terms ? 'checked' : '' %> />
    <label class="form-check-label" for="agreeTerms">
      I agree to the
      <a href="/terms" target="_blank" rel="noopener">Terms and Conditions<span class="visually-hidden"> (opens in a new tab)</span></a>
      and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy<span class="visually-hidden"> (opens in a new tab)</span></a>
    </label>
    <% for (const m of errFor('agree_terms')) { %><div class="invalid-feedback d-block"><%= m %></div><% } %>
  </div>
  <button type="submit" class="btn btn-primary btn-auth w-100">Create account</button>
</form>

<% if (googleLoginEnabled) { %>
<div class="auth-divider"><span>or</span></div>
<a href="/auth/google" class="btn auth-google w-100">
  <svg class="auth-google-g" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg><span>Sign up with Google</span>
</a>
<% } %>

<div class="auth-alt">
  <p>Already have an account? <a href="/auth/login">Sign in</a></p>
</div>

<script>
(function () {
  'use strict';
  var passInput = document.getElementById('regPassword');
  var toggleBtn = document.getElementById('togglePass');
  var bar = document.getElementById('pwStrengthBar');
  var confirmField = document.getElementById('regPasswordConfirm');
  var matchMsg = document.getElementById('pwMatchMsg');

  toggleBtn.addEventListener('click', function () {
    var icon = toggleBtn.querySelector('i');
    var label = toggleBtn.querySelector('.auth-pass-label');
    var showPassword = passInput.type === 'password';
    passInput.type = showPassword ? 'text' : 'password';
    icon.classList.toggle('fa-eye', !showPassword);
    icon.classList.toggle('fa-eye-slash', showPassword);
    toggleBtn.setAttribute('aria-pressed', String(showPassword));
    toggleBtn.setAttribute('aria-label', showPassword ? 'Hide password' : 'Show password');
    if (label) label.textContent = showPassword ? 'Hide' : 'Show';
  });

  passInput.addEventListener('input', function () {
    var value = passInput.value;
    var score = 0;
    if (value.length >= 8) score++;
    if (/[A-Z]/.test(value)) score++;
    if (/[0-9]/.test(value)) score++;
    if (/[^A-Za-z0-9]/.test(value)) score++;
    bar.style.transform = 'scaleX(' + (score / 4) + ')';
    bar.className = ['', 'is-weak', 'is-fair', 'is-good', 'is-good'][score] || 'is-weak';
  });

  function checkMatch() {
    matchMsg.classList.remove('is-ok', 'is-bad');
    if (!confirmField.value) {
      matchMsg.textContent = '';
    } else if (confirmField.value === passInput.value) {
      matchMsg.classList.add('is-ok');
      matchMsg.textContent = 'Passwords match';
    } else {
      matchMsg.classList.add('is-bad');
      matchMsg.textContent = 'Passwords do not match';
    }
  }

  confirmField.addEventListener('input', checkMatch);
  passInput.addEventListener('input', checkMatch);
})();
</script>
