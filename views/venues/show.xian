<% layout('layouts/main') %>
<% const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff'); %>
<div class="ap-page cat-show">

<!--page-head-->
<a href="/venues" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Venues</a>
<h1 class="ph-title"><%= venue.name %></h1>
<% if (canManage) { %>
  <div class="ph-actions">
    <a href="/stay/venue/<%= venue.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public venue page in a new tab</span></a>
    <a href="/venues/<%= venue.id %>/edit" class="btn btn-secondary-quiet"><i class="fas fa-pen" aria-hidden="true"></i>Edit venue</a>
  </div>
  <% } %>
<!--/page-head-->
<div class="page-meta"><%= statusLabel(venue.venue_type) %> · up to <%= venue.capacity %> guests · <%- statusBadge(venue.status) %></div>

<div class="ap-split">
  <div class="cat-main">
    <%# Photos: one large image, the rest as smaller tiles; click to view uncropped %>
    <div class="cat-gallery<%= venue.imagesList && venue.imagesList.length === 1 ? ' is-single' : '' %>">
      <% if (venue.imagesList && venue.imagesList.length > 0) { %>
        <% for (let i = 0; i < venue.imagesList.length; i++) { %>
        <button type="button" class="cat-photo" data-lightbox="<%= venue.imagesList[i] %>" data-lightbox-title="<%= venue.name %> — photo <%= i + 1 %>" aria-label="View photo <%= i + 1 %> of <%= venue.imagesList.length %> full size">
          <img src="<%= venue.imagesList[i] %>" alt="<%= venue.name %> photo <%= i + 1 %>" <%- i > 0 ? 'loading="lazy"' : '' %> />
        </button>
        <% } %>
      <% } else { %>
        <div class="photo-pending"><i class="fas fa-image" aria-hidden="true"></i><span>Photos coming soon</span></div>
      <% } %>
    </div>

    <section class="ap-panel" aria-labelledby="venueHistoryHeading">
      <div class="ap-panel-head"><h2 id="venueHistoryHeading">Booking history <span class="ap-meta">latest 10</span></h2></div>
      <% if (!reservations || reservations.length === 0) { %>
      <div class="ap-empty"><strong>No bookings yet</strong>Bookings that include this venue will appear here.</div>
      <% } else { %>
      <div class="ap-table-wrap">
        <table class="table-br ap-table ap-stack">
          <thead><tr><th scope="col">Booking</th><th scope="col">Date</th><th scope="col" class="num">Amount</th><th scope="col">Status</th></tr></thead>
          <tbody>
            <% for (const r of reservations) { %>
            <tr>
              <td class="ap-cell-title"><a href="/reservations/<%= r.id %>" class="ap-name"><%= r.customer_name %></a><span class="ap-line2 ap-code"><%= r.booking_ref %></span></td>
              <td data-label="Date" class="text-nowrap"><%= formatDate(r.event_date || r.check_in_date) %></td>
              <td class="num" data-label="Amount"><%= formatPeso(r.total_amount) %></td>
              <td class="ap-cell-status"><%- statusBadge(r.status) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </div>

  <aside class="cat-aside">
    <section class="ap-panel" aria-labelledby="venueDetailsHeading">
      <div class="ap-panel-head"><h2 id="venueDetailsHeading">Venue details</h2></div>
      <div class="ap-panel-body">
        <p class="cat-price mb-1"><%= formatPeso(venue.price) %> <small>/ event</small></p>
        <% if (venue.price_note) { %><p class="ap-meta mb-3"><%= venue.price_note %></p><% } else { %><div class="mb-3"></div><% } %>
        <dl class="ap-dl">
          <dt>Type</dt><dd><%= statusLabel(venue.venue_type) %></dd>
          <dt>Capacity</dt><dd><%= venue.capacity %> guests</dd>
          <dt>Location</dt><dd><%= venue.location || '—' %></dd>
          <dt>Status</dt><dd><%- statusBadge(venue.status) %></dd>
        </dl>
        <% if (venue.description) { %>
        <h3 class="cat-subhead">Description</h3>
        <p class="cat-desc-text"><%= venue.description %></p>
        <% } %>
        <% if (venue.amenitiesList && venue.amenitiesList.length > 0) { %>
        <h3 class="cat-subhead">Amenities</h3>
        <ul class="cat-amenities">
          <% for (const a of venue.amenitiesList) { %><li><%= a %></li><% } %>
        </ul>
        <% } %>
      </div>
    </section>
  </aside>
</div>

</div>
<script>
// A photo whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-photo > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'cat-photo photo-pending';
    box.textContent = 'Photo unavailable';
    img.closest('.cat-photo').replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
