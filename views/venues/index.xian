<% layout('layouts/main') %>
<%
  const canManage = currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff');
  const filtered  = !!(filters.search || filters.type);
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">Venues</h1>
<% if (canManage) { %>
  <div class="ph-actions">
    <a href="/venues/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i>Add venue</a>
  </div>
  <% } %>
<!--/page-head-->

<form method="GET" action="/venues" class="ap-toolbar" role="search" aria-label="Filter venues">
  <div class="ap-field ap-field-search">
    <label for="venueSearch">Search</label>
    <div class="ap-search"><i class="fas fa-search" aria-hidden="true"></i><input type="text" id="venueSearch" name="search" value="<%= filters.search %>" class="form-control" placeholder="Venue name or description" /></div>
  </div>
  <div class="ap-field">
    <label for="venueTypeFilter">Type</label>
    <select id="venueTypeFilter" name="type" class="form-select">
      <option value="">All types</option>
      <% for (const t of venueTypes) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= statusLabel(t) %></option><% } %>
    </select>
  </div>
  <div class="ap-toolbar-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filtered) { %><a href="/venues" class="btn btn-outline-secondary">Clear</a><% } %>
  </div>
</form>

<section class="ap-panel" aria-labelledby="venuesHeading">
  <div class="ap-panel-head">
    <h2 id="venuesHeading">All venues <span class="ap-meta"><%= pagination.total %> venue<%= pagination.total === 1 ? '' : 's' %><%= filtered ? ' match' : '' %></span></h2>
  </div>
  <% if (!venues || venues.length === 0) { %>
  <div class="ap-empty">
    <strong><%= filtered ? 'No venues match these filters' : 'No venues yet' %></strong>
    <%= filtered ? 'Try a different search or clear the filters.' : 'Add the function spaces guests can book for events.' %>
    <% if (filtered) { %><div><a href="/venues" class="btn btn-outline-secondary btn-sm">Clear filters</a></div><% } else if (canManage) { %><div><a href="/venues/new" class="btn btn-primary btn-sm">Add venue</a></div><% } %>
  </div>
  <% } else { %>
  <div class="ap-table-wrap">
    <table class="table-br ap-table ap-stack">
      <thead>
        <tr>
          <th scope="col">Venue</th>
          <th scope="col" class="cat-col-opt">Type</th>
          <th scope="col" class="num">Capacity</th>
          <th scope="col" class="num">Rate / event</th>
          <th scope="col">On website</th>
          <th scope="col" class="text-end"><span class="br-sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const v of venues) { %>
        <tr>
          <td class="ap-cell-title">
            <div class="cat-item">
              <div class="cat-thumb">
                <% if (v.imagesList && v.imagesList.length > 0) { %>
                <img src="<%= v.imagesList[0] %>" alt="" loading="lazy" />
                <% } else { %>
                <div class="photo-pending"><span>Photos coming soon</span></div>
                <% } %>
              </div>
              <div class="cat-item-text">
                <a href="/venues/<%= v.id %>" class="ap-name"><%= v.name %></a>
                <% if (v.location) { %><span class="ap-line2"><%= v.location %></span><% } %>
              </div>
            </div>
          </td>
          <td class="cat-col-opt" data-label="Type"><%= statusLabel(v.venue_type) %></td>
          <td class="num" data-label="Capacity"><%= v.capacity %> guests</td>
          <td class="num" data-label="Rate / event"><strong><%= formatPeso(v.price) %></strong></td>
          <td data-label="On website"><%include('partials/listing-controls', Object.assign({}, __locals, { lc: { row: v, base: '/venues', part: 'state', canManage } }))%></td>
          <td class="ap-row-actions">
            <div class="ap-actions">
              <a href="/venues/<%= v.id %>" class="ap-act">View</a>
              <% if (canManage) { %><a href="/venues/<%= v.id %>/edit" class="ap-act">Edit</a><% } %>
              <%include('partials/listing-controls', Object.assign({}, __locals, { lc: { row: v, base: '/venues', part: 'actions', canManage } }))%>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %><div class="ap-panel-foot"><%include('partials/pagination')%></div><% } %>
  <% } %>
</section>

</div>
<script>
// A thumbnail whose file is missing shows the honest empty state instead of a broken image.
document.querySelectorAll('.cat-thumb > img').forEach(function (img) {
  function swap() {
    var box = document.createElement('div');
    box.className = 'photo-pending';
    box.textContent = 'Photo unavailable';
    img.replaceWith(box);
  }
  if (img.complete && img.naturalWidth === 0) swap(); else img.addEventListener('error', swap);
});
</script>
