<% layout('layouts/main') %>
<% const hasPhotos = venue && venue.imagesList && venue.imagesList.length > 0; %>
<div class="ap-page">

<!--page-head-->
<a href="/venues" class="ph-back"><i class="fas fa-arrow-left" aria-hidden="true"></i>Venues</a>
<h1 class="ph-title"><%= venue ? 'Edit ' + venue.name : 'Add New Venue' %></h1>
<% if (venue) { %><div class="ph-actions"><a href="/stay/venue/<%= venue.id %>" class="btn btn-secondary-quiet" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>Guest view<span class="visually-hidden"> — opens the public venue page in a new tab</span></a></div><% } %>
<!--/page-head-->
<p class="page-intro">Changes to the rate, description and photos show on the public website and guest portal as soon as you save.</p>

<% if (errors && errors.length > 0) { %>
<div class="alert alert-danger ap-errors" role="alert">
  <strong>Please fix the following:</strong>
  <ul><% for (const e of errors) { %><li><%= e.msg %></li><% } %></ul>
</div>
<% } %>

<form data-guard="this venue" action="<%= venue ? '/venues/' + venue.id + '/edit' : '/venues' %>" method="POST" enctype="multipart/form-data" id="venueForm" class="ap-form">

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Venue</h2>
      <p>What the space is and where guests will find it.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label required" for="venueName">Venue name</label>
          <input type="text" name="name" id="venueName" class="form-control" value="<%= old.name || '' %>" required />
        </div>
        <div class="col-md-4">
          <label class="form-label required" for="venueType">Type</label>
          <select name="venue_type" id="venueType" class="form-select" required>
            <option value="">Select…</option>
            <% for (const t of venueTypes) { %><option value="<%= t %>" <%= (old.venue_type || '') === t ? 'selected' : '' %>><%= statusLabel(t) %></option><% } %>
          </select>
        </div>
        <div class="col-md-8">
          <label class="form-label" for="venueLocation">Location <span class="ap-meta fw-normal">(optional)</span></label>
          <input type="text" name="location" id="venueLocation" class="form-control" value="<%= old.location || '' %>" placeholder="e.g. Beside the main pool" />
        </div>
        <div class="col-md-4">
          <label class="form-label" for="venueStatus">Status</label>
          <select name="status" id="venueStatus" class="form-select">
            <% for (const s of ['available','reserved','maintenance','unavailable']) { %><option value="<%= s %>" <%= (old.status || 'available') === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% } %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Guests and rate</h2>
      <p>Venues are a flat rate per event booking.</p>
    </div>
    <div class="ap-section-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label required" for="venueCapacity">Capacity (guests)</label>
          <input type="number" name="capacity" id="venueCapacity" class="form-control" value="<%= old.capacity || 50 %>" min="1" required />
        </div>
        <div class="col-md-6">
          <label class="form-label required" for="venuePrice">Rate per event</label>
          <div class="input-group"><span class="input-group-text">₱</span><input type="number" name="price" id="venuePrice" class="form-control" value="<%= old.price || '' %>" min="0" step="0.01" required /></div>
        </div>
        <div class="col-12">
          <label class="form-label" for="venuePriceNote">Price note <span class="ap-meta fw-normal">(optional)</span></label>
          <input type="text" name="price_note" id="venuePriceNote" class="form-control" value="<%= old.price_note || '' %>" placeholder="e.g. per event, includes setup" aria-describedby="venuePriceNoteHelp" />
          <div class="form-text" id="venuePriceNoteHelp">Shown next to the rate, e.g. what the price includes.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Description</h2>
      <p>Only list amenities the venue really has — organisers plan around them.</p>
    </div>
    <div class="ap-section-body">
      <div class="mb-3">
        <label class="form-label" for="venueAmenities">Amenities</label>
        <input type="text" name="amenities" id="venueAmenities" class="form-control" value="<%= old.amenitiesStr || '' %>" placeholder="e.g. Sound system, Tables and chairs" aria-describedby="venueAmenitiesHelp" />
        <div class="form-text" id="venueAmenitiesHelp">Separate each amenity with a comma.</div>
      </div>
      <div>
        <label class="form-label" for="venueDescription">Description</label>
        <textarea name="description" id="venueDescription" class="form-control" rows="4"><%= old.description || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="ap-section">
    <div class="ap-section-intro">
      <h2>Photos</h2>
      <p>Up to 5 photos in total, 5 MB each (JPG, PNG or WEBP). The first photo is the cover shown in listings.</p>
    </div>
    <div class="ap-section-body">
      <% if (hasPhotos) { %>
      <div class="cat-photo-block">
        <h3>Current photos</h3>
        <div class="ap-thumb-grid">
          <% for (let i = 0; i < venue.imagesList.length; i++) { const image = venue.imagesList[i]; %>
          <div class="ap-thumb-item existing-img-item">
            <div class="ap-thumb">
              <img src="<%= image %>" alt="Venue photo <%= i + 1 %>" data-missing="Photo unavailable — file missing" />
              <% if (i === 0) { %><span class="cat-thumb-tag">Cover</span><% } %>
            </div>
            <input type="hidden" name="keep_images" value="<%= image %>" class="keep-img-input" form="venueForm" />
            <button type="button" class="ap-act is-danger remove-img-btn" aria-pressed="false">Remove</button>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="cat-photo-block">
        <h3><%= hasPhotos ? 'Add more photos' : 'Upload photos' %></h3>
        <div class="upload-dropzone cat-dropzone" id="venueDropZone">
          <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
          <span>Drag photos here, or</span>
          <label for="venueImageInput" class="btn btn-secondary-quiet btn-sm mb-0">Choose files</label>
          <input type="file" id="venueImageInput" name="images" form="venueForm" multiple accept="image/*" class="d-none" />
        </div>
        <div class="ap-thumb-grid mt-3" id="venueImagePreview" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <div class="ap-form-actions">
    <span class="ap-meta ap-required-note">Fields marked <span class="text-danger">*</span> are required.</span>
    <a href="/venues<%= venue ? '/' + venue.id : '' %>" class="btn btn-secondary-quiet">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= venue ? 'Save changes' : 'Create venue' %></button>
  </div>
</form>

</div>

<script>
(function () {
  var input = document.getElementById('venueImageInput');
  var dropZone = document.getElementById('venueDropZone');
  var preview = document.getElementById('venueImagePreview');
  var fileList = new DataTransfer();
  var existingCount = document.querySelectorAll('.keep-img-input').length;

  function renderPreview() {
    preview.innerHTML = '';
    Array.from(fileList.files).forEach(function (file, index) {
      var item = document.createElement('div');
      item.className = 'ap-thumb-item';
      var thumb = document.createElement('div');
      thumb.className = 'ap-thumb';
      var image = document.createElement('img');
      image.src = URL.createObjectURL(file);
      image.alt = file.name;
      thumb.appendChild(image);
      var name = document.createElement('span');
      name.className = 'ap-thumb-caption';
      name.textContent = 'New · ' + file.name;
      var remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'ap-act is-danger';
      remove.textContent = 'Remove';
      remove.addEventListener('click', function () {
        var nextFiles = new DataTransfer();
        Array.from(fileList.files).forEach(function (item, itemIndex) {
          if (itemIndex !== index) nextFiles.items.add(item);
        });
        fileList = nextFiles;
        input.files = fileList.files;
        renderPreview();
      });
      item.appendChild(thumb); item.appendChild(name); item.appendChild(remove);
      preview.appendChild(item);
    });
  }

  function addFiles(files) {
    Array.from(files).forEach(function (file) {
      if (!file.type.startsWith('image/') || fileList.items.length + existingCount >= 5) return;
      fileList.items.add(file);
    });
    input.files = fileList.files;
    renderPreview();
  }

  // Remove / undo an existing photo: a removed photo's keep_images input is disabled so it isn't submitted.
  document.querySelectorAll('.remove-img-btn').forEach(function (button) {
    button.addEventListener('click', function () {
      var wrapper = button.closest('.existing-img-item');
      var keepInput = wrapper.querySelector('.keep-img-input');
      keepInput.disabled = !keepInput.disabled;
      wrapper.classList.toggle('is-removed', keepInput.disabled);
      button.textContent = keepInput.disabled ? 'Undo' : 'Remove';
      button.classList.toggle('is-danger', !keepInput.disabled);
      button.setAttribute('aria-pressed', keepInput.disabled ? 'true' : 'false');
      existingCount = document.querySelectorAll('.keep-img-input:not(:disabled)').length;
    });
  });
  input.addEventListener('change', function () { addFiles(input.files); });
  dropZone.addEventListener('dragover', function (event) {
    event.preventDefault();
    dropZone.classList.add('dragover');
  });
  dropZone.addEventListener('dragleave', function () {
    dropZone.classList.remove('dragover');
  });
  dropZone.addEventListener('drop', function (event) {
    event.preventDefault();
    dropZone.classList.remove('dragover');
    addFiles(event.dataTransfer.files);
  });
  dropZone.addEventListener('click', function (event) {
    if (event.target.tagName !== 'LABEL' && event.target.tagName !== 'INPUT') input.click();
  });
})();
</script>
