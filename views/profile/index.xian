<% layout('layouts/main') %>
<%
  const showPassword = typeof activeTab !== 'undefined' && activeTab === 'password';
  const fieldErr = (list, f) => (list || []).filter(e => (e.path || e.param) === f).map(e => e.msg);
  const fullName = profileUser.first_name + ' ' + profileUser.last_name;
%>
<div class="ap-page">

<!--page-head-->
<h1 class="ph-title">My profile</h1>
<!--/page-head-->
<div class="page-meta">Signed in as <strong><%= fullName %></strong> · <%= profileUser.role_label %>. Update your name and phone, or change your password.</div>

<div class="ap-form prof-form">

  <!-- Profile -->
  <section class="ap-section" id="tabProfile" aria-labelledby="profDetailsHeading">
    <div class="ap-section-intro">
      <h2 id="profDetailsHeading">Your details</h2>
      <p>Your name appears on bookings you handle and in the audit log.</p>
    </div>
    <div class="ap-section-body">
      <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger ap-errors" role="alert">
        <strong>Your details weren't saved:</strong>
        <ul><% for (const e of errors) { %><li><%= e.msg %></li><% } %></ul>
      </div>
      <% } %>
      <form action="/profile" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label required" for="profFirst">First name</label>
            <input type="text" name="first_name" id="profFirst" class="form-control <%= fieldErr(errors, 'first_name').length ? 'is-invalid' : '' %>"
              value="<%= old.first_name || profileUser.first_name %>" required autocomplete="given-name" />
            <% for (const m of fieldErr(errors, 'first_name')) { %><div class="invalid-feedback"><%= m %></div><% } %>
          </div>
          <div class="col-md-6">
            <label class="form-label required" for="profLast">Last name</label>
            <input type="text" name="last_name" id="profLast" class="form-control <%= fieldErr(errors, 'last_name').length ? 'is-invalid' : '' %>"
              value="<%= old.last_name || profileUser.last_name %>" required autocomplete="family-name" />
            <% for (const m of fieldErr(errors, 'last_name')) { %><div class="invalid-feedback"><%= m %></div><% } %>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="profEmail">Email address</label>
            <input type="email" id="profEmail" class="form-control" value="<%= profileUser.email %>" disabled aria-describedby="profEmailHelp" />
            <div class="form-text" id="profEmailHelp">Used to sign in. Only an administrator can change it.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="profPhone">Phone number</label>
            <input type="text" name="phone" id="profPhone" class="form-control <%= fieldErr(errors, 'phone').length ? 'is-invalid' : '' %>"
              value="<%= old.phone !== undefined ? old.phone : profileUser.phone || '' %>"
              placeholder="09XX-XXX-XXXX" inputmode="tel" autocomplete="tel" />
            <% for (const m of fieldErr(errors, 'phone')) { %><div class="invalid-feedback"><%= m %></div><% } %>
          </div>
        </div>
        <div class="d-flex justify-content-end mt-4">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save" aria-hidden="true"></i>Save details</button>
        </div>
      </form>
    </div>
  </section>

  <!-- Password -->
  <section class="ap-section" id="tabPassword" aria-labelledby="profPassHeading">
    <div class="ap-section-intro">
      <h2 id="profPassHeading">Password</h2>
      <p>Use at least 8 characters. Mixing upper-case letters, numbers and symbols makes it stronger.</p>
    </div>
    <div class="ap-section-body">
      <% if (pwErrors && pwErrors.length > 0) { %>
      <div class="alert alert-danger ap-errors" role="alert">
        <strong>Your password wasn't changed:</strong>
        <ul><% for (const e of pwErrors) { %><li><%= e.msg %></li><% } %></ul>
      </div>
      <% } %>
      <form action="/profile/password" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label required" for="currentPw">Current password</label>
            <div class="input-group has-validation">
              <input type="password" name="current_password" id="currentPw" class="form-control <%= fieldErr(pwErrors, 'current_password').length ? 'is-invalid' : '' %>"
                required autocomplete="current-password" />
              <button type="button" class="btn btn-outline-secondary btn-toggle-pass" data-target="currentPw" aria-label="Show or hide current password">
                <i class="fas fa-eye" aria-hidden="true"></i>
              </button>
              <% for (const m of fieldErr(pwErrors, 'current_password')) { %><div class="invalid-feedback"><%= m %></div><% } %>
            </div>
          </div>
          <div class="w-100 d-none d-md-block"></div>
          <div class="col-md-6">
            <label class="form-label required" for="newPw">New password</label>
            <div class="input-group has-validation">
              <input type="password" name="new_password" id="newPw" class="form-control <%= fieldErr(pwErrors, 'new_password').length ? 'is-invalid' : '' %>"
                required minlength="8" autocomplete="new-password" aria-describedby="pwStrengthLabel" />
              <button type="button" class="btn btn-outline-secondary btn-toggle-pass" data-target="newPw" aria-label="Show or hide new password">
                <i class="fas fa-eye" aria-hidden="true"></i>
              </button>
              <% for (const m of fieldErr(pwErrors, 'new_password')) { %><div class="invalid-feedback"><%= m %></div><% } %>
            </div>
            <!-- Password strength indicator -->
            <div id="pwStrengthBar" class="prof-strength" aria-hidden="true">
              <div id="pwStrengthFill"></div>
            </div>
            <div id="pwStrengthLabel" class="form-text" aria-live="polite"></div>
          </div>
          <div class="col-md-6">
            <label class="form-label required" for="confirmPw">Confirm new password</label>
            <div class="input-group has-validation">
              <input type="password" name="confirm_password" id="confirmPw" class="form-control <%= fieldErr(pwErrors, 'confirm_password').length ? 'is-invalid' : '' %>"
                required autocomplete="new-password" aria-describedby="pwMatchMsg" />
              <button type="button" class="btn btn-outline-secondary btn-toggle-pass" data-target="confirmPw" aria-label="Show or hide password confirmation">
                <i class="fas fa-eye" aria-hidden="true"></i>
              </button>
              <% for (const m of fieldErr(pwErrors, 'confirm_password')) { %><div class="invalid-feedback"><%= m %></div><% } %>
            </div>
            <div id="pwMatchMsg" class="form-text" aria-live="polite"></div>
          </div>
        </div>
        <div class="d-flex justify-content-end mt-4">
          <button type="submit" class="btn btn-primary"><i class="fas fa-lock" aria-hidden="true"></i>Change password</button>
        </div>
      </form>
    </div>
  </section>

  <!-- Account summary + activity -->
  <section class="ap-section" aria-labelledby="profAccountHeading">
    <div class="ap-section-intro">
      <h2 id="profAccountHeading">Account</h2>
      <p>Your sign-in history and the latest changes recorded under your name.</p>
    </div>
    <div class="ap-section-body prof-account">
      <dl class="ap-dl">
        <dt>Role</dt><dd><%= profileUser.role_label %></dd>
        <dt>Member since</dt><dd><%= formatDate(profileUser.created_at) %></dd>
        <dt>Last sign-in</dt><dd><%= profileUser.last_login ? formatDateTime(profileUser.last_login) : 'Not recorded' %></dd>
      </dl>
      <h3 class="prof-sub">Recent activity</h3>
      <% if (!recentActivity || recentActivity.length === 0) { %>
      <p class="ap-meta mb-0">No activity recorded yet.</p>
      <% } else { %>
      <ol class="ap-history prof-history">
        <% for (const log of recentActivity) { %>
        <li>
          <time datetime="<%= log.created_at %>"><%= formatDateTime(log.created_at) %></time>
          <div>
            <div class="ap-history-title text-capitalize"><%= log.action.replace(/_/g,' ') %></div>
            <div class="ap-history-by text-capitalize"><%= log.module %></div>
          </div>
        </li>
        <% } %>
      </ol>
      <% } %>
    </div>
  </section>

</div>
</div>

<script>
// Password strength meter
(function () {
  const newPw    = document.getElementById('newPw');
  const fill     = document.getElementById('pwStrengthFill');
  const label    = document.getElementById('pwStrengthLabel');
  const confirmPw= document.getElementById('confirmPw');
  const matchMsg = document.getElementById('pwMatchMsg');

  if (!newPw) return;
  <% if (showPassword) { %>document.getElementById('tabPassword').scrollIntoView({ block: 'start' });<% } %>

  newPw.addEventListener('input', () => {
    const v = newPw.value;
    let strength = 0;
    if (v.length >= 8)               strength++;
    if (/[A-Z]/.test(v))             strength++;
    if (/[0-9]/.test(v))             strength++;
    if (/[^A-Za-z0-9]/.test(v))      strength++;

    const pct    = strength * 25;
    const colors = ['#b42318','#a15c07','#8a5a12','#1f7a4d'];
    const labels = ['Weak','Fair','Good','Strong'];

    fill.style.width      = pct + '%';
    fill.style.background = colors[strength - 1] || '#e5e9e7';
    label.textContent     = v.length === 0 ? '' : 'Strength: ' + (labels[strength - 1] || 'Too short');
    label.style.color     = colors[strength - 1] || '';
  });

  confirmPw.addEventListener('input', () => {
    if (confirmPw.value === '') { matchMsg.textContent = ''; return; }
    if (confirmPw.value === newPw.value) {
      matchMsg.textContent = '✓ Passwords match';
      matchMsg.style.color = '#1f7a4d';
    } else {
      matchMsg.textContent = '✗ Passwords do not match';
      matchMsg.style.color = '#b42318';
    }
  });
})();
</script>
