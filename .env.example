# Application
NODE_ENV=production
PORT=3000
APP_NAME=Balai-Reserve
SESSION_SECRET=your-secret-key-change-this

# Google Cloud Console web OAuth client; configure the redirect URI below there too.
# Google sign-in stays hidden until all three values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=balai_reserve

# OR use DATABASE_URL format
# DATABASE_URL=mysql://user:password@host:port/database

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
